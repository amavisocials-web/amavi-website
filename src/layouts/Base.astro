---
import { ACCENT } from '../consts';
import '../styles/global.css';

import Fonts from '../components/Fonts.astro';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  standaloneTitle?: boolean;
  /** JSON-LD, serialised into a schema.org script tag. */
  schema?: Record<string, unknown>;
  /** og:type, "website" unless a page says otherwise. */
  ogType?: 'website' | 'article';
}

const { title, description, ogImage, standaloneTitle, schema, ogType } = Astro.props;
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/* Tints the browser's own chrome. See ACCENT in src/consts.ts. */}
    <meta name="theme-color" content={ACCENT} />

    <Fonts />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      standaloneTitle={standaloneTitle}
      ogType={ogType}
    />

    {/* Anything a page needs in the head of its own: AMAVI Culture's feed. */}
    <slot name="head" />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/*
      TODO(client): analytics — GA4 or Plausible, client's choice (brief §8).
      GA4 sets cookies and would require a consent banner before it loads;
      Plausible is cookieless and would not.
    */}
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
