---
import '../styles/global.css';

import Fonts from '../components/Fonts.astro';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer, { type FooterCta } from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  standaloneTitle?: boolean;
  /** JSON-LD, serialised into a schema.org script tag. */
  schema?: Record<string, unknown>;
  /** The footer's closing call to action, when this page words it its own way. */
  footerCta?: Partial<FooterCta>;
}

const { title, description, ogImage, standaloneTitle, schema, footerCta } = Astro.props;
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <Fonts />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      standaloneTitle={standaloneTitle}
    />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    {/*
      TODO(client): analytics — GA4 or Plausible, client's choice (brief §8).
      GA4 sets cookies and would require a consent banner before it loads;
      Plausible is cookieless and would not.
    */}
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer cta={footerCta} />
  </body>
</html>
