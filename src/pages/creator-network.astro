---
import Base from '../layouts/Base.astro';
import CreatorForm from '../components/CreatorForm.astro';
import { CONTACT_EMAIL } from '../consts';
---

{/* /creator-network since 28 October 2026, when "Become a Creator" became
    "Creator Network" across the site; /become-a-creator redirects here
    (astro.config.mjs). The heading stays an instruction, not the nav label. */}
<Base
  title="Creator Network"
  description="Apply to join the AMAVI Socials Creator Network. One application puts you in front of every brand we work with across Europe."
>
  {/* Kept short: this is mostly filled in on a phone, and every line above the
      form pushes the first field further down the screen. */}
  <section class="section page-head">
    <div class="container container--narrow">
      <h1 class="display display--lg">Join the creator network</h1>
      <p class="lead page-head__lead">
        One application puts you in front of every brand we work with. We come to you when a
        brief fits.
      </p>
      <p class="meta page-head__meta">
        Six short steps, about five minutes. Only the essentials are required.
      </p>
    </div>
  </section>

  {/* What applying actually means, before the first field. */}
  <section class="section section--tight next" aria-labelledby="next-heading">
    <div class="container container--narrow">
      <h2 id="next-heading" class="display display--md">What happens next</h2>
      <div class="next__body">
        <p>
          We keep your details on file and get in touch when a campaign matches your audience and
          content. We’ll always tell you the brand, the deliverables, the timeline and whether it’s
          gifted or paid before you commit to anything.
        </p>
        <p>
          No follower minimum. We work with creators of every size. Who’s watching matters more
          than how many.
        </p>
        <p>
          Questions? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section form-page">
    <div class="container container--narrow">
      <CreatorForm />
    </div>
  </section>
</Base>

<style>
  .page-head { padding-bottom: var(--space-l); }
  .page-head__lead { margin-top: var(--space-m); }
  .page-head__meta { margin-top: var(--space-s); }

  .next__body { display: grid; gap: var(--space-s); margin-top: var(--space-m); max-width: var(--measure); }
  .next__body p { font-weight: var(--weight-secondary); }

  .form-page { padding-top: 0; }
</style>
