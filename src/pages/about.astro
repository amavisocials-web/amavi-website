---
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';
import Connect from '../components/Connect.astro';
import { MEDIA } from '../data/media';

/**
 * About: who AMAVI is and how it thinks — a point of view more than an
 * introduction. Creator marketing is the core speciality; the page makes
 * clear it's never the limit.
 *
 * "Our philosophy" is the page's one dark band: the copy over a photograph
 * of AMAVI's own work, under an overlay heavy enough that white text holds on
 * every part of it. The picture is decoration, and hidden from assistive tech.
 */

const approach = [
  {
    name: 'Strategy',
    body: 'We turn your business goals into a clear strategy, creative direction and campaign roadmap. We work closely with your internal team throughout to stay aligned, adapt where needed and make sure every move is in the right direction.',
  },
  {
    name: 'Creator selection',
    body: 'We discover, vet and manage the creators and communities your audience genuinely trusts, from one-off campaigns to long-term ambassador programmes, keeping in mind your aesthetic, current business goals and long term vision.',
  },
  {
    name: 'Content & production',
    body: 'We manage the process from briefing to final delivery, creating platform-native content that feels authentic to the creator and the brand.',
  },
  {
    name: 'Reporting & optimisation',
    body: 'We track performance throughout each campaign and turn the data into clear insights, using what we learn to continuously improve what comes next.',
  },
];

---

<Base
  title="About"
  description="AMAVI is a creator-led marketing and partnerships agency. We start with the objective, then find the creators, communities and partnerships that reach the audience."
>
  {/* ================= Intro ================= */}
  <section class="section about">
    <div class="container about__intro">
      <h1 class="eyebrow">About AMAVI</h1>
      <div class="about__lead">
        <p class="lead">
          We are a <strong>creator-led marketing and partnerships agency</strong> for ambitious
          brands across Europe. In a world overwhelmed by noise, reach is easy to buy.
          Relevance isn’t.
        </p>
        <p class="lead">
          We focus on what actually moves the needle: authentic human connection, trusted voices
          and measurable commercial results.
        </p>
      </div>
    </div>

  </section>

  {/* ================= Our approach ================= */}
  <section class="section section--ruled" aria-labelledby="approach-heading">
    <div class="container split">
      <div class="split__head">
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-heading" class="display display--md"><Lines text={'Strategy-led creator,\ncontent & social campaigns.'} /></h2>
      </div>
      <ul class="approach" role="list">
        {approach.map((item) => (
          <li class="approach__item">
            <h3 class="row-label">{item.name}</h3>
            <p class="approach__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================= Our philosophy: over the photograph ================= */}
  <section class="section why-amavi surface-dark" aria-labelledby="why-heading">
    {/* Decoration: what it says is said by the copy over it. */}
    <div class="band-media" aria-hidden="true">
      <Image src={MEDIA.philosophy.image} alt="" widths={[768, 1100, 1376]}
             sizes="100vw" loading="lazy" decoding="async" class="band-media__img" />
      <div class="band-media__shade"></div>
    </div>

    <div class="container split why-amavi__inner">
      <div class="split__head">
        <p class="eyebrow">Our philosophy</p>
        <h2 id="why-heading" class="display display--md"><Lines text={'The right people\nbeat more people.'} /></h2>
      </div>
      <div class="split__body">
        <p>
          A campaign doesn’t always need one macro influencer. Sometimes it needs a creator, an
          active community, or a strategic partnership that puts your brand directly in front of
          the audience that matters. We look at the bigger picture first, then assemble the exact
          mix to deliver on your commercial targets.
        </p>
      </div>
    </div>
  </section>

  {/* ================= The closing invitation ================= */}
  <Connect />

</Base>

<style>
  /* ---------- Intro: space does the work ---------- */
  .about { padding-block: clamp(4rem, 2rem + 8vw, 9rem) var(--section-y); }
  .about__intro { display: grid; justify-items: center; text-align: center; gap: var(--space-m); }
  /* Its own measure rather than the narrow container's and the shared .lead's
     48ch: the lines run to about 75 characters, a paragraph to read rather
     than a column. Below 48em the measure is wider than the screen, so the
     text fills the content width exactly as it did before. */
  .about__lead { display: grid; gap: var(--space-s); justify-items: center; max-width: 68ch; }
  .about__lead .lead { max-width: none; }
  .about__lead strong { font-weight: 700; }

  /* ---------- The four portraits ----------
     A row at every width. On a phone it scrolls sideways, a card and a bit in
     view, so four 2:3 portraits can't fill the screen; from 48em up all four
     sit across the container and scale with it. */
  /* ---------- Our philosophy: white on a photograph ----------
     The picture fills the band and the shade sits over it, dark enough that
     white text holds on the lightest part of the frame. */
  /* A little taller than a section's own space, so the photograph behind it
     has room to be a picture rather than a strip. */
  .why-amavi {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: calc(var(--section-y) + var(--space-l));
  }
  .why-amavi__inner { position: relative; }

  .band-media { position: absolute; inset: 0; z-index: -1; }
  .band-media__img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* The prints hang in the middle of the frame, so a wide band keeps the
       middle and crops the wall above and below. */
    object-position: center;
  }
  .band-media__shade { position: absolute; inset: 0; background: var(--surface-dark); opacity: 0.72; }

  /* ---------- Heading beside its text, as on Services ---------- */
  .split { display: grid; gap: var(--space-l); }
  @media (min-width: 64em) {
    .split { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: var(--space-xl); row-gap: var(--space-2xl); align-items: start; }
  }
  .split__head { display: grid; gap: var(--space-m); align-content: start; }
  .split__body {
    display: grid;
    gap: var(--space-s);
    max-width: var(--measure);
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    line-height: 1.65;
  }
  .split__body strong { font-weight: 700; }

  /* ---------- Approach: a list held apart by space, not by rules ---------- */
  .approach { list-style: none; display: grid; gap: var(--space-l); }
  .approach__item { display: grid; gap: var(--space-3xs); }
  @media (min-width: 64em) { .approach { gap: var(--space-xl); } }
  .approach__body { font-weight: var(--weight-secondary); }
</style>
