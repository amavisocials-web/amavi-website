---
import Base from '../layouts/Base.astro';
import Lines from '../components/Lines.astro';

/**
 * About: who AMAVI is and how it thinks — a point of view more than an
 * introduction. Creator marketing is the core speciality; the page makes
 * clear it's never the limit.
 *
 * "Why AMAVI" is the page's one dark band: the copy over an abstract city
 * plan, marked where AMAVI is. The pattern is drawn from a handful of fixed
 * numbers — a design, not a survey map — and is hidden from assistive tech.
 *
 * TODO(client): no team photos supplied, so "Who we are" is names, roles and
 * lines rather than portraits. src/components/Team.astro is scaffolded if you
 * want photographs later.
 */

/**
 * TODO(client): the team — real names, roles and a line or two each. These two
 * entries are placeholders so the section has its shape; replace them, add as
 * many as you like, and the list follows.
 */
const team = [
  { name: '[Name]', role: '[Role]', bio: '[TODO(client): a line or two on what they do at AMAVI.]' },
  { name: '[Name]', role: '[Role]', bio: '[TODO(client): a line or two on what they do at AMAVI.]' },
];

/**
 * The city plan behind "Why AMAVI": one centre, roads leaving the frame, ring
 * roads, and blocks along the roads. Every number is fixed, so the drawing is
 * the same on every build. An abstraction of a city, not a map of one.
 */
/* Off-centre on purpose: the pin falls clear of the copy, under the heading. */
const CITY = { x: 320, y: 470 };
const ANGLES = [-72, -28, 8, 46, 96, 140, 178, 216, 262, 308];
const point = (angle: number, distance: number) => ({
  x: CITY.x + Math.cos((angle * Math.PI) / 180) * distance,
  y: CITY.y + Math.sin((angle * Math.PI) / 180) * distance,
});
const radials = ANGLES.map((angle) => point(angle, 1100));
const rings = [120, 235, 380, 560];
const blocks = ANGLES.flatMap((angle, i) =>
  [170, 300, 450, 620].slice(i % 2 === 0 ? 0 : 1).map((distance, j) => {
    const at = point(angle + (j % 2 ? 7 : -7), distance);
    const w = 52 + ((i * 13 + j * 29) % 46);
    const h = 30 + ((i * 7 + j * 17) % 34);
    return { x: at.x - w / 2, y: at.y - h / 2, w, h, angle: angle + 90 };
  }),
);

const approach = [
  {
    name: 'Creator Partnerships',
    body: 'We identify, source and manage creators who make sense for your brand — from one-off campaigns to long-term ambassador relationships.',
  },
  {
    name: 'Campaign Strategy',
    body: 'We turn a business objective into a clear campaign idea, audience strategy and plan for execution.',
  },
  {
    name: 'Content',
    body: 'From creator-led concepts to short-form video, we create content designed to feel native to the platforms where people actually spend their time.',
  },
  {
    name: 'Brand Partnerships',
    body: 'We look beyond creators to find businesses, communities and organisations that already have access to the people you want to reach.',
  },
];

---

<Base
  title="About"
  description="AMAVI is a creator-led marketing and partnerships agency. We start with the objective, then find the creators, communities and partnerships that reach the audience."
>
  {/* ================= Intro ================= */}
  <section class="section about">
    <div class="container container--narrow about__intro">
      <h1 class="eyebrow">About AMAVI</h1>
      <p class="display display--lg about__statement"><Lines text={'We find the\npeople behind\nthe impact.'} /></p>
      <div class="about__lead">
        <p class="lead">
          AMAVI is a <strong>creator-led marketing and partnerships agency</strong> working with
          brands across Ireland and Europe. Founded in Prishtina, Kosovo, we work with clients
          across healthcare, wellness, hospitality, food and retail.
        </p>
        <p class="lead">
          We believe growth starts with people. The right creator, community, business or
          partnership can open the door to an audience a brand hasn’t reached before.
        </p>
        <p class="lead">Our job is to find that door — and build the strategy to get you through it.</p>
      </div>
      <a href="/services/" class="btn btn--primary about__cta">Work with us</a>
    </div>

  </section>

  {/* ================= Our approach ================= */}
  <section class="section section--ruled" aria-labelledby="approach-heading">
    <div class="container split">
      <div class="split__head">
        <p class="eyebrow">Our approach</p>
        <h2 id="approach-heading" class="display display--md"><Lines text={'Creators are one part\nof the equation.'} /></h2>
        <p class="lead">We build the right mix around the problem we’re solving.</p>
      </div>
      <ul class="approach" role="list">
        {approach.map((item) => (
          <li class="approach__item">
            <h3 class="approach__name">{item.name}</h3>
            <p class="approach__body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================= Why AMAVI: over the city ================= */}
  <section class="section why-amavi surface-dark" aria-labelledby="why-heading">
    <div class="city" aria-hidden="true">
      <svg viewBox="0 0 1200 700" preserveAspectRatio="xMinYMid slice" role="presentation">
        {/* Roads leaving the frame: where AMAVI is, and everywhere the work goes. */}
        {radials.map((r) => <line x1={CITY.x} y1={CITY.y} x2={r.x} y2={r.y} class="city__road" />)}
        {rings.map((radius) => <circle cx={CITY.x} cy={CITY.y} r={radius} class="city__ring" />)}
        {blocks.map((b) => (
          <rect x={b.x} y={b.y} width={b.w} height={b.h} class="city__block"
                transform={`rotate(${b.angle} ${b.x + b.w / 2} ${b.y + b.h / 2})`} />
        ))}
        <path d="M-40 250 C 220 300, 360 430, 600 430 S 980 300, 1240 350" class="city__river" />
        <circle cx={CITY.x} cy={CITY.y} r="46" class="city__here" />
        <circle cx={CITY.x} cy={CITY.y} r="9" class="city__pin" />
      </svg>
    </div>

    <div class="container split why-amavi__inner">
      <div class="split__head">
        <p class="eyebrow">Why AMAVI</p>
        <h2 id="why-heading" class="display display--md"><Lines text={'Start with the\nopportunity.\nNot the deliverable.'} /></h2>
      </div>
      <div class="split__body">
        <p>A campaign doesn’t always need another influencer.</p>
        <p>Sometimes it needs a creator.</p>
        <p>Sometimes it needs a community.</p>
        <p>Sometimes it needs a partnership that puts your brand directly in front of the right audience.</p>
        <p><strong>We look at the bigger picture, then build the right mix around it.</strong></p>
        <p class="label city__caption">Prishtina, Kosovo · 42.66° N 21.16° E</p>
      </div>
    </div>
  </section>

  {/* ================= The network ================= */}
  <section class="section section--ruled" aria-labelledby="network-heading">
    <div class="container split">
      <div class="split__head">
        <p class="eyebrow">Our network</p>
        <h2 id="network-heading" class="display display--md">We know who to call.</h2>
      </div>
      <div class="split__body">
        <p>
          We’ve built a database of over a thousand creators and partners across Ireland — people
          we’ve worked with, vetted or tracked, organised by audience, niche and location.
        </p>
        <p>
          That network is growing across Europe. Every campaign we run adds to it, which means the
          next brief starts further ahead than the last one.
        </p>
      </div>
    </div>
  </section>

  {/* ================= Who we are ================= */}
  <section class="section section--ruled" aria-labelledby="team-heading">
    <div class="container split">
      <div class="split__head">
        <p class="eyebrow">Who we are</p>
        <h2 id="team-heading" class="display display--md">A small team that answers the phone.</h2>
      </div>
      <ul class="team" role="list">
        {team.map((member) => (
          <li class="team__member">
            <div class="team__who">
              <h3 class="team__name">{member.name}</h3>
              <p class="team__role">{member.role}</p>
            </div>
            <p class="team__bio">{member.bio}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================= Philosophy ================= */}
  <section class="section section--ruled philosophy" aria-labelledby="philosophy-heading">
    <div class="container container--narrow philosophy__inner">
      <p class="eyebrow">Our philosophy</p>
      <h2 id="philosophy-heading" class="display display--md philosophy__line">
        <Lines text={'The right people\nbeat more people.'} />
      </h2>
      <div class="philosophy__body">
        <p class="lead">Reach is easy to buy.</p>
        <p class="lead">Relevance isn’t.</p>
        <p class="lead">
          We care about finding the people who already have trust, attention and influence within
          the audiences that matter to your brand.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Intro: space does the work ---------- */
  .about { padding-block: clamp(4rem, 2rem + 8vw, 9rem) var(--section-y); }
  .about__intro { display: grid; justify-items: center; text-align: center; gap: var(--space-m); }
  .about__statement { max-width: 20ch; }
  .about__lead { display: grid; gap: var(--space-s); justify-items: center; max-width: 54ch; }
  .about__lead strong { font-weight: 700; }
  .about__cta { margin-top: var(--space-s); }

  /* ---------- The four portraits ----------
     A row at every width. On a phone it scrolls sideways, a card and a bit in
     view, so four 2:3 portraits can't fill the screen; from 48em up all four
     sit across the container and scale with it. */
  /* ---------- Why AMAVI: white on black, over the city ----------
     The drawing is decoration — white lines on black, well under the text,
     with the one accent mark where AMAVI is. */
  .why-amavi { position: relative; isolation: isolate; overflow: hidden; }
  .why-amavi__inner { position: relative; }

  .city { position: absolute; inset: 0; z-index: -1; }
  .city svg { width: 100%; height: 100%; }
  .city :global(.city__road),
  .city :global(.city__ring),
  .city :global(.city__block),
  .city :global(.city__river) {
    fill: none;
    stroke: var(--on-dark);
    vector-effect: non-scaling-stroke;
  }
  .city :global(.city__road) { stroke-width: 1; opacity: 0.28; }
  .city :global(.city__ring) { stroke-width: 1; opacity: 0.16; }
  .city :global(.city__block) { stroke-width: 1; opacity: 0.22; }
  .city :global(.city__river) { stroke-width: 2; opacity: 0.14; }
  .city :global(.city__here) { fill: none; stroke: var(--on-dark); stroke-width: 1; opacity: 0.5; }
  .city :global(.city__pin) { fill: var(--accent); }
  .city__caption { margin-top: var(--space-m); opacity: 0.8; }

  /* ---------- Heading beside its text, as on Services ---------- */
  .split { display: grid; gap: var(--space-l); }
  @media (min-width: 64em) {
    .split { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-2xl); align-items: start; }
  }
  .split__head { display: grid; gap: var(--space-m); align-content: start; }
  .split__body {
    display: grid;
    gap: var(--space-s);
    max-width: var(--measure);
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    line-height: 1.65;
  }
  .split__body strong { font-weight: 700; }

  /* ---------- Approach: a ruled list, as the areas are on Services ---------- */
  .approach { list-style: none; border-top: var(--stroke) solid var(--line); }
  .approach__item {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-m);
    border-bottom: var(--stroke-hair) solid var(--line);
  }
  .approach__name {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .approach__body { font-weight: var(--weight-secondary); }

  /* ---------- The team: a ruled list, name and role beside the line ---------- */
  .team { list-style: none; border-top: var(--stroke) solid var(--line); }
  .team__member {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-m);
    border-bottom: var(--stroke-hair) solid var(--line);
  }
  @media (min-width: 64em) {
    .team__member { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-l); align-items: baseline; }
  }
  .team__who { display: grid; gap: var(--space-3xs); align-content: start; }
  .team__name {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .team__role { font-size: var(--text-sm); font-weight: var(--weight-secondary); }
  .team__bio { font-weight: var(--weight-secondary); }

  /* ---------- Philosophy: centred, as on the home page ---------- */
  .philosophy__inner { display: grid; gap: var(--space-m); justify-items: center; text-align: center; }
  .philosophy__line { max-width: 22ch; }
  .philosophy__body { display: grid; gap: var(--space-2xs); justify-items: center; }
</style>
