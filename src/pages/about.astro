---
import Base from '../layouts/Base.astro';
import { TAGLINE, BRAND_ENQUIRY_MAILTO } from '../consts';

/**
 * Deliberately short: who AMAVI is, and one way to get in touch. The
 * programme detail and the per-account figures that used to live here are on
 * /services.
 *
 * The site-wide Get in Touch band is left off this page (see Footer.astro), so
 * the email button below is its only call to action.
 *
 * TODO(client): no team photos or bios supplied, so this page ships without a
 * team section rather than with stock portraits (brief §9).
 * src/components/Team.astro is scaffolded and ready to import.
 */
---

<Base
  title="About"
  description="AMAVI Socials runs influencer and creator partnership programmes end to end for brands across Ireland — sourcing, vetting, agreements, campaign management and reporting."
>
  <section class="section about">
    <div class="container container--narrow about__inner">
      <h1 class="label">About AMAVI</h1>
      <p class="display display--lg about__statement">{TAGLINE}</p>
      <p class="lead about__lead">
        AMAVI Socials is a boutique influencer marketing agency working with brands across
        Ireland. We run creator partnership programmes from the first shortlist to the final
        report — so you get the reach without managing twenty creator relationships yourself.
      </p>
      <a href={BRAND_ENQUIRY_MAILTO} class="btn btn--primary about__cta">Email us</a>
    </div>
  </section>
</Base>

<style>
  /* Space does the work here: very little text, a lot of room around it. */
  .about { padding-block: clamp(6rem, 3rem + 12vw, 14rem); }
  .about__inner { display: grid; justify-items: start; }
  .about__statement { margin-top: var(--space-m); }
  .about__lead { margin-top: var(--space-l); max-width: 50ch; }
  .about__cta { margin-top: var(--space-xl); }
</style>
