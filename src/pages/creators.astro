---
/**
 * TODO(client): confirm where existing submissions route before DNS cutover.
 *
 * amavisocials.co currently serves a live influencer signup page whose
 * submissions may be going somewhere active — a mailbox, a sheet, a form
 * backend nobody has checked in months. This rebuild posts to Netlify Forms.
 * The domain must not be switched until we know what the existing route is
 * and whether it needs preserving or migrating. Do not cut DNS over until
 * this is answered.
 *
 * TODO(client): the consent wording in src/components/CreatorForm.astro is a
 * reconstruction. The brief requires the live page's consent language be kept
 * as-is; the source file supplied was empty. Copy the exact wording across
 * before launch.
 */
import Base from '../layouts/Base.astro';
import CreatorForm from '../components/CreatorForm.astro';
import { CONTACT_EMAIL } from '../consts';

const reasons = [
  {
    title: 'We come to you with the brief already scoped',
    body: 'By the time we get in touch, the brand, the deliverable and the budget are settled. You are not being asked to pitch.',
  },
  {
    title: 'Everything is in writing',
    body: 'Gifted or paid, every collaboration runs on an agreement naming the deliverable, the format, the usage rights and the window. You know what you have agreed to.',
  },
  {
    title: 'You stay on the list',
    body: 'One form puts you in front of every brand we work with, for as long as you want to be there. No re-applying per campaign.',
  },
];
---

<Base
  title="Creators"
  description="Join the AMAVI Socials creator network. One form puts you in front of the brands we work with — healthcare, wellbeing, hospitality and DTC brands across Ireland."
>
  <section class="section page-head">
    <div class="container">
      <h1 class="display display--lg">Join our influencer network.</h1>
      <p class="lead page-head__lead">
        We work with brands across healthcare, wellbeing, hospitality and
        direct-to-consumer retail. Tell us about your channels and what you charge, and
        we will come to you when something fits.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <hr class="rule" />
      <ul class="reasons" role="list">
        {reasons.map((reason) => (
          <li class="reason">
            <h2 class="reason__title">{reason.title}</h2>
            <p class="reason__body">{reason.body}</p>
          </li>
        ))}
      </ul>
      <hr class="rule" />
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <div class="form-head">
        <h2 class="display display--md">Your details</h2>
        <p class="meta form-head__note">
          It takes about five minutes. Only the first few fields are required — the rest
          help us match you to the right brief, so the more you fill in the better.
          Questions? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>

      <CreatorForm />
    </div>
  </section>
</Base>

<style>
  .page-head { padding-bottom: var(--space-l); }
  .page-head__lead { margin-top: var(--space-m); max-width: 48ch; }

  .reasons {
    list-style: none;
    display: grid;
    gap: var(--space-l);
    padding-block: var(--space-xl);
  }
  @media (min-width: 48em) {
    .reasons { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  }

  .reason__title {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
  }
  .reason__body {
    margin-top: var(--space-s);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .form-head { margin-bottom: var(--space-xl); }
  .form-head__note { margin-top: var(--space-s); max-width: 58ch; }
</style>
