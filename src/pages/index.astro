---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import StatTiles, { type Stat } from '../components/StatTiles.astro';
import LoopVideo from '../components/LoopVideo.astro';
import ProofLink from '../components/ProofLink.astro';
import LogoWall from '../components/LogoWall.astro';
import { TILES } from '../data/tiles';
import { MEDIA } from '../data/media';
import {
  SITE_NAME, SITE_URL, SITE_DESCRIPTION, CONTACT_EMAIL, SOCIALS, TAGLINE, POSITIONING, CONTENT_TAGLINE,
} from '../consts';

/**
 * The only figures the stat tiles may show, exactly as supplied — nothing
 * recomputed, no other percentage, and no client named. From AMAVI's
 * programme reporting, April to August 2026. Tiles 1–4 play behind them.
 */
const stats: Stat[] = [
  { value: '23%', label: 'above target on creator partnerships' },
  { value: '47%', label: 'above target for one healthcare client' },
  { value: '40%', label: 'above target for two clients' },
  { value: '92%', label: 'net-new audience reach' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  areaServed: 'IE',
  sameAs: SOCIALS.map((s) => s.url),
};
---

<Base
  title="Creator-Led Marketing and Partnerships Agency, Ireland"
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Hero title={TAGLINE} intro={POSITIONING} />

  {/* ================= Under the hero ================= */}
  <Feature labelledby="equation-heading">
    <h2 id="equation-heading" class="display display--lg">Creators are one part of the equation.</h2>
    <p class="feature__body">
      We build campaigns around <strong>the right people, the right partnerships and the right
      opportunities</strong> — whether that’s a creator, a community, a tourism operator or a brand
      partnership.
    </p>
    <ProofLink href="/services/">49 partnerships delivered against a target of 40</ProofLink>
    {/* Temporary fill: see src/data/media.ts. (Tile 5 isn't used here: its
        burned-in captions read badly as a silent loop.) */}
    <LoopVideo slot="media" src={MEDIA.home.creators.src} ratio="2/3" />
  </Feature>

  {/* ================= Stats on video tiles ================= */}
  <section class="section section--ruled" aria-labelledby="stats-heading">
    <div class="container">
      {/* One line per sentence where there's room, so the break falls between
          them. Which line leads — this or the hero's — is open: see
          CONTENT_TAGLINE in src/consts.ts. */}
      <h2 id="stats-heading" class="display display--lg stats__title">
        {CONTENT_TAGLINE.split(/(?<=\.)\s+/).map((sentence, i) => <>{i > 0 && ' '}<span>{sentence}</span></>)}
      </h2>
      <StatTiles stats={stats} tiles={TILES.slice(0, 4)} />
      <p class="meta stats__source">Four client programmes, April to August 2026.</p>
    </div>
  </section>

  {/* ================= How we work =================
      TODO(client): copy under review — new for this layout, built from what
      the site already says about how AMAVI works. */}
  <Feature reverse ruled labelledby="how-heading">
    <h2 id="how-heading" class="eyebrow">How we work</h2>
    <p class="feature__body">
      From the first shortlist to the final report, we run <strong>every partnership end to
      end</strong> — sourcing, agreements, campaign management and reporting. And <strong>every
      one is agreed in writing</strong> before anything goes live, so what we promise is what
      arrives.
    </p>
    <ProofLink href="/services/">Trusted by brands across Ireland</ProofLink>
    {/* Temporary fill: see src/data/media.ts. */}
    <LoopVideo slot="media" src={MEDIA.home.howWeWork.src} ratio="2/3" />
  </Feature>

  {/* ================= Partners ================= */}
  <section class="section section--tight section--ruled">
    <LogoWall
      marquee
      heading="Our Partners"
      intro="Trusted by brands across healthcare, wellbeing, home services and ecommerce."
    />
  </section>

  {/* ================= Philosophy =================
      TODO(client): confirm the philosophy line. */}
  <section class="section section--ruled philosophy" aria-labelledby="philosophy-heading">
    <div class="container container--narrow philosophy__inner">
      <h2 id="philosophy-heading" class="eyebrow">Our philosophy</h2>
      <p class="display display--md philosophy__line">The right people will always beat more people.</p>
    </div>
  </section>
</Base>

<style>
  .stats__title { margin-bottom: var(--space-xl); }
  .stats__title span { display: block; }
  .stats__source { margin-top: var(--space-m); }

  .philosophy__inner { display: grid; gap: var(--space-m); justify-items: center; text-align: center; }
  .philosophy__line { max-width: 22ch; }
</style>
