---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import Numbers from '../components/Numbers.astro';
import Frame from '../components/Frame.astro';
import ProofLink from '../components/ProofLink.astro';
import LogoWall from '../components/LogoWall.astro';
import ServicesSlider from '../components/ServicesSlider.astro';
import Lines from '../components/Lines.astro';
import { TILES } from '../data/tiles';
import { MEDIA } from '../data/media';
import {
  SITE_NAME, SITE_URL, SITE_DESCRIPTION, CONTACT_EMAIL, CONTACT_PATH, SOCIALS, TAGLINE, POSITIONING,
  CREATOR_PATH,
} from '../consts';

/*
 * The home page's copy. Positioning: a creator-led marketing and
 * partnerships agency — creator marketing at the core, never the limit.
 * "\n" in a display line marks where it breaks.
 *
 * The page opens on the hero and the client logos, then makes its case: what
 * AMAVI is, the numbers, how it works.
 */

/**
 * Two of the five practice areas, in the home page's own words. The other
 * three — content at scale, affiliate, live experiences — can follow here
 * when there's copy for them; the column layout takes as many as it's given.
 */
const WAYS = [
  {
    title: 'Creator & Influencer Community AOR',
    body: 'Build lasting relevance through creator communities rather than one-off activity. By developing long-term relationships with creators who genuinely fit the brand, we create a group of advocates who keep speaking for you between campaigns, not just during them.',
  },
  {
    title: 'Influencer & Creator Campaigns',
    body: 'Our campaigns are built around a business objective, not a posting schedule. We source and vet the creators, negotiate the rates, brief the work and manage it through to publication, so each campaign reaches people the brand hasn’t reached before.',
  },
  {
    title: 'Creator UGC Content',
    body: 'Creator content is one of the most useful assets a brand can own. We produce it in volume, native to the platforms people actually use, and hand it over for your own channels and paid media long after the original post has run.',
  },
  {
    title: 'Affiliate Marketing',
    body: 'We connect creators, content and commerce so the work can be measured against revenue. Partnerships are structured around performance, with tracking and commission agreed from the start.',
  },
  {
    title: 'Live Experiences',
    body: 'We bring creators, customers and the brand into the same room. Each activation is built to be worth attending and worth filming, turning a single moment into content that keeps working afterwards.',
  },
  {
    title: 'Production & Content Days',
    body: 'We shoot and edit in house. A content day gives a brand a library of assets from a single session, and live Q&As put your team and your creators in front of an audience in real time.',
  },
];

/**
 * The four figures, as sentences. Exactly as supplied — nothing recomputed,
 * and no client, sector or industry named against any of them.
 */
const STATS = [
  /* TODO(client): "100+" is ahead of the brief, which has 61 partnerships
     all-time; "1,000+" sits under its 1,100 creators sourced (April–August
     2026), so that one holds. Both are now headline figures — confirm the
     current counts. */
  { value: '100+', line: 'partnerships delivered.' },
  { value: '1,000+', line: 'creators in our network across Europe.' },
  { value: '92%', line: 'of the people we reached had never seen the brand before.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  areaServed: 'IE',
  sameAs: SOCIALS.map((s) => s.url),
};
---

<Base
  title="Creator-Led Marketing and Partnerships Agency, Ireland"
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Hero title={TAGLINE} intro={POSITIONING}>
    <Fragment slot="actions">
      <a href="/services/" class="btn btn--primary">Work with us</a>{' '}
      <a href={CREATOR_PATH} class="btn btn--secondary">Join the creator network</a>
    </Fragment>
  </Hero>

  {/* ================= Partners ================= */}
  <section class="section section--tight partners" aria-label="Brands we work with">
    <LogoWall marquee eyebrow="Trusted by" />
  </section>

  {/* ================= What AMAVI is ================= */}
  <section class="section what">
    <div class="container">
      <div class="stats__note">
        <p>
          As a creator-led marketing and partnerships agency, AMAVI Socials builds brands through
          five key practice areas: Creator &amp; Influencer Community AOR, Influencer &amp; Creator
          Campaigns, Creator UGC Content-at-scale, Affiliate Marketing, and Live Experiences.
          Founded by creators, we combine audience insight, creator relationships, content and
          partnerships to reach people in the places they already spend their attention.
        </p>
        <p>
          Working with brands across Europe, we pair strategic thinking with
          genuine creator relationships to build campaigns that earn attention and deliver
          measurable results.
        </p>
      </div>

    </div>
  </section>

  {/* ================= Results: the figures beside the work ================= */}
  <Numbers tiles={TILES.slice(0, 4)} labelledby="stats-heading">
    <h2 id="stats-heading" class="display display--md">The numbers behind the work</h2>

    <dl class="stat-lines">
      {STATS.map((stat) => (
        <div class="stat-line">
          <dt class="stat-line__value">{stat.value}</dt>
          <dd class="stat-line__text">{stat.line}</dd>
        </div>
      ))}
    </dl>

    <p class="numbers__more">
      <ProofLink href="/about/">Get to know AMAVI</ProofLink>
    </p>
  </Numbers>

  {/* ================= Introduction ================= */}
  <Feature labelledby="equation-heading">
    <h2 id="equation-heading" class="display display--lg">
      <Lines text={'Our creators are one part\nof the equation.'} />
    </h2>
    <p class="feature__body">
      Our campaigns are built around <strong>the right people, partnerships and right
      opportunities</strong>, from individual creators and communities to B2B collaborations and
      new routes to your audience. Every engagement starts with a clear objective. We identify the
      opportunity and develop the strategy to realise it.
    </p>
    <ProofLink href={CONTACT_PATH}>Contact us</ProofLink>
    {/* AMAVI's own campaign board: see src/data/media.ts. */}
    <Frame slot="media" media={MEDIA.home.creators} ratio="2/3" sizes="(min-width: 48em) 22rem, 60vw" />
  </Feature>

  {/* ================= How we work ================= */}
  {/* ================= Services ================= */}
  <section class="section section--ruled ways" aria-labelledby="ways-heading">
    <div class="container ways__grid">
      <div class="ways__head">
        <h2 id="ways-heading" class="display display--lg">
          <Lines text={'See the ways\nwe can help you.'} />
        </h2>
      </div>

      <div class="ways__body">
        <ServicesSlider services={WAYS} />

        <p class="ways__more">
          <ProofLink href="/services/">View more details</ProofLink>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* A plain centred statement, no heading: what AMAVI is, before the figures. */
  /* The label, the logos and the paragraph under them are one group, so
     the space inside it is a fraction of what separates sections: the row
     belongs to the hero above it and to the statement below it. */
  .partners { padding-block: clamp(0.875rem, 0.5rem + 1.4vw, 1.575rem); }
  .what { padding-top: clamp(1.375rem, 0.8rem + 2.6vw, 2.875rem); }

  /* ---- The figures, as sentences: the number leading each line ---- */
  .stat-lines { display: grid; }
  /* No rules: the figures stand apart on space alone. */
  .stat-lines { gap: var(--space-l); }
  .stat-line {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-s);
  }

  .stat-line__value {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  @media (min-width: 64em) and (max-width: 79.99em) {
    .stat-line__value { font-size: 2rem; }
  }
  .stat-line__text { font-weight: var(--weight-secondary); text-wrap: pretty; }

  /* Its own element rather than a footnote: with the column's 24px gap, about
     40px of air above the words, and 32 on a phone. */
  .numbers__more { margin-top: var(--space-s); }
  @media (max-width: 47.99em) { .numbers__more { margin-top: var(--space-2xs); } }

  /* ---- Services: the heading on one side, the ways on the other ---- */
  .ways__grid { display: grid; gap: var(--space-xl); }
  @media (min-width: 64em) {
    .ways__grid { grid-template-columns: minmax(0, 40fr) minmax(0, 60fr); column-gap: var(--space-xl); row-gap: var(--space-2xl); align-items: start; }
  }
  .ways__head { display: grid; gap: var(--space-m); align-content: start; }

  /* A step on from the cards, not one of them: its own space, and centred
     under the slider once there is room for it. */
  .ways__more { margin-top: clamp(2rem, 1.2rem + 2vw, 3rem); }
  @media (min-width: 48em) { .ways__more { text-align: center; } }

  .stats__note {
    display: grid;
    gap: var(--space-s);
    /* A step up from body: this is the page's statement, not running text. */
    font-size: var(--text-lead);
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-2xl);
    text-align: center;
  }

</style>
