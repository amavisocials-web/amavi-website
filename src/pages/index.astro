---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LogoWall from '../components/LogoWall.astro';
import ContentTiles, { type Tile } from '../components/ContentTiles.astro';
import Stats, { type Stat } from '../components/Stats.astro';
import {
  SITE_NAME, SITE_URL, SITE_DESCRIPTION, CONTACT_EMAIL, SOCIALS, TAGLINE, CONTENT_TAGLINE, CREATOR_PATH,
} from '../consts';

/** TODO(client): swap each placeholder for a reel or still — see ContentTiles. */
const tiles: Tile[] = [
  { kind: 'reel' },
  { kind: 'image' },
  { kind: 'reel' },
  { kind: 'image' },
  { kind: 'reel' },
];

/**
 * The only figures this block may show, exactly as supplied — nothing
 * recomputed, no other percentage, and no client named. From AMAVI's
 * programme reporting, April to August 2026.
 */
const stats: Stat[] = [
  { value: '23%', label: 'Above target on creator partnerships', detail: '49 delivered against a target of 40' },
  { value: '47%', label: 'Above target for one healthcare client', detail: '22 against a target of 15' },
  { value: '40%', label: 'Above target for two clients', detail: '14 against a target of 10, and 7 against 5' },
  { value: '92%', label: 'Net-new audience reach', detail: 'Reached people who weren’t already following' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  areaServed: 'IE',
  sameAs: SOCIALS.map((s) => s.url),
};
---

<Base
  title="Influencer Marketing Agency Ireland"
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Hero
    title={TAGLINE}
    subtitle="Fully managed influencer and creator partnerships for brands across Ireland."
  >
    <Fragment slot="actions">
      <a href="/services/" class="btn btn--primary">Work With Us</a>{' '}
      <a href={CREATOR_PATH} class="btn btn--secondary">Join the Creator Network</a>
    </Fragment>
  </Hero>

  {/* ================= Partners =================
      Straight after the dark hero, so no rule above it: the edge is the rule.
      The marquee runs the full width of the screen. */}
  <section class="section section--tight partners">
    <LogoWall
      marquee
      heading="Our Partners"
      intro="Trusted by brands across healthcare, wellbeing, home services and ecommerce."
    />
  </section>

  {/* ================= Stats ================= */}
  <section class="section section--ruled">
    <div class="container">
      <Stats heading="Results" stats={stats} source="Four client programmes, April to August 2026." />
    </div>
  </section>

  {/* ================= Content ================= */}
  <section class="section section--ruled">
    <div class="container">
      <div class="section-head section-head--center">
        {/* One line per sentence where there's room, so the break falls
            between them rather than wherever the width happens to put it. */}
        <h2 class="display display--lg content__tagline">
          {CONTENT_TAGLINE.split(/(?<=\.)\s+/).map((sentence, i) => <>{i > 0 && ' '}<span>{sentence}</span></>)}
        </h2>
      </div>

      <ContentTiles tiles={tiles}>
        <p class="display display--md summary__statement">
          Asked for 40 partnerships. Delivered 49.
        </p>
        {/* The "top content" finding is per account, from each account's
             trailing 90-day analytics in the report — hence "in our reporting"
             rather than a claim about April–August specifically. */}
        <p class="lead summary__lead">
          Four client programmes, April to August 2026 — and on all four accounts,{' '}
          <strong>the top-performing content in our reporting was made by creators</strong>.
        </p>
        <a href="/services/" class="btn btn--primary">Work With Us</a>
      </ContentTiles>
    </div>
  </section>
</Base>

<style>
  .partners { padding-bottom: var(--space-s); }
  .content__tagline span { display: block; }
  .summary__statement { max-width: 28ch; }
  .summary__lead { max-width: 46ch; }
</style>
