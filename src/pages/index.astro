---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Feature from '../components/Feature.astro';
import Numbers from '../components/Numbers.astro';
import Frame from '../components/Frame.astro';
import ProofLink from '../components/ProofLink.astro';
import LogoWall from '../components/LogoWall.astro';
import ServiceList from '../components/ServiceList.astro';
import Lines from '../components/Lines.astro';
import { TILES } from '../data/tiles';
import { SERVICE_AREAS } from '../data/services';
import { MEDIA } from '../data/media';
import {
  SITE_NAME, SITE_URL, SITE_DESCRIPTION, CONTACT_EMAIL, CONTACT_PATH, SOCIALS, TAGLINE, POSITIONING,
  CREATOR_PATH,
} from '../consts';

/*
 * The home page's copy. Positioning: a creator-led marketing and
 * partnerships agency — creator marketing at the core, never the limit.
 * "\n" in a display line marks where it breaks.
 *
 * The page opens on the hero and the client logos, then makes its case: what
 * AMAVI is, the numbers, how it works.
 */

/**
 * The four figures, as sentences. Exactly as supplied — nothing recomputed,
 * and no client, sector or industry named against any of them.
 */
const STATS = [
  /* TODO(client): "100+" is ahead of the brief, which has 61 partnerships
     all-time; "1,000+" sits under its 1,100 creators sourced (April–August
     2026), so that one holds. Both are now headline figures — confirm the
     current counts. */
  { value: '100+', line: 'partnerships delivered.' },
  { value: '1,000+', line: 'creators in our network across Europe.' },
  { value: '92%', line: 'net-new audience reached.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  email: CONTACT_EMAIL,
  areaServed: 'Europe',
  sameAs: SOCIALS.map((s) => s.url),
};
---

<Base
  title="Creator-Led Marketing and Partnerships Agency, Europe & ROW"
  description={SITE_DESCRIPTION}
  schema={schema}
>
  <Hero title={TAGLINE} intro={POSITIONING} subline={['Brands', 'Creators']}>
    <Fragment slot="actions">
      <a href={CONTACT_PATH} class="btn btn--primary">Work with us</a>{' '}
      <a href={CREATOR_PATH} class="btn btn--secondary">Join the creator network</a>
    </Fragment>
  </Hero>

  {/* ================= Partners ================= */}
  <section class="section section--tight partners" aria-label="Brands we work with">
    <LogoWall marquee eyebrow="Trusted by" />
  </section>

  {/* ================= What AMAVI is ================= */}
  <section class="section what">
    <div class="container">
      <div class="stats__note">
        <p>
          Founded by creators, AMAVI Socials builds brands through five key practice areas:
          Creator &amp; Influencer Community Agency of Record, Influencer &amp; Creator Campaigns,
          Creator UGC Content-at-scale, Affiliate Marketing, and Live Experiences.
        </p>
        <p>
          We combine audience insight, creator relationships, content and partnerships to reach
          people in the places they already spend their attention.
        </p>
        <p>
          Working with brands across Ireland, UK, Netherlands, France, Germany and the Balkans, we
          pair strategic thinking with genuine creator relationships to build monthly campaigns
          that earn attention and deliver measurable results.
        </p>
      </div>

    </div>
  </section>

  {/* ================= Results: the figures beside the work ================= */}
  <Numbers tiles={TILES.slice(0, 4)} labelledby="stats-heading">
    <h2 id="stats-heading" class="display display--md">The numbers behind the work</h2>

    <dl class="figures">
      {STATS.map((stat) => (
        <div class="figures__item">
          <dt class="figures__value">{stat.value}</dt>
          <dd class="figures__label">{stat.line}</dd>
        </div>
      ))}
    </dl>

    <p class="numbers__more">
      <ProofLink href="/about/">Get to know AMAVI</ProofLink>
    </p>
  </Numbers>

  {/* ================= Case study ================= */}
  {/* TODO(client): the partner is unnamed, and the three figures are the
      client's own wording as supplied. Confirm whether the healthcare partner
      may be named, and whether the figures can be published as they stand. */}
  <Feature labelledby="case-heading">
    <p class="eyebrow">Case study</p>
    <h2 id="case-heading" class="display display--lg">
      Building an always-on creator strategy for our healthcare partner
    </h2>
    <p class="feature__body">
      Starting with no established influencer marketing strategy, we built a creator programme
      designed to make influencer marketing a consistent part of the wider growth strategy.
    </p>
    <p class="feature__body">
      By combining strategic creator selection, authentic storytelling, ongoing partnership
      management and performance-led optimisation, the programme grew from individual
      collaborations into an always-on network of creators.
    </p>
    <p class="feature__body">
      In the initial six months of our partnership, the company saw <strong>60% revenue
      growth</strong>, and has since launched <strong>100+ creator partnerships</strong> with{' '}
      <strong>25 active partnerships currently running and fully managed by AMAVI Socials</strong>.
    </p>
    {/* AMAVI's own campaign board: see src/data/media.ts. */}
    <Frame slot="media" media={MEDIA.home.creators} ratio="2/3" sizes="(min-width: 48em) 22rem, 60vw" />
  </Feature>

  {/* ================= How we work ================= */}
  {/* ================= Services ================= */}
  <section class="section section--ruled ways" aria-labelledby="ways-heading">
    <div class="container ways__grid">
      <div class="ways__head">
        <h2 id="ways-heading" class="display display--lg">
          <Lines text={'See the ways\nwe can help you'} />
        </h2>
      </div>

      <div class="ways__body">
        {/* The same rows as the services page, opening on the paragraph
            alone: no services under them and no pictures. */}
        <ServiceList areas={SERVICE_AREAS} detail={false} level={3} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* A plain centred statement, no heading: what AMAVI is, before the figures. */
  /* The label, the logos and the paragraph under them are one group, so
     the space inside it is a fraction of what separates sections: the row
     belongs to the hero above it and to the statement below it. */
  .partners { padding-block: clamp(0.875rem, 0.5rem + 1.4vw, 1.575rem); }
  .what { padding-top: clamp(1.375rem, 0.8rem + 2.6vw, 2.875rem); }

  /* ---- The figures: the number, and what it counts under it ----
     Side by side on one baseline, the number and its line read as one
     sentence and the eye has nothing to catch on. Stacked, with the number
     in the accent and the line in body text under it, each figure is a
     figure first: the number is the thing being shown, the line is the
     caption. No rules between them; the space does that work. */
  .figures { display: grid; gap: var(--space-l); }
  .figures__item { display: grid; gap: var(--space-3xs); }

  .figures__value {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--accent);
  }
  @media (min-width: 64em) and (max-width: 79.99em) {
    .figures__value { font-size: 2rem; }
  }
  /* Not the light body weight the rest of the column runs: under a 40px
     number the light cut all but disappears, and the pair stops reading as
     a figure and its caption. */
  .figures__label { font-weight: 400; text-wrap: pretty; }

  /* Its own element rather than a footnote: with the column's 24px gap, about
     40px of air above the words, and 32 on a phone. */
  .numbers__more { margin-top: var(--space-s); }
  @media (max-width: 47.99em) { .numbers__more { margin-top: var(--space-2xs); } }

  /* ---- Services: the heading on one side, the ways on the other ---- */
  .ways__grid { display: grid; gap: var(--space-xl); }
  @media (min-width: 64em) {
    .ways__grid { grid-template-columns: minmax(0, 40fr) minmax(0, 60fr); column-gap: var(--space-xl); row-gap: var(--space-2xl); align-items: start; }
  }
  .ways__head { display: grid; gap: var(--space-m); align-content: start; }


  .stats__note {
    display: grid;
    gap: var(--space-s);
    /* A step up from body: this is the page's statement, not running text. */
    font-size: var(--text-lead);
    max-width: var(--container-narrow);
    margin: 0 auto var(--space-2xl);
    text-align: center;
  }

</style>
