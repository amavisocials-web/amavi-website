---
import Base from '../../layouts/Base.astro';
import JournalRow from '../../components/JournalRow.astro';
import Subscribe from '../../components/Subscribe.astro';
import { publishedPosts } from '../../lib/journal';
import { SITE_NAME, SITE_URL } from '../../consts';

/**
 * The journal: a masthead, the one ask, then every published post, newest
 * first.
 *
 * The masthead is the publication's own front page — centred, with room
 * around it — and the list below it is separated by the same hairline the
 * rows use between themselves, so the two read as parts of one page.
 *
 * A list, not a grid and not cards — rows separated by the same barely-there
 * hairline the rest of the site uses between sections, with the space inside
 * each row doing the work a card would otherwise do.
 *
 * Nothing here knows how many posts there are or what is in them: adding a
 * markdown file to src/content/journal/ adds a row.
 */
const posts = await publishedPosts();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${SITE_NAME} Journal`,
  url: new URL('/journal/', SITE_URL).href,
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
};
---

<Base
  title="Journal"
  description="Notes on the work: what we are seeing in creator marketing, culture and the places attention actually goes."
  schema={schema}
>
  <link slot="head" rel="alternate" type="application/rss+xml"
        title={`${SITE_NAME} Journal`} href="/journal/rss.xml" />

  <section class="section journal">
    <div class="container">
      <div class="journal__masthead">
        <p class="eyebrow">AMAVI Socials</p>
        <h1 class="display display--lg">The Journal</h1>
        <p class="journal__standfirst">
          Notes on creator marketing, culture and the work. Published weekly.
        </p>
      </div>

      <div class="journal__subscribe">
        <Subscribe level={2} />
      </div>

      {posts.length > 0 ? (
        <div class="journal__list">
          {posts.map((post) => <JournalRow post={post} level={2} />)}
        </div>
      ) : (
        <p class="journal__empty">The first piece is being written. Check back shortly.</p>
      )}
    </div>
  </section>
</Base>

<script>
  import '../../scripts/journal-preview';
</script>

<style>
  /* The masthead: centred, with real space around it. */
  .journal__masthead {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }
  .journal__standfirst {
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    line-height: 1.6;
    max-width: 46ch;
    opacity: 0.7;
    text-wrap: pretty;
  }

  /* The ask sits under the masthead and is centred with it, but its own form
     ranges left: a centred input and button read as a different page. */
  .journal__subscribe {
    display: grid;
    justify-items: center;
    margin-top: clamp(2rem, 1.2rem + 3.4vw, 3.5rem);
  }
  .journal__subscribe > :global(.subscribe) { justify-items: center; text-align: center; }
  .journal__subscribe :global(.subscribe__line) { margin-inline: auto; }
  .journal__subscribe :global(.subscribe__form) { text-align: left; width: 100%; }

  /* One hairline between the masthead and the list. */
  .journal__list {
    margin-top: clamp(2.75rem, 1.6rem + 5.25vw, 6rem);
    border-top: var(--stroke) solid var(--divider-line);
  }

  /* One hairline between rows, and one closing the list. The same line the
     site uses between sections. */
  .journal__list > :global(.jrow) { border-bottom: var(--stroke) solid var(--divider-line); }

  .journal__empty {
    margin-top: var(--space-xl);
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    opacity: 0.7;
  }
</style>
