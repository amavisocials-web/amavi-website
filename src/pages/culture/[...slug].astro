---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publishedPosts, formatDate, isoDate, culturePath } from '../../lib/culture';
import { SITE_NAME, SITE_URL } from '../../consts';

/**
 * One AMAVI Culture piece — **a preview, not the article.**
 *
 * Changed on 23 October 2026, when the section moved from /journal, and again
 * later the same day. The markdown holds only the opening paragraphs; the last
 * of them fades as it is read and the reader is handed to Substack to finish.
 *
 * **The fade is on the last paragraph alone**, not on the body. It was on the
 * body first, as a 160px band off the bottom, which put the softest part of it
 * wherever the body happened to end rather than inside a sentence. Now the
 * stylesheet masks `.prose > p:last-of-type`, so it starts partway through the
 * closing paragraph and is gone by its last line whatever the line breaks do.
 * Nothing below the body is ever masked: the call to action is a sibling.
 *
 * Two things came off with that rewrite. The reading-progress bar measured a
 * scroll through a whole article and there is no longer one to measure. The
 * share row and the "next" block went with the brief's "nothing else after the
 * CTA except the back link": the page has one ask on it now.
 *
 * Drafts never reach here: getStaticPaths reads the same published list as the
 * index and the feed, so a post marked `draft: true` has no page to find.
 */
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const SUBSTACK_HOME = 'https://amavisocials.substack.com/';

/* TODO(client): the real photographer or agency credit, per picture. Until
   then one line covers the band, which is what was asked for. */
const IMAGE_CREDIT =
  'Image: not owned by AMAVI Socials. All rights remain with the original photographer.';

const { post } = Astro.props;
const { Content } = await render(post);
const { title, subtitle, excerpt, date, readingTime, image, heroImages, substackUrl } = post.data;

const url = new URL(culturePath(post.id), SITE_URL).href;
// Substack holds the full piece, so it is the original and takes the canonical.
const canonical = substackUrl || undefined;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: isoDate(date),
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical ?? url },
  ...(image ? { image: new URL(image, SITE_URL).href } : {}),
};

/* Descriptions of the two supplied pictures, by file, so the alt text does not
   have to live in the markdown. */
const ALT: Record<string, string> = {
  '/media/culture/show-arrival.jpg':
    "A car with a TOD'S placard in the windscreen arriving at a show as photographers crowd the barrier",
  '/media/culture/front-row.jpg':
    'Three guests on the front row in leather and tartan looks, photographed from the runway',
};
---

<Base
  title={title}
  description={excerpt}
  ogImage={image || undefined}
  ogType="article"
  canonical={canonical}
  schema={schema}
>
  <article class="post">
    {/* The band, above the title. */}
    {heroImages && heroImages.length > 0 && (
      <div class="container post__band-wrap">
        <div class="post__band" data-count={heroImages.length}>
          {heroImages.map((src) => (
            <img class="post__band-img" src={src} alt={ALT[src] ?? ''} loading="eager" decoding="async" />
          ))}
        </div>
        <p class="post__band-credit">{IMAGE_CREDIT}</p>
      </div>
    )}

    <header class="section post__head">
      <div class="container post__head-inner">
        <p class="post__meta">
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {readingTime && <> &middot; {readingTime} min read</>}
        </p>
        <h1 class="display post__title">{title}</h1>
        {subtitle && <p class="post__lead">{subtitle}</p>}
      </div>
    </header>

    <div class="container">
      <div class="prose post__body">
        <Content />
      </div>
    </div>
  </article>

  {/* Outside the body, and so never under the mask. */}
  <div class="container">
    <div class="post__cta">
      <h2 class="display display--md post__cta-title">Read the full article</h2>
      <p class="post__cta-line">AMAVI Cultured publishes weekly on Substack. Free to read.</p>
      {substackUrl ? (
        <p>
          <a class="btn btn--primary" href={substackUrl} target="_blank" rel="noopener noreferrer">
            Read on Substack<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      ) : (
        /* TODO(client): no substackUrl on this post, so there is nowhere to
           send the reader. Add it to the frontmatter and the button returns. */
        <p class="post__cta-missing">The full piece is not published yet.</p>
      )}
      <p class="post__cta-all">
        <a href={SUBSTACK_HOME} target="_blank" rel="noopener noreferrer">
          See all of AMAVI Cultured<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </p>
    </div>

    <p class="post__return">
      <a class="post__back" href="/culture/">
        <svg class="post__back-arrow" viewBox="0 0 22 12" aria-hidden="true" focusable="false">
          <path d="M22 6H3M7.5 1L2 6l5.5 5" fill="none" stroke="currentColor"
                stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        Back to AMAVI Culture
      </a>
    </p>
  </div>
</Base>

<style>
  /* ---- The band ---------------------------------------------------------- */
  /* Side by side at every width. On a phone it keeps the shape and loses
     height instead of stacking, because the pair is the shape. */
  .post__band-wrap { padding-top: var(--space-l); }
  .post__band {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-s);
    height: 30vh;
    min-height: 11rem;
  }
  .post__band[data-count='2'] { grid-template-columns: 1fr 1fr; }
  @media (min-width: 64em) {
    .post__band { height: 45vh; min-height: 18rem; }
  }
  .post__band-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-frame);
  }
  /* The site's small print. 0.7 and not lower: 0.6 of #222021 misses AA. */
  .post__band-credit {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    font-weight: var(--weight-secondary);
    line-height: 1.5;
    opacity: 0.7;
    text-wrap: pretty;
  }

  /* ---- The header: centred, with room ------------------------------------ */
  .post__head { padding-block: clamp(2rem, 1.2rem + 3.4vw, 3.5rem) var(--space-l); }
  .post__head-inner {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    text-align: center;
  }

  .post__meta {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    /* See the note on .crow__date: 0.6 of #222021 misses AA at this size. */
    opacity: 0.7;
  }

  .post__title {
    font-size: var(--display-lg);
    max-width: 20ch;
    text-wrap: balance;
  }

  .post__lead {
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    line-height: 1.6;
    max-width: 56ch;
    opacity: 0.7;
    text-wrap: pretty;
  }

  /* ---- The preview ------------------------------------------------------- */
  .post__body {
    max-width: 68ch;
    margin-inline: auto;
    font-size: var(--text-lead);
    font-weight: var(--weight-body);
    line-height: 1.7;
  }

  .post__body :global(p) { margin-block: 0 1.35em; }

  /* The closing paragraph dissolves as it is read. The mask is on the
     paragraph and not on the body, so the fade always begins inside a sentence
     rather than wherever the column happens to stop: --fade-start is a share of
     this paragraph's own height, so it lands near "They are" at every width,
     however the lines break. An opacity gradient, no blur. */
  .post__body :global(p:last-of-type) {
    --fade-start: 22%;
    margin-bottom: 0;
    -webkit-mask-image: linear-gradient(to bottom, #000 var(--fade-start), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 var(--fade-start), transparent 100%);
  }

  .post__body :global(strong) { font-weight: var(--weight-strong); }
  .post__body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }

  /* ---- The hand-off to Substack ------------------------------------------ */
  /* Centred, with room around it, and never masked: it is a sibling of the
     body, not a child. */
  .post__cta {
    display: grid;
    justify-items: center;
    gap: var(--space-s);
    max-width: 56ch;
    margin-inline: auto;
    padding-block: var(--space-2xl);
    text-align: center;
  }
  .post__cta-title { text-wrap: balance; }
  .post__cta-line {
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    max-width: 40ch;
    opacity: 0.7;
    text-wrap: pretty;
  }
  .post__cta-all { margin-top: var(--space-2xs); }
  .post__cta-all a {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
    color: var(--ink);
  }
  .post__cta-all a:hover { color: var(--accent); }
  .post__cta-missing { font-size: var(--text-sm); font-weight: var(--weight-secondary); opacity: 0.7; }

  /* ---- The way back ------------------------------------------------------ */
  .post__return { padding-bottom: var(--section-y); text-align: center; }

  .post__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }
  .post__back-arrow { width: 1.1rem; height: 0.6rem; transition: transform var(--dur) var(--ease); }
  .post__back:hover { color: var(--accent); }
  .post__back:hover .post__back-arrow { transform: translateX(-3px); }

  @media (prefers-reduced-motion: reduce) {
    .post__back-arrow { transition: none; }
    .post__back:hover .post__back-arrow { transform: none; }
  }
</style>
