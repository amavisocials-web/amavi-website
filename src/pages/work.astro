---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import LogoWall from '../components/LogoWall.astro';
import TargetDelivery from '../components/TargetDelivery.astro';
import ReachMeters from '../components/ReachMeters.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import CTA from '../components/CTA.astro';

/**
 * Every figure on this page is reproduced exactly as it appears in AMAVI's
 * cumulative creator-programme report for April to August 2026. Nothing is
 * rounded, combined, extrapolated, or computed from the parts.
 */

const published = (await getCollection('case-studies', ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Render each entry's body up front so the template stays synchronous.
const caseStudies = await Promise.all(
  published.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

const clients = ['ADHD Now', 'Fettle', 'AutismCare Ireland', 'Cleaning Doctor Hub', 'MyIrelandBox'];

const delivery = [
  { client: 'ADHD Now', target: 15, delivered: 22, outcome: '7 partnerships beyond target' },
  { client: 'Fettle', target: 10, delivered: 14, outcome: '4 partnerships above target' },
  {
    client: 'Cleaning Doctor',
    target: 10,
    delivered: 6,
    outcome: '6 further collaborations in progress, 3 confirmed for September',
    belowTarget: true,
  },
  { client: 'AutismCare', target: 5, delivered: 7, outcome: '2 partnerships beyond target' },
];

const reach = [
  { client: 'ADHD Now', views: '3.6M+', nonFollower: 87.7 },
  { client: 'Cleaning Doctor', views: '380,054', nonFollower: 94.8 },
  { client: 'AutismCare', views: '281,664', nonFollower: 95.9 },
  { client: 'Fettle', views: '204K+', nonFollower: 93.4 },
];
---

<Base
  title="Work"
  description="Creator programmes for ADHD Now, Fettle, AutismCare Ireland and Cleaning Doctor Hub. 49 partnerships delivered against a target of 40 between April and August 2026."
>
  <!-- ================= Lead ================= -->
  <section class="section lead-section">
    <div class="container">
      <div class="lead-grid">
        <div>
          <h1 class="display display--lg">
            We were asked for 40 partnerships. We delivered 49.
          </h1>
          <p class="lead lead-section__lead">
            Four client programmes, five months, April to August 2026. This is the
            record against what was actually committed to.
          </p>
        </div>

        <figure class="headline-figure">
          <p class="headline-figure__value">49</p>
          <figcaption class="headline-figure__label">
            partnerships delivered against a target of 40
          </figcaption>
          <p class="headline-figure__delta">9 beyond target</p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= Delivery against target ================= -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--md">Delivery against target</h2>
        <p class="meta">
          Each programme was set a partnership target at the outset. Three finished
          beyond it. One is still building, and we have left it in rather than out.
        </p>
      </div>

      <TargetDelivery
        rows={delivery}
        scaleMax={25}
        caption="Partnerships active and completed per client, April to August 2026, against the target agreed at the start of each programme. Totals: 49 delivered against a combined target of 40."
      />
    </div>
  </section>

  <!-- ================= Reach ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--md">How much of the reach was new</h2>
        <p class="meta">
          The number that matters most on this page, and the one most campaign reports
          leave out.
        </p>
      </div>

      <div class="reach-intro">
        <p class="prose">
          Views and impressions cannot tell you whether a campaign worked, because a post
          that recirculates your existing following and a post that finds a new audience
          look identical in a summary. Non-follower reach separates the two. Across all
          four programmes it sat between 87.7% and 95.9% — meaning the overwhelming
          majority of the people reached were not already following the brand.
        </p>
      </div>

      <ReachMeters
        rows={reach}
        caption="Client account totals over the trailing 90 days, covering the period each partnership ran. These are account-level figures and are not attributable to creator content alone — they are not presented as campaign results."
      />
    </div>
  </section>

  <!-- ================= Clients ================= -->
  <section class="section section--tight section--alt">
    <div class="container">
      <LogoWall clients={clients} heading="Clients" />
    </div>
  </section>

  <!-- ================= Case studies ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="display display--md">Case studies</h2>
        <p class="meta">
          Named by client and by outcome. We do not publish creator handles, creator
          quotes, links to individual posts or insights screenshots — that material
          belongs to the creators and the clients.
        </p>
      </div>

      <div class="case-studies">
        {caseStudies.map(({ data, Content }, index) => (
          <div class="case-studies__item">
            <hr class="rule" />
            <CaseStudyCard
              client={data.client}
              sector={data.sector}
              summary={data.summary}
              challenge={data.challenge}
              approach={data.approach}
              results={data.results}
              deliverables={data.deliverables}
              tone={data.tone}
              flipped={index % 2 === 1}
            >
              <Content />
            </CaseStudyCard>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA
    heading="Your programme would get the same reporting."
    body="Delivery against an agreed target, and how much of the reach was genuinely new. Tell us what you are trying to reach."
    primaryLabel="Start a project"
    primaryHref="/contact/"
  />
</Base>

<style>
  .lead-section { padding-bottom: var(--space-xl); }

  .lead-grid { display: grid; gap: var(--space-xl); align-items: end; }
  .lead-section__lead { margin-top: var(--space-m); max-width: 44ch; }

  /* The page's single hero figure. Set in the text face, not the display
     serif — a serif numeral at this size reads as decoration, not data. */
  .headline-figure {
    margin: 0;
    padding-top: var(--space-m);
    border-top: 1px solid var(--ink);
  }
  .headline-figure__value {
    font-family: var(--font-body);
    font-size: clamp(4rem, 2rem + 9vw, 7rem);
    font-weight: 500;
    line-height: 0.85;
    letter-spacing: -0.045em;
    font-variant-numeric: proportional-nums;
    color: var(--ink);
  }
  .headline-figure__label {
    margin-top: var(--space-s);
    font-size: var(--text-base);
    line-height: 1.4;
    color: var(--ink);
    max-width: 20ch;
  }
  .headline-figure__delta {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent);
  }

  @media (min-width: 60em) {
    .lead-grid { grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr); gap: var(--space-2xl); }
  }

  .reach-intro { margin-bottom: var(--space-xl); }

  .case-studies { display: grid; gap: var(--space-2xl); }
  .case-studies__item .rule { margin-bottom: var(--space-xl); }
</style>
