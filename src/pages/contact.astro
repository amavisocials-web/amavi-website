---
import Base from '../layouts/Base.astro';
import ContactPaths from '../components/ContactPaths.astro';
---

<Base
  title="Get in Touch"
  description="Brands: email AMAVI Socials to start a campaign with the right creators, communities and partners. Creators: apply to join the AMAVI creator network."
>
  <section class="section page-head">
    <div class="container">
      <h1 class="display display--lg">Get in touch</h1>
    </div>
  </section>

  <section class="section section--tight contact-section">
    <div class="container">
      <ContactPaths level={2} size="page" />
    </div>
  </section>
</Base>

<style>
  /* The heading, centred on the container. The cards below are untouched. */
  .page-head { padding-bottom: var(--space-l); text-align: center; }
  .contact-section { padding-top: 0; }

</style>
