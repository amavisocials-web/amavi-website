---
import Base from '../layouts/Base.astro';
import ContactPaths from '../components/ContactPaths.astro';
import { SOCIALS } from '../consts';
---

<Base
  title="Get in Touch"
  description="Brands: email AMAVI Socials to start a creator partnership programme. Creators: apply to join the AMAVI creator network."
>
  <section class="section page-head">
    <div class="container">
      <h1 class="display display--lg">Get in touch</h1>
      <p class="lead page-head__lead">Two ways in, depending on which side of the partnership you’re on.</p>
    </div>
  </section>

  <section class="section section--tight contact-section">
    <div class="container">
      <ContactPaths level={2} size="page" />

      <p class="elsewhere meta">
        Or find us on{' '}
        {SOCIALS.map((s, i) => (
          <>
            {i > 0 && ' and '}
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </>
        ))}.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-bottom: var(--space-l); }
  .page-head__lead { margin-top: var(--space-m); }
  .contact-section { padding-top: 0; }

  .elsewhere { margin-top: var(--space-l); }
</style>
