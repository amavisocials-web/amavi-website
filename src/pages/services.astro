---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import ReachMeters from '../components/ReachMeters.astro';
import LogoWall from '../components/LogoWall.astro';
import { SERVICE_AREAS, SECTOR_EXAMPLES } from '../data/services';
import { MEDIA } from '../data/media';
import { SITE_NAME, SITE_URL } from '../consts';

/**
 * What AMAVI does: three areas, each with its services, then short sector
 * examples. The copy lives in src/data/services.ts.
 *
 * Laid out like the home page: an index up top that jumps to each area, then
 * each area as text beside a portrait image, alternating sides.
 *
 * Images: one portrait (2:3) for the top of the page, one per area, and one
 * (4:5) per sector example — all set in src/data/media.ts, where they are
 * marked as temporary fills. A slot left empty there shows "Add image".
 */

/** The programme, in the order it runs. A real sequence, so it is numbered. */
const programme = [
  { title: 'Sourcing', body: 'A shortlist built from our own creator database and fresh research against your brief.' },
  { title: 'Vetting', body: 'Audience quality, real engagement and brand fit — checked before a name ever reaches you.' },
  { title: 'Outreach', body: 'We approach creators in our name, not yours, so a “no” costs you nothing.' },
  { title: 'Agreements', body: 'Deliverables, formats, usage rights and timings, in writing, before anything is posted.' },
  { title: 'Campaign management', body: 'Briefing, approvals, scheduling, boosting and tagging. You see content before it goes live.' },
  { title: 'Reporting', body: 'Delivery against target, content and reach — and how much of that reach was new.' },
];

/**
 * Per-account reach, by sector rather than by name, as requested.
 *
 * Source: AMAVI's cumulative creator-programme report, April–August 2026.
 * These are CLIENT ACCOUNT totals over the trailing 90 days, not figures
 * attributable to creator content alone (brief §5). The caption says so, and
 * it must stay whatever else changes here.
 */
const accounts = [
  { client: 'Neurodiversity assessment provider', views: '3.6M+', nonFollower: 87.7 },
  { client: 'Home services franchise network', views: '380,054', nonFollower: 94.8 },
  { client: 'Autism assessment and aftercare service', views: '281,664', nonFollower: 95.9 },
  { client: 'Mental health concierge platform', views: '204K+', nonFollower: 93.4 },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICE_AREAS.flatMap((area) => area.services.map((service) => ({ area, service }))).map(
    ({ area, service }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: service.description,
        category: area.title,
        areaServed: { '@type': 'Country', name: 'Ireland' },
        provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      },
    }),
  ),
};
---

<Base
  title="Services"
  description="Creator marketing, brand and campaign strategy, and growth partnerships: the creators, communities, businesses and partners that put a brand in front of the right audience."
  schema={schema}
>
  {/* ================= Head: the question, and an index ================= */}
  <section class="section svc-head">
    <div class="container svc-head__grid">
      <div class="svc-head__text">
        <h1 class="display display--lg">What we do depends on what you need.</h1>
        <p class="lead svc-head__lead">
          Creator partnerships are our speciality, not our limit. We find the people and
          opportunities that put your brand in front of the right audience — <strong>creators,
          communities, businesses and partners</strong>.
        </p>
        <ol class="svc-index" role="list">
          {SERVICE_AREAS.map((area) => (
            <li>
              <a class="svc-index__link" href={`#${area.id}`}>
                <span class="svc-index__number">{area.number}</span>
                <span class="svc-index__title">{area.title}</span>
                <svg viewBox="0 0 10 20" aria-hidden="true">
                  <path d="M1 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                </svg>
              </a>
            </li>
          ))}
        </ol>
      </div>
      <Frame slot={MEDIA.services.head} ratio="2/3" class="svc-head__media" />
    </div>
  </section>

  {/* ================= The three areas ================= */}
  {SERVICE_AREAS.map((area, i) => (
    <section class:list={['section', 'section--ruled', 'area', { 'area--reverse': i % 2 === 1 }]}
             id={area.id} aria-labelledby={`${area.id}-heading`}>
      <div class="container area__grid">
        <div class="area__text">
          <p class="area__number" aria-hidden="true">{area.number}</p>
          <h2 id={`${area.id}-heading`} class="display display--md area__title">{area.title}</h2>
          <ul class="area__services" role="list">
            {area.services.map((service) => (
              <li class="area__service">
                <h3 class="area__service-name">{service.name}</h3>
                <p class="area__service-desc">{service.description}</p>
              </li>
            ))}
          </ul>
        </div>
        <Frame slot={MEDIA.services.areas[area.id]} ratio="2/3" class="area__media" />
      </div>
    </section>
  ))}

  {/* ================= Sector examples =================
      Short cards, not case studies: no metrics, no client names. */}
  <section class="section section--ruled" id="sectors" aria-labelledby="sectors-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="sectors-heading" class="display display--md">Sector examples</h2>
        <p class="lead">What the work has looked like in practice.</p>
      </div>
      <ul class="sectors" role="list">
        {SECTOR_EXAMPLES.map((example, i) => (
          <li class="sector">
            <Frame slot={MEDIA.services.sectors[i]} ratio="4/5" sizes="(min-width: 64em) 14rem, 70vw" />
            <p class="label sector__name">{example.sector}</p>
            <h3 class="sector__work">{example.work}</h3>
            {example.how && <p class="sector__how">{example.how}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/*
    TODO(client): moved here from About, as it was. Kept for now; to be
    reviewed and cut down after copy review.
  */}
  <section class="section section--ruled" aria-labelledby="programme-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="programme-heading" class="display display--md">How a programme works</h2>
        <p class="lead">Six stages, in this order. Each one depends on the one before it.</p>
      </div>

      <ol class="programme">
        {programme.map((step, i) => (
          <li class="programme__step">
            <span class="programme__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="display display--sm programme__title">{step.title}</h3>
            <p class="programme__body">{step.body}</p>
          </li>
        ))}
      </ol>

      <div class="subsection why">
        <h3 class="display display--md why__heading">Why creator-led beats posting more</h3>

        <div class="prose why__body">
          <p>
            Posting more on your own channel reaches the same people, more often. Everyone who
            sees it already follows you. That has its place — but <strong>it cannot introduce
            you to anyone new</strong>.
          </p>
          <p>
            Creator content arrives through someone else’s audience, with their credibility
            attached. It puts you in front of people who have never heard of you, in a voice
            they already trust.
          </p>
          <p>
            And it only works if the content actually arrives. Most gifted collaborations run
            on a handshake, which is why so many produce nothing. Every AMAVI partnership is
            agreed in writing first — the deliverable, the format and the date — so what we
            promise is what you get. Between April and August 2026, four brands set us a target
            of 40 partnerships. <strong>We delivered 49.</strong>
          </p>
        </div>
      </div>

      <div class="subsection">
        <div class="section-head">
          <h3 class="display display--md">What it looks like on real accounts</h3>
          <p class="lead">
            Four client accounts during their partnership period, by sector. On every one, the
            large majority of accounts reached were not already following the brand.
          </p>
        </div>

        <ReachMeters
          level={4}
          rows={accounts}
          caption="Client account totals over the trailing 90 days, covering the period each partnership ran. These are account-level figures and are not attributable to creator content alone — they are not presented as campaign results. Client names withheld."
        />
      </div>
    </div>
  </section>

  {/*
    Who AMAVI works with, carried over from the retired Work page. Types of
    client and the kind of outcome only: no case studies, no per-client
    detail, no figures. Client types are the cleared roster's sectors; the
    brief's rule that Fettle is never a "therapy platform" is why this stays
    at "healthcare and wellbeing" rather than naming services.

    TODO(client): copy under review. The text below is unchanged; it predates
    the newer partners (a seafood bar among them), so it may need widening.
  */}
  <section class="section section--ruled clients">
    <div class="container">
      <div class="clients__copy">
        <h2 class="display display--md">Who we work with</h2>
        <div class="prose clients__body">
          <p>
            Healthcare and wellbeing providers, home-services networks and direct-to-consumer
            brands across Ireland — businesses where trust decides the sale, and a
            recommendation from the right person does more than another ad.
          </p>
          <p>
            What a creator programme gives them is reach their own channel can’t: people who
            weren’t already following, hearing about the brand from someone they already
            trust — in content that was agreed in writing, so it actually arrives.
          </p>
        </div>
      </div>

      <LogoWall level={3} />
    </div>
  </section>
</Base>

<style>
  /* ---------- Head ---------- */
  .svc-head__grid { display: grid; gap: var(--space-xl); }
  .svc-head__text { display: grid; gap: var(--space-m); align-content: start; }
  .svc-head__lead { max-width: 52ch; }
  .svc-head__lead strong { font-weight: 700; }
  .svc-head :global(.svc-head__media) { width: min(100%, 16rem); }
  @media (min-width: 48em) {
    .svc-head__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-2xl); }
    .svc-head :global(.svc-head__media) { width: min(100%, 22rem); justify-self: end; }
  }

  /* The index: each area a row, a hairline under each, a chevron that steps on hover. */
  .svc-index { list-style: none; margin-top: var(--space-m); border-top: var(--stroke) solid var(--line); }
  .svc-index__link {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s);
    padding-block: var(--space-s);
    border-bottom: var(--stroke) solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .svc-index__number { font-size: var(--text-sm); font-weight: var(--weight-strong); color: var(--accent); }
  .svc-index__title {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .svc-index__link svg { width: 0.7rem; height: 1.4rem; transition: transform var(--dur) var(--ease); }
  .svc-index__link:hover { color: var(--accent); }
  .svc-index__link:hover svg { transform: translateX(0.3rem); }

  /* ---------- Areas: text beside a portrait image, alternating ---------- */
  .area { scroll-margin-top: var(--header-h); }
  .area__grid { display: grid; gap: var(--space-xl); }
  .area :global(.area__media) { width: min(100%, 16rem); }
  @media (min-width: 48em) {
    .area__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
    .area :global(.area__media) { width: min(100%, 22rem); justify-self: end; }
    .area--reverse .area__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .area--reverse :global(.area__media) { order: -1; justify-self: start; }
  }

  .area__text { display: grid; gap: var(--space-m); align-content: start; }
  /* The area's number: the page's one large accent mark. */
  .area__number {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(2.75rem, 1.9rem + 3.4vw, 4.75rem);
    line-height: 0.85;
    color: var(--accent);
  }
  .area__services { list-style: none; margin-top: var(--space-s); border-top: var(--stroke) solid var(--line); }
  .area__service {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-m);
    border-bottom: var(--stroke-hair) solid var(--line);
  }
  @media (min-width: 64em) {
    .area__service { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-l); align-items: baseline; }
  }
  .area__service-name {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .area__service-desc { font-weight: var(--weight-secondary); }

  /* ---------- Sector examples: five short cards ---------- */
  .sectors {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 70%);
    gap: var(--space-m);
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-2xs) var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .sectors::-webkit-scrollbar { display: none; }
  @media (min-width: 40em) { .sectors { grid-auto-columns: minmax(14rem, 40%); } }
  @media (min-width: 64em) {
    .sectors {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }
  .sector { display: grid; gap: var(--space-2xs); align-content: start; scroll-snap-align: start; }
  .sector__name { margin-top: var(--space-s); }
  .sector__work { font-size: var(--text-base); font-weight: 700; line-height: 1.35; }
  .sector__how { font-size: var(--text-sm); font-weight: var(--weight-secondary); line-height: 1.5; }

  /* ---------- Programme: a numbered grid, not a stack of cards ---------- */
  .programme {
    list-style: none;
    display: grid;
    gap: var(--space-l) var(--space-xl);
  }
  @media (min-width: 40em) { .programme { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) { .programme { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .programme__step {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding-top: var(--space-m);
    border-top: var(--stroke) solid var(--line);
  }
  .programme__number {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    font-variant-numeric: tabular-nums;
  }
  .programme__body { font-weight: var(--weight-secondary); max-width: 36ch; }

  /* Each part after the steps opens on a hairline, with a section's worth of
     room above it: they used to be sections of their own. */
  .subsection {
    margin-top: var(--section-y);
    padding-top: var(--space-xl);
    border-top: var(--stroke-hair) solid var(--line);
  }

  /* ---------- Why ---------- */
  .why { display: grid; gap: var(--space-l); }
  @media (min-width: 64em) {
    .why { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-2xl); align-items: start; }
  }
  .why__heading { max-width: 16ch; }
  /* Lead-sized and light; the two claims that matter step up to strong. */
  .why__body { font-size: var(--text-lead); font-weight: var(--weight-secondary); line-height: 1.65; }

  /* ---------- Who we work with ---------- */
  .clients__copy { display: grid; gap: var(--space-m); margin-bottom: var(--space-l); }
  @media (min-width: 64em) {
    .clients__copy { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-xl); align-items: start; }
  }
  .clients__body { font-weight: var(--weight-secondary); }
</style>
