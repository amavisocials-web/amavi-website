---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Lines from '../components/Lines.astro';
import LogoWall from '../components/LogoWall.astro';
import Connect from '../components/Connect.astro';
import { SERVICE_AREAS } from '../data/services';
import { MEDIA } from '../data/media';
import { SITE_NAME, SITE_URL } from '../consts';

/** Why AMAVI, in four points: what a brand gets that it would not get elsewhere. */
const VALUES = [
  {
    name: 'Network advantage',
    body: 'Direct access to 1,000+ vetted creators across Ireland and Europe, categorised by niche, location and audience demographics.',
  },
  {
    name: 'Audience-first vetting',
    body: 'We search on real audience engagement and trust rather than vanity follower counts.',
  },
  {
    name: 'End-to-end ownership',
    body: 'From legal contracts and creator briefing to video editing and performance tracking, we handle everything under one roof.',
  },
  {
    name: 'Commercial accountability',
    body: 'Every campaign is structured around clear KPIs and measured against tangible business outcomes.',
  },
];


/**
 * What AMAVI does: the goal comes first, and the mix — creators, strategy,
 * content, partnerships — is built around it. Creator marketing leads; the
 * other areas make clear it's never the limit. The copy lives in
 * src/data/services.ts.
 *
 * The four areas are an accordion: the list of numbered rows is the page's
 * index, and each row opens in place to its full content. It is built to work
 * without JavaScript — every panel is in the page and open until
 * src/scripts/service-accordions.ts collapses them — and each row keeps its
 * own id, so /services/#creator-marketing still opens that area.
 *
 * Images: one portrait (2:3) for the top of the page, one inside each area's
 * panel, and one (4:5) per sector — all set in src/data/media.ts, where they
 * are marked as temporary fills. A slot left empty there shows "Add image".
 */

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICE_AREAS.map((area, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: area.title,
      description: area.summary,
      areaServed: { '@type': 'Country', name: 'Ireland' },
      provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
    },
  })),
};
---

<Base
  title="Services"
  description="AMAVI starts with your goal, then builds the right mix around it: creator marketing, campaign strategy, content and social, and growth partnerships."
  schema={schema}
>
  {/* ================= Head, then the four areas as an accordion ================= */}
  <section class="section svc-head">
    <div class="container svc-head__grid">
      <div class="svc-head__text">
        <p class="eyebrow">What we do</p>
        <h1 class="display display--lg"><Lines text={'Your goal\ncomes first.'} /></h1>
        <div class="svc-head__lead">
          <p class="lead">
            We don’t believe every brand needs the same marketing mix. We start with{" "}
            <strong>what you want to achieve</strong>, then find the right people, partnerships,
            content and opportunities to get you there.
          </p>
        </div>
      </div>
      <Frame media={MEDIA.services.head} ratio="2/3" class="svc-head__media" />
    </div>

    <div class="container">
      <ol class="areas" role="list" data-accordion>
        {SERVICE_AREAS.map((area) => {
          // `null` is an area that runs without a picture; `undefined` is one
          // still waiting for one, which the frame shows as "Add image".
          const media = MEDIA.services.areas[area.id];
          return (
          <li class="area" id={area.id} data-area data-open="true">
            <h2 class="area__heading">
              <button type="button" class="area__trigger" id={`${area.id}-trigger`}
                      aria-expanded="true" aria-controls={`${area.id}-panel`} data-trigger>
                <span class="area__index" aria-hidden="true">{area.number}</span>
                <span class="area__name">{area.title}</span>
                <svg class="area__chevron" viewBox="0 0 10 20" aria-hidden="true">
                  <path d="M1 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                </svg>
              </button>
            </h2>

            <div class="area__panel" id={`${area.id}-panel`} role="region"
                 aria-labelledby={`${area.id}-trigger`} data-panel>
              <div class="area__inner">
                <div class:list={['area__grid', {
                  'area__grid--wide': media === null,
                  'area__grid--aligned': media?.align === 'body',
                }]}>
                  {/* The row above is the heading; here the number and title
                      are the panel's opening, set large. Head and body are
                      separate so a picture can start level with either. */}
                  <div class="area__head">
                    <p class="area__number" aria-hidden="true">{area.number}</p>
                    <p class="display display--md area__title">{area.title}</p>
                    <p class="area__summary">{area.summary}</p>
                  </div>

                  <div class="area__body">
                    <p class="area__intro">{area.intro}</p>
                    <ul class="area__services" role="list">
                      {area.services.map((service) => (
                        <li class="area__service">
                          <h3 class="row-label">{service.name}</h3>
                          <p class="area__service-desc">{service.description}</p>
                        </li>
                      ))}
                    </ul>
                  </div>

                  {media !== null && <Frame media={media} ratio="2/3" class="area__media" />}
                </div>
              </div>
            </div>
          </li>
          );
        })}
      </ol>
    </div>
  </section>

  {/* ================= Why AMAVI =================
      Four points, in the ruled list the rest of the site uses. */}
  <section class="section section--ruled" id="why-amavi" aria-labelledby="values-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why AMAVI</p>
        <p class="lead">
          We combine creative instinct with end-to-end execution to turn genuine audience trust
          into business growth.
        </p>
      </div>
      <ul class="values" role="list">
        {VALUES.map((value) => (
          <li class="value">
            <h3 class="row-label">{value.name}</h3>
            <p class="value__body">{value.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================= The closing invitation ================= */}
  <Connect />

  {/* ================= Trusted by ================= */}
  <section class="section" aria-label="Clients we work with">
    <LogoWall marquee boost={1.15} eyebrow="Trusted by" />
  </section>
</Base>

<script>
  import '../scripts/service-accordions';
</script>

<style>
  /* ---------- Head ---------- */
  .svc-head__grid { display: grid; gap: var(--space-xl); }
  .svc-head__text { display: grid; gap: var(--space-m); align-content: start; }
  .svc-head__lead { display: grid; gap: var(--space-2xs); max-width: 52ch; }
  .svc-head__lead strong { font-weight: 700; }
  .svc-head :global(.svc-head__media) { width: min(100%, 16rem); }
  @media (min-width: 48em) {
    .svc-head__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); column-gap: var(--space-xl); row-gap: var(--space-2xl); }
    .svc-head :global(.svc-head__media) { width: min(100%, 22rem); justify-self: end; }
  }

  /* ---------- The four areas: an index that opens in place ----------
     Each row keeps the index's old look — number, title, chevron, a hairline
     under each — and the chevron turns down when its panel is open. */
  .areas { list-style: none; margin-top: var(--space-2xl); border-top: var(--stroke) solid var(--line); }
  .area { border-bottom: var(--stroke) solid var(--line); scroll-margin-top: var(--header-h); }

  .area__trigger {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s);
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-s) 0;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .area__index { font-size: var(--text-sm); font-weight: var(--weight-strong); color: var(--accent); }
  .area__name {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .area__chevron { width: 0.7rem; height: 1.4rem; transition: transform var(--dur) var(--ease); }
  .area__trigger:hover { color: var(--accent); }
  .area__trigger:hover .area__chevron { transform: translateX(0.3rem); }
  .area__trigger[aria-expanded='true'] .area__chevron,
  .area__trigger[aria-expanded='true']:hover .area__chevron { transform: rotate(90deg); }

  /* The panel opens on its own height: 0fr to 1fr animates, and the inner
     box clips what doesn't fit yet. Until the script marks the list ready,
     nothing collapses — so a page without JavaScript shows all four. */
  .area__panel { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--dur) var(--ease); }
  .area__inner { min-height: 0; overflow: hidden; }
  [data-accordion='ready'] .area[data-open='false'] .area__panel { grid-template-rows: 0fr; }
  @media (prefers-reduced-motion: reduce) {
    .area__panel { transition: none; }
  }

  /* ---------- Inside a panel: text beside a portrait image ---------- */
  /* The panel ends on its last row, so the tail below it is short. */
  .area__grid { display: grid; gap: var(--space-m); padding-bottom: var(--space-l); }
  .area__grid--wide { padding-bottom: var(--space-m); }
  .area :global(.area__media) { width: min(100%, 16rem); margin-top: var(--space-l); }

  @media (min-width: 48em) {
    .area__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-xl);
      align-items: start;
    }
    .area__head { grid-column: 1; grid-row: 1; }
    .area__body { grid-column: 1; grid-row: 2; }
    .area :global(.area__media) {
      grid-column: 2;
      grid-row: 1 / -1;
      width: min(100%, 22rem);
      justify-self: end;
      margin-top: 0;
    }
    /* Level with the paragraph instead, leaving the number and title clear. */
    .area__grid--aligned :global(.area__media) { grid-row: 2; }
    /* An area with no picture: one column across the panel, and less of a
       tail below it now that nothing has to match an image's height. The
       intro keeps its measure, so the lines stay readable at full width. */
    .area__grid--wide { grid-template-columns: minmax(0, 1fr); }
  }

  .area__head,
  .area__body { display: grid; gap: var(--space-m); align-content: start; }
  /* The area's number: the page's one large accent mark. */
  .area__number {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(2.1875rem, 1.5rem + 2.69vw, 3.75rem);
    line-height: 0.85;
    color: var(--accent);
  }
  /* One line on what the area is, before the case for it. */
  .area__summary { font-style: italic; font-weight: var(--weight-secondary); max-width: var(--measure); }
  .area__intro { font-weight: var(--weight-secondary); max-width: var(--measure); }

  /* ---------- What an area covers: names and lines, held apart by space ----
     No rules in here: the space between the rows is what separates them, so
     an open panel reads as a set of blocks rather than a table. The rules
     between 01–05 in the index are a different thing and stay. */
  .area__services {
    list-style: none;
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }
  .area__service { display: grid; gap: var(--space-3xs); }
  /* The label moves beside its line only at 80em: beside a picture, the text
     column at 64em leaves the description about 34 characters wide, which is
     a column too narrow to read comfortably. */
  @media (min-width: 64em) { .area__services { gap: var(--space-xl); } }
  @media (min-width: 80em) {
    .area__service { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: var(--space-m); align-items: baseline; }
  }
  .area__service-desc { font-weight: var(--weight-secondary); }

  /* ---------- Why AMAVI: four points, two by two ----------
     Rules between the rows and nowhere else. The columns carry their own
     padding rather than a grid gap, so a rule runs the full width of the
     list instead of breaking in the middle of it. */
  .values { list-style: none; display: grid; }
  .value { display: grid; gap: var(--space-2xs); align-content: start; padding-block: var(--space-m); }
  .value:first-child { padding-top: 0; }
  @media (min-width: 48em) {
    .values { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .value:nth-child(2n+1) { padding-right: var(--space-l); }
    .value:nth-child(2n) { padding-left: var(--space-l); }
    .value:nth-child(-n+2) { padding-top: 0; }
  }

  .value__body { font-weight: var(--weight-secondary); }

</style>
