---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Lines from '../components/Lines.astro';
import { SERVICE_AREAS, SECTORS } from '../data/services';
import { MEDIA } from '../data/media';
import { SITE_NAME, SITE_URL } from '../consts';

/**
 * What AMAVI does: the goal comes first, and the mix — creators, strategy,
 * content, partnerships — is built around it. Creator marketing leads; the
 * other areas make clear it's never the limit. The copy lives in
 * src/data/services.ts.
 *
 * The four areas are an accordion: the list of numbered rows is the page's
 * index, and each row opens in place to its full content. It is built to work
 * without JavaScript — every panel is in the page and open until
 * src/scripts/service-accordions.ts collapses them — and each row keeps its
 * own id, so /services/#creator-marketing still opens that area.
 *
 * Images: one portrait (2:3) for the top of the page, one inside each area's
 * panel, and one (4:5) per sector — all set in src/data/media.ts, where they
 * are marked as temporary fills. A slot left empty there shows "Add image".
 */

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICE_AREAS.flatMap((area) => area.services.map((service) => ({ area, service }))).map(
    ({ area, service }, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: service.name,
        description: service.description,
        category: area.title,
        areaServed: { '@type': 'Country', name: 'Ireland' },
        provider: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      },
    }),
  ),
};
---

<Base
  title="Services"
  description="AMAVI starts with your goal, then builds the right mix around it: creator marketing, campaign strategy, content and social, and growth partnerships."
  schema={schema}
>
  {/* ================= Head, then the four areas as an accordion ================= */}
  <section class="section svc-head">
    <div class="container svc-head__grid">
      <div class="svc-head__text">
        <p class="eyebrow">What we do</p>
        <h1 class="display display--lg"><Lines text={'Your goal\ncomes first.'} /></h1>
        <div class="svc-head__lead">
          <p class="lead">
            We don’t believe every brand needs the same marketing mix. We start with{" "}
            <strong>what you want to achieve</strong>, then find the right people, partnerships,
            content and opportunities to get you there.
          </p>
        </div>
        <p class="label">Creators&nbsp;· Campaigns&nbsp;· Content&nbsp;· Partnerships</p>
      </div>
      <Frame media={MEDIA.services.head} ratio="2/3" class="svc-head__media" />
    </div>

    <div class="container">
      <ol class="areas" role="list" data-accordion>
        {SERVICE_AREAS.map((area) => (
          <li class="area" id={area.id} data-area data-open="true">
            <h2 class="area__heading">
              <button type="button" class="area__trigger" id={`${area.id}-trigger`}
                      aria-expanded="true" aria-controls={`${area.id}-panel`} data-trigger>
                <span class="area__index" aria-hidden="true">{area.number}</span>
                <span class="area__name">{area.title}</span>
                <svg class="area__chevron" viewBox="0 0 10 20" aria-hidden="true">
                  <path d="M1 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.25" vector-effect="non-scaling-stroke" />
                </svg>
              </button>
            </h2>

            <div class="area__panel" id={`${area.id}-panel`} role="region"
                 aria-labelledby={`${area.id}-trigger`} data-panel>
              <div class="area__inner">
                <div class="area__grid">
                  <div class="area__text">
                    {/* The row above is the heading; here the number and title
                        are the panel's opening, set large. */}
                    <p class="area__number" aria-hidden="true">{area.number}</p>
                    <p class="display display--md area__title">{area.title}</p>
                    <p class="area__summary">{area.summary}</p>
                    <div class="area__intro">
                      {area.intro.map((line) => <p class="lead">{line}</p>)}
                    </div>
                    <ul class="area__services" role="list">
                      {area.services.map((service) => (
                        <li class="area__service">
                          <h3 class="area__service-name">{service.name}</h3>
                          <p class="area__service-desc">{service.description}</p>
                        </li>
                      ))}
                    </ul>
                    <p class="eyebrow">{area.closing}</p>
                  </div>
                  <Frame media={MEDIA.services.areas[area.id]} ratio="2/3" class="area__media" />
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ================= Sectors =================
      A sector and the kind of work there — no metrics, no client names. */}
  <section class="section section--ruled" id="sectors" aria-labelledby="sectors-heading">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Where we work</p>
        <h2 id="sectors-heading" class="display display--md"><Lines text={'Different industries.\nSame approach.'} /></h2>
        <p class="lead">
          We adapt the strategy to the audience, the objective and the opportunity — not the other
          way around.
        </p>
      </div>
      <ul class="sectors" role="list">
        {SECTORS.map((sector) => (
          <li class="sector">
            <Frame media={MEDIA.services.sectors[sector.name]} ratio="4/5" sizes="(min-width: 64em) 12rem, 70vw" />
            <h3 class="label sector__name">{sector.name}</h3>
            <p class="sector__work">{sector.focus.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ================= Why creator-led ================= */}
  <section class="section section--ruled why" aria-labelledby="why-heading">
    <div class="container why__grid">
      <div class="why__head">
        <p class="eyebrow">Why creator-led</p>
        <h2 id="why-heading" class="display display--md why__heading"><Lines text={'People create\nthe connection.'} /></h2>
      </div>

      <div class="prose why__body">
        <p>Brands don’t build relationships with algorithms. People do.</p>
        <p>
          Creators bring context, personality and trust to the brands they work with — helping
          businesses enter conversations that traditional advertising can’t always create.
        </p>
        <p><strong>But creators are only one part of the picture.</strong></p>
        <p>
          We combine creator marketing with content, strategy and partnerships to build campaigns
          around <strong>the audience — not just the platform</strong>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import '../scripts/service-accordions';
</script>

<style>
  /* ---------- Head ---------- */
  .svc-head__grid { display: grid; gap: var(--space-xl); }
  .svc-head__text { display: grid; gap: var(--space-m); align-content: start; }
  .svc-head__lead { display: grid; gap: var(--space-2xs); max-width: 52ch; }
  .svc-head__lead strong { font-weight: 700; }
  .svc-head :global(.svc-head__media) { width: min(100%, 16rem); }
  @media (min-width: 48em) {
    .svc-head__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-2xl); }
    .svc-head :global(.svc-head__media) { width: min(100%, 22rem); justify-self: end; }
  }

  /* ---------- The four areas: an index that opens in place ----------
     Each row keeps the index's old look — number, title, chevron, a hairline
     under each — and the chevron turns down when its panel is open. */
  .areas { list-style: none; margin-top: var(--space-2xl); border-top: var(--stroke) solid var(--line); }
  .area { border-bottom: var(--stroke) solid var(--line); scroll-margin-top: var(--header-h); }

  .area__trigger {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s);
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-s) 0;
    text-align: left;
    color: var(--ink);
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .area__index { font-size: var(--text-sm); font-weight: var(--weight-strong); color: var(--accent); }
  .area__name {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .area__chevron { width: 0.7rem; height: 1.4rem; transition: transform var(--dur) var(--ease); }
  .area__trigger:hover { color: var(--accent); }
  .area__trigger:hover .area__chevron { transform: translateX(0.3rem); }
  .area__trigger[aria-expanded='true'] .area__chevron,
  .area__trigger[aria-expanded='true']:hover .area__chevron { transform: rotate(90deg); }

  /* The panel opens on its own height: 0fr to 1fr animates, and the inner
     box clips what doesn't fit yet. Until the script marks the list ready,
     nothing collapses — so a page without JavaScript shows all four. */
  .area__panel { display: grid; grid-template-rows: 1fr; transition: grid-template-rows var(--dur) var(--ease); }
  .area__inner { min-height: 0; overflow: hidden; }
  [data-accordion='ready'] .area[data-open='false'] .area__panel { grid-template-rows: 0fr; }
  @media (prefers-reduced-motion: reduce) {
    .area__panel { transition: none; }
  }

  /* ---------- Inside a panel: text beside a portrait image ---------- */
  .area__grid { display: grid; gap: var(--space-xl); padding-bottom: var(--space-xl); }
  .area :global(.area__media) { width: min(100%, 16rem); }
  @media (min-width: 48em) {
    .area__grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: start; }
    .area :global(.area__media) { width: min(100%, 22rem); justify-self: end; }
  }

  .area__text { display: grid; gap: var(--space-m); align-content: start; }
  /* The area's number: the page's one large accent mark. */
  .area__number {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(2.1875rem, 1.5rem + 2.69vw, 3.75rem);
    line-height: 0.85;
    color: var(--accent);
  }
  /* One line on what the area is, before the case for it. */
  .area__summary { font-style: italic; font-weight: var(--weight-secondary); max-width: var(--measure); }
  .area__intro { display: grid; gap: var(--space-2xs); }
  .area__services { list-style: none; margin-top: var(--space-s); border-top: var(--stroke) solid var(--line); }
  .area__service {
    display: grid;
    gap: var(--space-3xs);
    padding-block: var(--space-m);
    border-bottom: var(--stroke-hair) solid var(--line);
  }
  @media (min-width: 64em) {
    .area__service { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-l); align-items: baseline; }
  }
  .area__service-name {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .area__service-desc { font-weight: var(--weight-secondary); }

  /* ---------- Sectors: six short cards ---------- */
  .sectors {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(14rem, 70%);
    gap: var(--space-m);
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-2xs) var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .sectors::-webkit-scrollbar { display: none; }
  @media (min-width: 40em) { .sectors { grid-auto-columns: minmax(14rem, 40%); } }
  @media (min-width: 64em) {
    .sectors {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }
  .sector { display: grid; gap: var(--space-2xs); align-content: start; scroll-snap-align: start; }
  .sector__name { margin-top: var(--space-s); }
  .sector__work { font-size: var(--text-base); font-weight: 700; line-height: 1.35; }

  /* ---------- Why creator-led ---------- */
  .why__grid { display: grid; gap: var(--space-l); }
  @media (min-width: 64em) {
    .why__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-2xl); align-items: start; }
  }
  .why__head { display: grid; gap: var(--space-m); align-content: start; }
  .why__heading { max-width: 16ch; }
  /* Lead-sized and light; the two claims that matter step up to strong. */
  .why__body { font-size: var(--text-lead); font-weight: var(--weight-secondary); line-height: 1.65; }
</style>
