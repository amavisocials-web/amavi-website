---
/**
 * Stands in for a missing image or video: a frame at the exact aspect ratio
 * the real media will take, with a thin black border and "Add image" or
 * "Add video" in the middle. Swapping in the real file changes nothing else on
 * the page. Stock imagery is never used in its place.
 *
 * Hidden from assistive tech: it carries no information, and the real media
 * that replaces it gets its own description.
 */
interface Props {
  kind?: 'image' | 'video';
  /** CSS aspect ratio, e.g. '2/3' or '16/9'. Omit when the parent sizes it. */
  ratio?: string;
  /** A second, smaller line, e.g. which cut of a video goes here. */
  note?: string;
  class?: string;
}
const { kind = 'image', ratio, note, class: className } = Astro.props;
---

<div class:list={['ph', className]} style={ratio ? `aspect-ratio:${ratio}` : undefined} aria-hidden="true">
  <span class="ph__text">{kind === 'video' ? 'Add video' : 'Add image'}</span>
  {note && <span class="ph__note">{note}</span>}
</div>

<style>
  .ph {
    width: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.35rem;
    padding: var(--space-s);
    text-align: center;
    color: var(--ink);
    background: var(--bg);
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-frame);
  }
  .ph__text { font-size: var(--text-sm); font-weight: var(--weight-strong); }
  .ph__note { font-size: var(--text-xs); font-weight: var(--weight-secondary); }
</style>
