---
/**
 * Stand-in for photography.
 *
 * TODO(client): no approved imagery supplied, and the template preview photos
 * are not licensed for use. These are black-outlined fields sized to the
 * aspect ratio the real photograph will occupy, so swapping one in is a file
 * replacement — `<Image />` from `astro:assets` with the same ratio — and
 * shifts nothing on the page.
 *
 * These carry no information: every placeholder sits beside text that already
 * says what it stands for, so they are hidden from assistive tech rather than
 * announced as "placeholder image" on top of the heading next to them. The
 * real photographs that replace them DO need descriptive alt text.
 */
interface Props {
  ratio?: '4/5' | '3/4' | '1/1' | '16/9' | '3/2';
  /** Short word set into the field. Omit for a plain outline. */
  caption?: string;
  class?: string;
}
const { ratio = '4/5', caption, class: className } = Astro.props;
---

<div class:list={['ph', className]} style={`--ratio:${ratio}`} aria-hidden="true">
  {caption && <span class="ph__caption">{caption}</span>}
  <slot />
</div>

<style>
  .ph {
    aspect-ratio: var(--ratio);
    width: 100%;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-media);
  }

  .ph > :global(*) { position: relative; }

  .ph__caption {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 0.9rem + 1.6vw, 2rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-align: center;
    padding-inline: var(--space-l);
    max-width: 18ch;
  }
</style>
