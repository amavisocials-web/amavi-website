---
import LoopVideo from './LoopVideo.astro';
import type { ContentTile } from '../data/tiles';
import { CONTACT_EMAIL } from '../consts';

/**
 * The figures, beside a collage of creator content.
 *
 * Two columns from 64em up — the collage on the left, the text on the right —
 * and stacked below that with the pictures first (2 November 2026; the figures
 * led until then). The collage comes first in the markup too, so a screen
 * reader and the tab key follow the same order as the eye; from 64em each is
 * placed in its column by name, so that layout does not depend on source
 * order.
 *
 * **From 64em the collage stands still** (2 November 2026): four tiles of one
 * shape, 3:4, cropped by object-fit, in two columns that end level, the row
 * taking its height from them. It was a slow vertical loop until then, through
 * a 544px window, with tiles of two shapes, so a tile was always being cut by
 * the window's edge. Nothing can drift through a window without being cut, and
 * five tiles of one shape cannot make two level columns, so the loop went and
 * the fifth clip is left to the phone row. Two columns make each tile 281px at
 * 1280: the container caps at about 578px and does not widen past that.
 *
 * **Below 64em there are no columns at all.** The tiles become one row
 * drifting sideways, about 60% of the screen each so part of the next one
 * always shows, which can be dragged, and which plays two of its videos at a
 * time (src/scripts/collage-marquee.ts). Under prefers-reduced-motion nothing
 * moves anywhere and no video ever loads: the posters are all there is
 * (src/scripts/loop-videos.ts).
 *
 * **Only the first run of the row is videos** (2 November 2026). It repeats
 * its tiles once so the join cannot be seen, and each copy used to be a video
 * of its own, decoding beside the one it repeats. The repeat is now the tile's
 * poster as an image, in an identical frame. All of these videos count towards
 * the page's four live ones (src/scripts/lib/playback.ts), and on a weak device
 * (`optional`) they keep their posters too.
 *
 * Everything in the text column comes from the page, through the default
 * slot: this file owns the split and the collage, not the words.
 */
interface Props {
  /** Every tile there is. The deal below spreads them across the columns. */
  tiles: ContentTile[];
  labelledby?: string;
}
const { tiles, labelledby } = Astro.props;

/**
 * Which tile goes where, by index into `tiles`. Written out rather than
 * computed so the rule can be read off the page.
 *
 * The grid from 64em, read across: two columns of two, the newest clips leading
 * both. Five more clips would let it grow without leaving any out; see the TODO
 * in src/data/tiles.ts.
 */
const GRID = [0, 1, 3, 4];

/**
 * The marquee below 64em, every clip once.
 *
 * The row is built separately rather than squeezed out of the grid above:
 * different tiles, a different shape, and a repeat for the loop. Two
 * purpose-built structures are plainer than one contorted into serving both.
 *
 * Neither costs the other anything: whichever is `display: none` at a given
 * width never intersects, so its videos never load (src/scripts/loop-videos.ts).
 */
const RUN = [0, 3, 2, 1, 4];
const run = RUN.map((index) => tiles[index % tiles.length]);

/**
 * A tile's link, if it has a post: a new tab, named for what the post shows.
 * The copies made for the loop are already aria-hidden; their links also leave
 * the tab order, so each post is reached once from the keyboard. Not
 * draggable, or a mouse drag along the row would pick the link up instead.
 */
const linkTo = (tile: ContentTile, copy: number) =>
  tile.href
    ? {
        href: tile.href,
        target: '_blank',
        rel: 'noopener noreferrer',
        draggable: 'false',
        'aria-label': `View this post on Instagram: ${tile.alt} (opens in a new tab)`,
        ...(copy > 0 ? { tabindex: '-1' } : {}),
      }
    : {};
---

<section class="section numbers" aria-labelledby={labelledby}>
  <div class="container media-row numbers__grid">
    {/* Decorative: the figures beside it are what the section says. */}

    {/* Below 64em: one row drifting right to left, for ever. The clips are
        laid out twice and the track travels exactly one run's width, so the
        join cannot be seen. Everything that moves it is a transform. */}
    <div class="collage-row" data-marquee>
      <div class="collage-row__drag" data-marquee-drag>
        <div class="collage-row__track" data-marquee-track>
          {[0, 1].map((copy) => (
            <div class="collage-row__run" aria-hidden={copy > 0 ? 'true' : undefined}>
              {run.map((tile) => {
                const Tile = tile.href ? 'a' : 'div';
                return (
                  <Tile class="collage-row__tile" {...linkTo(tile, copy)}>
                    {/* Played by src/scripts/collage-marquee.ts, two at most;
                        the repeat is the poster alone. */}
                    <LoopVideo src={tile.src} poster={tile.poster} ratio="9/16"
                               still={copy > 0} optional managed autoplay preload="metadata"
                               class="collage-row__media" />
                  </Tile>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* From 64em: four tiles, standing still. Read across, so the tab key goes
        the way the eye does. */}
    <div class="collage">
      {GRID.map((index) => {
        const tile = tiles[index % tiles.length];
        const Tile = tile.href ? 'a' : 'div';
        return (
          <Tile class="collage__tile" {...linkTo(tile, 0)}>
            <LoopVideo src={tile.src} poster={tile.poster} ratio="3/4"
                       optional autoplay preload="metadata"
                       loopFrom="(min-width: 64em)" class="collage__media" />
          </Tile>
        );
      })}
    </div>

    <div class="numbers__text">
      <slot />

      {/* Whose work this is. A note on the collage, not a credit on each tile:
          the handles are not cleared yet (TODO in src/data/tiles.ts), and a
          caption under every tile would fight the loop. Last in the column,
          under the link, since 28 October 2026; it sat under the collage
          before. */}
      <p class="collage__note">
        Content created by the creators we work with and shared with permission.
        All rights remain with the original creators. To request removal, email{' '}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </div>
</section>

<script>
  import '../scripts/collage-marquee';
</script>

<style>
  /* One value for the row's tiles and the links over them. */
  .numbers { --tile-radius: 1.5rem; }
  /* display, gap and the centring come from .media-row in global.css. Stacked,
     the text and the collage want less air between them than the shared
     --space-xl: 40px keeps the pictures with the figures they sit beside. */
  .numbers__grid { row-gap: var(--space-l); }

  @media (min-width: 64em) {
    .numbers__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
      row-gap: 0;
    }
    /* Placed rather than left to source order: the collage and the text share
       row 1, and each centres against the other. The collage is first in the
       markup, so a phone shows the pictures before the figures. */
    .collage { grid-column: 1; grid-row: 1; }
    .numbers__text { grid-column: 2; grid-row: 1; }
  }
  @media (min-width: 80em) {
    .numbers__grid { grid-template-columns: minmax(0, 55fr) minmax(0, 45fr); }
  }

  .numbers__text { display: grid; gap: var(--space-m); align-content: start; }

  /* A footnote, not body copy: --text-xs, a step under the 13px it was set
     in until 28 October 2026 and two under the 14px body, in the same grey.
     0.7 and not lower: 0.6 of #222021 misses AA. The regular weight rather
     than the light one, which thins out at 11px. 40px clear of the link
     above: the column's 24px gap and 16px more. */
  .collage__note {
    margin-top: var(--space-s);
    font-size: var(--text-xs);
    line-height: 1.6;
    max-width: 56ch;
    opacity: 0.7;
    text-wrap: pretty;
  }
  .collage__note a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }
  .collage__note a:hover { color: var(--accent); }

  /* ---- The collage: a marquee below 64em --------------------------------- */
  /* One row drifting right to left, for ever. The clips are laid out twice and
     the track travels exactly one run's width, so the two meet without a seam.

     `overflow: hidden` and not a scroll container: the drift is a transform,
     and a transform animating inside a scrollport changes the scrollable area
     as it goes, which makes the scrollbar and the scroll range twitch. Hidden
     also means this can never put a sideways scroll on the page. Swiping is
     handled instead by src/scripts/collage-marquee.ts, which is also what
     pauses it on touch and off screen.

     The negative margin reaches the edges of the screen; `--space-s` of
     padding keeps the first tile off the edge. */
  .collage-row {
    overflow: hidden;
    margin-inline: calc(var(--gutter) * -1);
    padding-block: var(--space-2xs);
    /* The row absorbs the drag, so the browser must not also treat it as a
       page gesture or a back swipe. */
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  @media (min-width: 64em) {
    .collage-row { display: none; }
  }

  /* Two elements, because one cannot carry both the animated transform and the
     drag offset the script sets. */
  .collage-row__drag { will-change: transform; }

  /* **No padding on the track.** It is what -50% is measured against, so any
     padding here makes half of it wider than one run and the loop jumps by
     exactly that much — 16px, when this carried `padding-inline: var(--space-s)`.
     A leading inset means nothing on a row that is always mid-drift anyway; it
     is added back under reduced motion below, where the row stands still and
     the first tile would otherwise sit against the edge of the screen. */
  .collage-row__track {
    display: flex;
    width: max-content;
    /* Slow: this is ambience, not a carousel. 52s for a full cycle. */
    animation: collage-drift 52s linear infinite;
    /* Its own GPU layer in every browser, Safari included. Not translate3d
       in the keyframes: the minifier rewrites that as translate(). */
    will-change: transform;
  }
  .collage-row__run { display: flex; gap: var(--space-s); padding-right: var(--space-s); }

  /* 58% of the screen, so part of the next tile always shows — capped so it is
     not three vast tiles on a tablet. */
  .collage-row__tile {
    flex: none;
    width: min(58vw, 15rem);
    border-radius: var(--tile-radius);
    overflow: hidden;
  }
  .collage-row :global(.collage-row__media) {
    width: 100%;
    max-width: 100%;
    border-radius: inherit;
    /* Capped, so the pictures never tower over the figures above them. */
    max-height: 60vh;
  }

  /* Exactly one run. The track is two, so half of it is one. */
  @keyframes collage-drift {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Nothing moves. The row becomes an ordinary scroll container instead, so it
     is still a row the reader can swipe through by hand. */
  @media (prefers-reduced-motion: reduce) {
    .collage-row {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      touch-action: auto;
    }
    .collage-row::-webkit-scrollbar { display: none; }
    .collage-row__track { animation: none; padding-inline: var(--space-s); }
    /* One run is enough when it is not looping, and the duplicate is the
       aria-hidden one. */
    .collage-row__run + .collage-row__run { display: none; }
  }

  /* ---- The collage: a still grid from 64em ------------------------------ */
  /* Hidden below 64em, where the marquee above is what runs. Nothing in here
     intersects at those widths, so none of its videos load. No height of its
     own and nothing clipped: two rows of 3:4 tiles set the height, so both
     columns end level with the same gap throughout. */
  .collage { display: none; }

  @media (min-width: 64em) {
    .collage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-s);
    }
  }

  /* --- Tiles that link to their post ---------------------------------------
     The anchor is the tile itself, inside the moving set, so the link travels
     with it. The ring is drawn inside the tile: the row and the columns clip
     at their edges and would cut one drawn outside. White within the accent,
     so it reads on light frames and dark ones. */
  a.collage-row__tile,
  a.collage__tile {
    display: block;
    position: relative;
    border-radius: var(--tile-radius);
    color: inherit;
    cursor: pointer;
    -webkit-user-drag: none;
    transition: opacity 200ms ease-out;
  }
  @media (hover: hover) {
    a.collage-row__tile:hover,
    a.collage__tile:hover { opacity: 0.85; }
  }
  a.collage-row__tile:focus-visible,
  a.collage__tile:focus-visible {
    outline: var(--stroke-mark) solid var(--accent);
    outline-offset: calc(var(--stroke-mark) * -1);
  }
  a.collage-row__tile:focus-visible::after,
  a.collage__tile:focus-visible::after {
    content: '';
    position: absolute;
    inset: var(--stroke-mark);
    border-radius: inherit;
    box-shadow: inset 0 0 0 2px var(--on-dark);
    pointer-events: none;
  }
  /* The dimming still marks a link, but without the fade. */
  @media (prefers-reduced-motion: reduce) {
    a.collage-row__tile,
    a.collage__tile { transition: none; }
  }

  /* Keyboard focus on a tile parks the loop at its start, so the layout and
     what is on screen agree again and the script can scroll the focused tile
     into view (src/scripts/collage-marquee.ts). Paused mid-loop instead, a
     tile can be focused while sitting outside the row. Keyboard only: a mouse
     click leaves the loop where it is. */
  .collage-row:has(a:focus-visible) .collage-row__track { animation: none; }
</style>
