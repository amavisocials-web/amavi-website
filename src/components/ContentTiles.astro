---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A row of creator content — reels and stills — with a single summary and
 * call to action beneath the row rather than a caption under each tile.
 *
 * TODO(client): no content supplied yet. Give a tile a `video` (path under
 * /public) or an `image` (an import from src/assets) plus `alt`, and its
 * placeholder is replaced. Tiles are 9:16, the native reel ratio, so a reel
 * drops in uncropped. Before publishing any creator's content, get sign-off
 * from the creator and the client (brief §5).
 */
export interface Tile {
  kind: 'reel' | 'image';
  video?: string;
  image?: ImageMetadata;
  alt?: string;
}

interface Props {
  tiles: Tile[];
  /** Names the scrolling row for screen readers once it holds real media. */
  label?: string;
}
const { tiles, label = 'Creator content' } = Astro.props;

// Placeholders carry no information, so while every tile is one the whole row
// is decoration: hidden from assistive tech, and not a keyboard stop.
const decorative = tiles.every((t) => !t.video && !t.image);
---

<div class="tiles-block">
  <div
    class="tiles-scroller"
    aria-hidden={decorative ? 'true' : undefined}
    role={decorative ? undefined : 'region'}
    aria-label={decorative ? undefined : label}
    tabindex={decorative ? undefined : 0}
  >
    <ul class="tiles" role="list">
      {tiles.map((tile) => (
        <li class:list={['tile', { 'has-media': tile.video || tile.image }]}>
          {tile.video ? (
            <video class="tile__media" src={tile.video} muted loop playsinline
                   preload="metadata" aria-label={tile.alt}></video>
          ) : tile.image ? (
            <Image class="tile__media" src={tile.image} alt={tile.alt ?? ''} width={480} loading="lazy" />
          ) : (
            tile.kind === 'reel' && (
              <svg class="tile__play" viewBox="0 0 48 48" aria-hidden="true">
                <circle cx="24" cy="24" r="23.5" fill="none" stroke="currentColor" stroke-width="1"
                        vector-effect="non-scaling-stroke" />
                <path d="M20 16.5v15l12-7.5z" fill="currentColor" />
              </svg>
            )
          )}
        </li>
      ))}
    </ul>
  </div>

  <div class="tiles-summary">
    <slot />
  </div>
</div>

<style>
  .tiles-block { display: grid; gap: var(--space-xl); }

  /* Desktop: the full row. Mobile: a swipeable strip that bleeds to the
     viewport edge, the way a feed does — no carousel script needed. */
  .tiles-scroller {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .tiles-scroller::-webkit-scrollbar { display: none; }
  .tiles-scroller:focus-visible { outline-offset: -2px; }

  .tiles {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(12rem, 58%);
    gap: var(--space-s);
  }

  @media (min-width: 40em) {
    .tiles { grid-auto-columns: minmax(12rem, 36%); }
  }

  @media (min-width: 64em) {
    .tiles-scroller { margin-inline: 0; padding-inline: 0; overflow: visible; }
    .tiles { grid-auto-flow: row; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }

  /* An empty tile is a black outline on white; a reel carries a play mark. */
  .tile {
    aspect-ratio: 9 / 16;
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-media);
    overflow: hidden;
    scroll-snap-align: start;
    display: grid;
    place-items: center;
    color: var(--ink);
  }
  /* Real media fills its tile edge to edge; the outline was only a stand-in. */
  .tile.has-media { border: 0; }

  /* A stagger across the row. Desktop only: on the swipe strip it would just
     look misaligned. */
  @media (min-width: 64em) {
    .tile:nth-child(even) { transform: translateY(var(--space-l)); }
  }

  .tile__media { width: 100%; height: 100%; object-fit: cover; }
  .tile__play { width: 2.75rem; height: 2.75rem; }

  .tiles-summary {
    display: grid;
    gap: var(--space-m);
    justify-items: center;
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }
  @media (min-width: 64em) {
    /* Clear the staggered tiles above. */
    .tiles-summary { margin-top: var(--space-l); }
  }
</style>
