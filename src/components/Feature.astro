---
/**
 * One text column and one portrait piece of media: side by side from 64em,
 * the text on the left, or with `reverse` the media on the left; stacked
 * below that, with the media on top.
 *
 * The media comes first in the markup as well as on a phone (2 November
 * 2026), so a screen reader and the tab key follow the same order as the eye.
 * No `order` anywhere: from 64em the columns are placed by name, so the wide
 * layout does not depend on source order, and below that the grid is one
 * column and source order is all there is.
 *
 * Slots: the default slot is the text (heading, body, a ProofLink); `media`
 * is a LoopVideo or a Frame.
 */
interface Props {
  reverse?: boolean;
  /** A hairline and a section's space above: for anything but the first. */
  ruled?: boolean;
  labelledby?: string;
}
const { reverse = false, ruled = false, labelledby } = Astro.props;
---

<section class:list={['section', 'feature', { 'section--ruled': ruled, 'feature--reverse': reverse }]}
         aria-labelledby={labelledby}>
  <div class="container media-row feature__grid">
    <div class="feature__media"><slot name="media" /></div>
    <div class="feature__text"><slot /></div>
  </div>
</section>

<style>
  /* display, gap and the centring come from .media-row in global.css. Stacked,
     the same gap as the collage above its figures (Numbers.astro): the picture
     belongs to the words under it. */
  .feature__grid { row-gap: var(--space-l); }

  /* One track exactly the column's width: a heading let out wider than the
     column (the case study's, from 75em) runs past it instead of widening the
     track, which would stretch the paragraphs with it. */
  .feature__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    align-content: start;
    max-width: 38rem;
  }
  .feature__media { width: min(100%, 16rem); }

  @media (min-width: 48em) {
    .feature__media { width: min(100%, 22rem); }
  }

  @media (min-width: 64em) {
    .feature__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      grid-template-areas: 'text media';
      column-gap: var(--space-xl);
      row-gap: var(--space-2xl);
    }
    .feature__text { grid-area: text; }
    .feature__media { grid-area: media; justify-self: end; }
    .feature--reverse .feature__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      grid-template-areas: 'media text';
    }
    .feature--reverse .feature__media { justify-self: start; }
    /* The reversed block closes on its proof line, low on the right. */
    .feature--reverse .feature__text { align-self: end; }
  }

  /* Body copy with its key phrases in bold. */
  .feature__text :global(.feature__body) { font-size: var(--text-lead); font-weight: var(--weight-secondary); line-height: 1.65; }
  .feature__text :global(.feature__body strong) { font-weight: 700; }
  .feature__text :global(.proof-link) { justify-self: start; margin-top: var(--space-s); }
</style>
