---
/**
 * One text column and one portrait piece of media, side by side on a wide
 * screen — the text first, or with `reverse` the media first — stacked on a
 * phone, text on top. The home page alternates them.
 *
 * Slots: the default slot is the text (heading, body, a ProofLink); `media`
 * is a LoopVideo or a Placeholder.
 */
interface Props {
  reverse?: boolean;
  /** A hairline and a section's space above: for anything but the first. */
  ruled?: boolean;
  /** Below 48em the text alone, full width: the media is display: none there.
      Give an image inside it the Frame's `skipWhen` too, so it is not fetched. */
  textOnlyOnPhone?: boolean;
  labelledby?: string;
}
const { reverse = false, ruled = false, textOnlyOnPhone = false, labelledby } = Astro.props;
---

<section class:list={['section', 'feature', { 'section--ruled': ruled, 'feature--reverse': reverse, 'feature--text-only': textOnlyOnPhone }]}
         aria-labelledby={labelledby}>
  <div class="container media-row feature__grid">
    <div class="feature__text"><slot /></div>
    <div class="feature__media"><slot name="media" /></div>
  </div>
</section>

<style>
  /* display, gap and the centring come from .media-row in global.css. One
     track exactly the column's width: a heading let out wider than the column
     (the case study's, from 75em) runs past it instead of widening the track,
     which would stretch the paragraphs with it. */
  .feature__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    align-content: start;
    max-width: 38rem;
  }
  .feature__media { width: min(100%, 16rem); }

  @media (min-width: 48em) {
    .feature__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);

      column-gap: var(--space-xl);
      row-gap: var(--space-2xl);
    }
    .feature__media { width: min(100%, 22rem); justify-self: end; }
    .feature--reverse .feature__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }
    .feature--reverse .feature__media { order: -1; justify-self: start; }
    /* The reversed block closes on its proof line, low on the right. */
    .feature--reverse .feature__text { align-self: end; }
  }

  /* textOnlyOnPhone: the media only from 48em. display: none rather than
     hidden or transparent, so below that it holds no space and a lazy image
     inside it is never requested; the grid is left with one item, so no gap
     stays where the media was. Hidden first and shown from 48em, not the
     other way round: the build writes these queries in range syntax, which
     iOS before 16.4 cannot read, and a browser that skips the query should
     land on no media at all rather than on a box the Frame has blanked. */
  .feature--text-only .feature__media { display: none; }
  @media (min-width: 48em) {
    .feature--text-only .feature__media { display: block; }
  }
  @media (max-width: 47.99em) {
    .feature--text-only .feature__text { max-width: none; }
  }

  /* Body copy with its key phrases in bold. */
  .feature__text :global(.feature__body) { font-size: var(--text-lead); font-weight: var(--weight-secondary); line-height: 1.65; }
  .feature__text :global(.feature__body strong) { font-weight: 700; }
  .feature__text :global(.proof-link) { justify-self: start; margin-top: var(--space-s); }
</style>
