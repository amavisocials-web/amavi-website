---
import type { Post } from '../lib/journal';
import { formatDate, isoDate, journalPath } from '../lib/journal';

/**
 * One post, as a row in a list. The listing is these, and so is the "next"
 * block at the foot of a post, so the two cannot drift apart.
 *
 * The whole row is the link, not the title inside it: the anchor wraps the
 * three parts, and the heading is a span within it rather than a nested link.
 *
 * On hover the title steps right and the arrow takes the space it left, so
 * nothing on the row reflows — the arrow is positioned in that gap rather
 * than inserted into the flow. A cover image is never shown here; the script
 * (src/scripts/journal-preview.ts) fades it in beside the cursor instead,
 * reading the path off `data-preview`.
 */
interface Props {
  post: Post;
  /** Heading level, so the listing and the "next" block both keep a valid outline. */
  level?: 2 | 3;
}
const { post, level = 2 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const { title, subtitle, excerpt, date, readingTime, image } = post.data;
---

<a class="jrow" href={journalPath(post.id)} data-preview={image || undefined}>
  <time class="jrow__date" datetime={isoDate(date)}>{formatDate(date)}</time>

  <div class="jrow__body">
    <H class="jrow__title">
      <span class="jrow__arrow" aria-hidden="true">
        <svg viewBox="0 0 22 12" focusable="false">
          <path d="M0 6h19M14.5 1L20 6l-5.5 5" fill="none" stroke="currentColor"
                stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
      </span>
      <span class="jrow__text">{title}</span>
    </H>
    {subtitle && <p class="jrow__subtitle">{subtitle}</p>}
    <p class="jrow__excerpt">{excerpt}</p>
  </div>

  {readingTime && <p class="jrow__time">{readingTime} min</p>}
</a>

<style>
  .jrow {
    display: grid;
    gap: var(--space-2xs);
    /* Unhurried: the space inside a row is what makes the list a list rather
       than a stack of headlines. */
    padding-block: clamp(1.75rem, 1.1rem + 2.6vw, 3rem);
    color: inherit;
    text-decoration: none;
    /* Never under 88px, however short the title. */
    min-height: 5.5rem;
    align-content: center;
  }
  .jrow:focus-visible { outline-offset: 4px; }

  @media (min-width: 64em) {
    .jrow {
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr) minmax(0, 6rem);
      column-gap: var(--space-xl);
      align-items: start;
      align-content: start;
    }
  }

  /* ---- The date and the reading time ------------------------------------- */
  /* Black held back rather than a grey of its own: the palette is three
     colours, and 0.6 of the ink is 5.74:1 on white, above the 4.5:1 small
     text needs. */
  .jrow__date,
  .jrow__time {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    /* 0.7, not 0.6: the ink is #222021 rather than black, and 0.6 of it on
       the off-white ground is 4.14:1, under what 12px text needs. */
    opacity: 0.7;
    white-space: nowrap;
  }
  @media (min-width: 64em) {
    .jrow__date { padding-top: 0.45em; }
    .jrow__time { padding-top: 0.45em; text-align: right; }
  }
  /* Below the three-column layout the date and the reading time share one
     small line above the title. Placed explicitly: left to auto-placement the
     body spans the row and pushes the time onto a line of its own under the
     excerpt. */
  @media (max-width: 63.99em) {
    .jrow {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--space-m);
      row-gap: var(--space-xs);
    }
    .jrow__date { grid-area: 1 / 1; }
    .jrow__time { grid-area: 1 / 2; text-align: right; }
    .jrow__body { grid-area: 2 / 1 / 3 / -1; }
  }

  /* ---- The title --------------------------------------------------------- */
  .jrow__body { display: grid; gap: var(--space-2xs); min-width: 0; }

  .jrow__title {
    position: relative;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(1.1875rem, 0.82rem + 1.56vw, 2.1875rem);
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: pretty;
  }
  .jrow__text {
    display: inline-block;
    transition: transform 250ms var(--ease), color 250ms var(--ease);
  }

  /* Sitting in the space the title is about to leave, so the row holds still. */
  .jrow__arrow {
    position: absolute;
    left: -0.78em;
    top: 0.5em;
    display: inline-flex;
    width: 0.62em;
    opacity: 0;
    transition: opacity 250ms var(--ease);
  }
  .jrow__arrow svg { width: 100%; height: auto; }

  .jrow:hover .jrow__text,
  .jrow:focus-visible .jrow__text {
    transform: translateX(12px);
    color: var(--accent);
  }
  .jrow:hover .jrow__arrow,
  .jrow:focus-visible .jrow__arrow { opacity: 1; color: var(--accent); }

  /* The standing line: a step down from the title, a step up from the
     excerpt, so the three read as one block rather than three. */
  .jrow__subtitle {
    font-size: var(--text-lead);
    font-weight: var(--weight-secondary);
    max-width: 48ch;
    opacity: 0.85;
    text-wrap: pretty;
  }

  /* ---- The excerpt ------------------------------------------------------- */
  /* A shade behind the title, and still 7.6:1 on white. */
  .jrow__excerpt {
    font-weight: var(--weight-secondary);
    max-width: 52ch;
    opacity: 0.7;
    text-wrap: pretty;
  }

  @media (max-width: 47.99em) {
    .jrow__title { font-size: clamp(1rem, 0.86rem + 0.6vw, 1.1875rem); }
  }

  /* Colour alone, and nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .jrow__text,
    .jrow__arrow { transition: none; }
    .jrow:hover .jrow__text,
    .jrow:focus-visible .jrow__text { transform: none; }
  }
</style>
