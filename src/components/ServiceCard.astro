---
/**
 * One service: a name, what the client receives, and what's included.
 *
 * Deliberately short. The longer explanation for each service still lives in
 * its markdown file (src/content/services/) and can be brought back into the
 * page if the Work With Us format lands somewhere longer.
 */
interface Props {
  title: string;
  summary: string;
  includes: string[];
  provisional?: boolean;
  id?: string;
}
const { title, summary, includes, provisional = false, id } = Astro.props;
---

<article class="service" id={id}>
  <h2 class="display display--sm service__title">{title}</h2>
  {provisional && (
    /* TODO(client): confirm this is sold as a standalone line item. */
    <p class="service__flag">Scope to be confirmed</p>
  )}
  <p class="service__summary">{summary}</p>
  <ul class="service__includes" role="list">
    {includes.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .service {
    display: grid;
    gap: var(--space-s);
    align-content: start;
    padding-top: var(--space-m);
    border-top: 2px solid var(--hairline-strong);
  }
  .service__title { max-width: 18ch; }
  .service__summary { color: var(--fg-muted); text-wrap: pretty; }

  .service__flag {
    justify-self: start;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--fg-accent);
  }

  .service__includes { list-style: none; display: grid; gap: var(--space-2xs); margin-top: var(--space-2xs); }
  .service__includes li {
    font-size: var(--text-sm);
    line-height: 1.5;
    padding-left: 1.1em;
    position: relative;
  }
  .service__includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5em;
    height: 1px;
    background: var(--fg-muted);
  }
</style>
