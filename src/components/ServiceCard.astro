---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

/**
 * One service: a photograph, a name, what the client receives, and what's
 * included.
 *
 * The photograph sits in a fixed 4:5 frame whether or not it exists yet, so
 * swapping the placeholder for the real image moves nothing on the page: the
 * image is cropped to fill the frame rather than setting its own height. Set
 * it in the service's markdown file (`image:` and `imageAlt:`).
 *
 * The longer explanation for each service still lives in the body of its
 * markdown file (src/content/services/), unrendered, in case the page grows.
 */
interface Props {
  title: string;
  summary: string;
  includes: string[];
  provisional?: boolean;
  id?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, summary, includes, provisional = false, id, image, imageAlt } = Astro.props;
---

<article class="service" id={id}>
  {image ? (
    <div class="service__media">
      <Image src={image} alt={imageAlt ?? ''} widths={[480, 720, 960]}
             sizes="(min-width: 64em) 24rem, (min-width: 40em) 45vw, 100vw"
             class="service__img" loading="lazy" decoding="async" />
    </div>
  ) : (
    <Placeholder ratio="4/5" class="service__media" />
  )}

  <h2 class="display display--sm service__title">{title}</h2>
  {provisional && (
    /* TODO(client): confirm this is sold as a standalone line item. */
    <p class="service__flag">Scope to be confirmed</p>
  )}
  <p class="service__summary">{summary}</p>
  <ul class="service__includes" role="list">
    {includes.map((item) => <li>{item}</li>)}
  </ul>
</article>

<style>
  .service {
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  /* The frame is fixed at 4:5; what fills it can't change its size. */
  .service :global(.service__media) {
    aspect-ratio: 4 / 5;
    margin-bottom: var(--space-2xs);
    overflow: hidden;
    border-radius: var(--radius-media);
  }
  .service__img { width: 100%; height: 100%; object-fit: cover; }

  .service__title { max-width: 18ch; }
  .service__summary { font-weight: var(--weight-secondary); text-wrap: pretty; }

  /* Set apart by an outline, not a colour. */
  .service__flag {
    justify-self: start;
    padding: 0.3em 0.7em;
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    line-height: 1.3;
    border: var(--stroke) solid var(--line);
  }

  .service__includes { list-style: none; display: grid; gap: var(--space-2xs); margin-top: var(--space-2xs); }
  .service__includes li {
    font-size: var(--text-sm);
    line-height: 1.5;
    padding-left: 1.1em;
    position: relative;
  }
  .service__includes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5em;
    border-top: var(--stroke) solid var(--line);
  }
</style>
