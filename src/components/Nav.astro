---
import Logo from './Logo.astro';
import { NAV_LINKS, CONTACT_PATH } from '../consts';

interface Props {
  /** `overlay` sits in white over the indigo home hero; `standard` is the white header. */
  variant?: 'standard' | 'overlay';
}
const { variant = 'standard' } = Astro.props;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => path === href;
---

{/* Runs during parse: marks the nav collapsible before it is ever painted,
     so there is no flash of the expanded list on mobile. */}
<script is:inline>document.documentElement.dataset.navReady = 'true';</script>

<header class:list={['site-header', `site-header--${variant}`]}>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="AMAVI Socials — home">
      <Logo variant={variant === 'overlay' ? 'white' : 'brand'} />
    </a>

    {/*
      JS justification: a disclosure button with a real aria-expanded state is
      the accessible pattern for a mobile menu. ~20 lines, and every link is in
      the DOM regardless, so nothing is unreachable without it.
    */}
    <button class="nav-toggle" type="button" aria-expanded="false"
            aria-controls="primary-nav" data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary" data-nav>
      <ul class="nav__list">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav__link"
              aria-current={!link.external && isCurrent(link.href) ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
        <li class="nav__cta">
          <a href={CONTACT_PATH} class="btn btn--primary"
             aria-current={isCurrent(CONTACT_PATH) ? 'page' : undefined}>Get in Touch</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* Standard header: white, with the indigo wordmark — the supplied logo's
     own inversion. Takes the light roles from the surface system. */
  .site-header--standard {
    --surface: var(--bg);
    background: var(--surface);
    color: var(--fg);
    border-bottom: 1px solid var(--hairline);
  }

  /* Over the indigo hero: transparent, so the hero shows through, but with
     the indigo surface's roles — white type, white button, white focus. */
  .site-header--overlay {
    --surface: var(--accent);
    --fg: var(--bg);
    --focus: var(--bg);
    --btn-bg: var(--bg);
    --btn-fg: var(--ink);
    --btn-bg-hover: var(--ink);
    --btn-fg-hover: var(--bg);
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--fg);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .brand { text-decoration: none; color: inherit; display: inline-flex; align-items: center; }

  .nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.2vw, 2.25rem);
  }

  .nav__link {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    padding-block: 0.35em;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .nav__link:hover { border-color: currentColor; }
  .site-header--standard .nav__link[aria-current='page'] { border-color: var(--accent); }
  .site-header--overlay .nav__link[aria-current='page'] { border-color: currentColor; }

  .nav__cta .btn { padding: 0.9em 1.5em; }

  /* --- Toggle (mobile only) --- */
  .nav-toggle {
    display: none;
    position: relative;
    z-index: 60; /* above the open menu, so it doubles as the close button */
    cursor: pointer;
    padding: var(--space-2xs);
    margin-right: calc(var(--space-2xs) * -1);
    color: inherit;
  }
  .nav-toggle__bars { display: grid; gap: 6px; width: 26px; }
  .nav-toggle__bars span {
    height: 2px;
    background: currentColor;
    transition: transform var(--dur) var(--ease);
  }
  [aria-expanded='true'] .nav-toggle__bars span:first-child { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .nav-toggle__bars span:last-child { transform: translateY(-4px) rotate(-45deg); }
  /* The open menu is white, so an overlay header's white toggle goes black. */
  .site-header--overlay [aria-expanded='true'] { color: var(--ink); }

  @media (max-width: 63.99em) {
    .nav-toggle { display: block; }

    /* The open menu is a white surface whichever header it came from, so it
       resets every role rather than inheriting the overlay's white type. */
    :global([data-nav-ready='true']) .nav {
      --surface: var(--bg);
      --fg: var(--ink);
      --focus: var(--accent);
      --btn-bg: var(--accent);
      --btn-fg: var(--bg);
      --btn-bg-hover: var(--ink);
      --btn-fg-hover: var(--bg);
      position: fixed;
      inset: 0;
      background: var(--surface);
      color: var(--fg);
      display: grid;
      place-items: center;
      z-index: 50;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur) var(--ease), visibility var(--dur);
    }
    :global([data-nav-ready='true']) .nav[data-open='true'] { opacity: 1; visibility: visible; }

    .nav__list { flex-direction: column; gap: var(--space-m); text-align: center; }
    /* UI, so Montserrat — the display face is kept for headings. */
    .nav__link {
      font-size: 1.125rem;
      letter-spacing: 0.08em;
    }
    .site-header--overlay .nav__link[aria-current='page'] { border-color: var(--accent); }
    .nav__cta { margin-top: var(--space-s); }
  }
</style>
