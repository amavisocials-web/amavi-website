---
import Logo from './Logo.astro';
import { NAV_LINKS, CONTACT_PATH, CREATOR_PATH, BRAND_ENQUIRY_MAILTO, CONTACT_EMAIL, SOCIALS } from '../consts';

/**
 * The header: a menu button on the left, the wordmark in the centre, Get in
 * touch on the right. It stays at the top of the screen as the page scrolls.
 * It carried a 2px accent line along its bottom edge between 5 and 9 October
 * 2026; nothing draws that edge now, and the shadow that fades in on scroll
 * is what separates the header from the page.
 *
 * Over hero footage it has no background and white contents until the hero
 * has scrolled past; everywhere else it is white with a hairline under it.
 *
 * The menu is a full-screen panel with the site's pages set large, and the
 * contact routes beneath. Without JavaScript the menu button is a link to the
 * footer, which lists every page.
 */
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => path === href;
/* The open menu's order: Get in Touch above Creator Network since
   27 October 2026. NAV_LINKS keeps its own order, which the 404 page reads. */
const links = [
  { label: 'Home', href: '/' },
  ...NAV_LINKS.filter((link) => link.href !== CREATOR_PATH),
  { label: 'Get in Touch', href: CONTACT_PATH },
  ...NAV_LINKS.filter((link) => link.href === CREATOR_PATH),
];
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a href="#footer-nav" class="menu-toggle" data-menu-toggle aria-controls="site-menu">
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="menu-toggle__label">Menu</span>
    </a>

    <a href="/" class="brand" aria-label="AMAVI Socials home">
      <Logo variant="current" />
    </a>

    <a href={CONTACT_PATH} class="header-cta" aria-current={isCurrent(CONTACT_PATH) ? 'page' : undefined}>
      Get in touch
    </a>
  </div>
</header>

<div id="site-menu" class="menu" data-menu hidden>
  <nav class="container menu__inner" aria-label="Primary">
    <ul class="menu__list">
      {links.map((link) => (
        <li>
          <a href={link.href} class="menu__link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="menu__routes">
      <div class="menu__route">
        <p class="label">Brands</p>
        <a href={BRAND_ENQUIRY_MAILTO}>Email us</a>
      </div>
      <div class="menu__route">
        <p class="label">Creators</p>
        <a href={CREATOR_PATH}>Apply to join</a>
      </div>
      <div class="menu__route">
        <p class="label">General</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </div>
      <div class="menu__route">
        <p class="label">Follow</p>
        <p class="menu__socials">
          {SOCIALS.map((s, i) => (
            <>{i > 0 && ' '}<a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
            </a></>
          ))}
        </p>
      </div>
    </div>
  </nav>
</div>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLAnchorElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const hero = document.querySelector<HTMLElement>('.hero');

  /*
   * The shadow under the header, once the page has moved past the top. One
   * rAF in flight at a time: scroll fires far more often than the screen is
   * painted, so reading and writing once per frame is all the work there is
   * to do.
   */
  if (header) {
    let queued = false;
    const SHOWN_FROM = 40;

    const sync = () => {
      queued = false;
      header.classList.toggle('is-scrolled', window.scrollY > SHOWN_FROM);
    };

    sync();
    window.addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(sync);
    }, { passive: true });
  }

  // Over hero footage, the header turns solid once the hero is behind it.
  if (header && hero) {
    const height = () => header.getBoundingClientRect().height;
    const observer = new IntersectionObserver(
      ([entry]) => header.classList.toggle('is-past-hero', !entry.isIntersecting),
      { rootMargin: `-${Math.round(height())}px 0px 0px 0px` },
    );
    observer.observe(hero);
  } else {
    header?.classList.add('is-past-hero');
  }

  // JS justification: a disclosure button with a real aria-expanded state is
  // the accessible pattern for a menu. Without it, the toggle stays a link to
  // the footer's list of pages.
  if (header && toggle && menu) {
    toggle.setAttribute('role', 'button');
    toggle.setAttribute('aria-expanded', 'false');
    const outside = [...document.querySelectorAll<HTMLElement>('main, footer, .skip-link')];

    const setOpen = (open: boolean, { restoreFocus = false } = {}) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      header.classList.toggle('is-menu-open', open);
      document.documentElement.classList.toggle('menu-open', open);
      outside.forEach((el) => (el.inert = open));
      if (open) menu.querySelector<HTMLElement>('.menu__link')?.focus();
      else if (restoreFocus) toggle.focus();
    };

    toggle.addEventListener('click', (event) => {
      event.preventDefault();
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    toggle.addEventListener('keydown', (event) => {
      if (event.key === ' ') {
        event.preventDefault();
        toggle.click();
      }
    });
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false, { restoreFocus: true });
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    /* Frosted: what is under the header stays faintly readable through it,
       rather than disappearing behind a white band. The solid colour is the
       fallback and is replaced below where the blur is supported. */
    background: var(--bg);
    color: var(--ink);
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease),
      box-shadow 250ms var(--ease);
  }

  @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header {
      /* The page's own ground, held back so what passes under the header
         stays faintly readable through it. Mixed from the token rather
         than written out, so the background follows --bg; a browser
         without color-mix drops this and keeps the solid fallback. */
      background: color-mix(in srgb, var(--bg) 72%, transparent);
      -webkit-backdrop-filter: blur(16px) saturate(140%);
      backdrop-filter: blur(16px) saturate(140%);
    }
  }


  /* Nothing under the header at the top of the page; once the page has moved
     past it, a soft shadow fades in and says the header is above the content. */
  .site-header.is-scrolled { box-shadow: 0 1px 24px rgb(0 0 0 / 0.07); }

  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: background-color 0.3s var(--ease), color 0.3s var(--ease); }
  }

  /* Over hero footage — and only while the hero is still behind it — the
     header drops its background and its contents turn white. Which cut is on
     screen depends on orientation, so this does too. */
  @media (orientation: landscape) {
    :global(body:has(.hero[data-desktop='video'])) .site-header:not(.is-past-hero):not(.is-menu-open) {
      background: rgb(0 0 0 / 0.3);
      color: var(--on-dark);
    }
  }
  @media (orientation: portrait) {
    :global(body:has(.hero[data-mobile='video'])) .site-header:not(.is-past-hero):not(.is-menu-open) {
      background: rgb(0 0 0 / 0.3);
      color: var(--on-dark);
    }
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-s);
    height: 100%;
    padding-inline: var(--gutter);
  }

  /* The wordmark takes the accent on white; over footage it follows the
     header's white. */
  .brand { justify-self: center; display: inline-flex; color: var(--accent); text-decoration: none; }
  @media (orientation: landscape) {
    :global(body:has(.hero[data-desktop='video'])) .site-header:not(.is-past-hero):not(.is-menu-open) .brand { color: inherit; }
  }
  @media (orientation: portrait) {
    :global(body:has(.hero[data-mobile='video'])) .site-header:not(.is-past-hero):not(.is-menu-open) .brand { color: inherit; }
  }

  .menu-toggle,
  .header-cta {
    font-size: 0.75rem;
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .menu-toggle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 2.75rem;
    cursor: pointer;
  }
  .menu-toggle__bars { display: grid; gap: 6px; width: 24px; }
  .menu-toggle__bars span {
    height: var(--stroke-mark);
    background: currentColor;
    transition: transform var(--dur) var(--ease);
  }
  [aria-expanded='true'] .menu-toggle__bars span:first-child { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .menu-toggle__bars span:last-child { transform: translateY(-4px) rotate(-45deg); }
  .menu-toggle:hover { color: var(--accent); }

  .header-cta {
    justify-self: end;
    padding-block: 0.35em;
    border-bottom: var(--stroke) solid currentColor;
  }
  .header-cta:hover,
  .header-cta[aria-current='page'] { color: var(--accent); }

  /* On a phone the corner links are icon-sized: the menu has everything. */
  @media (max-width: 47.99em) {
    .menu-toggle__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .header-cta { display: none; }
  }

  /* ---- The menu ------------------------------------------------------------ */
  .menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    z-index: 45;
    overflow-y: auto;
    background: var(--bg);
    color: var(--ink);
    border-top: var(--stroke-hair) solid var(--line);
  }
  .menu[hidden] { display: none; }
  :global(html.menu-open) { overflow: hidden; }

  .menu__inner {
    display: grid;
    align-content: space-between;
    gap: var(--space-xl);
    min-height: 100%;
    padding-block: var(--space-xl) var(--space-l);
  }

  .menu__list { list-style: none; display: grid; gap: var(--space-2xs); }
  /* Set at the wordmark's size, so the menu reads as a list rather than a
     stack of headings. The row stays 44px tall for the tap target. */
  .menu__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: 1.6875rem;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: var(--stroke-mark) solid var(--bg);
  }
  .menu__link:hover,
  .menu__link[aria-current='page'] { color: var(--accent); border-bottom-color: var(--accent); }

  .menu__routes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-m) var(--space-l);
    padding-top: var(--space-m);
    border-top: var(--stroke-hair) solid var(--line);
  }
  .menu__route { display: grid; gap: var(--space-3xs); align-content: start; font-size: var(--text-sm); }
  .menu__socials { display: flex; gap: var(--space-s); }
</style>
