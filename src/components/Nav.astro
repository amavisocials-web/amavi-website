---
import Logo from './Logo.astro';
import { NAV_LINKS, CONTACT_PATH } from '../consts';

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => path === href;
---

{/* Runs during parse: marks the nav collapsible before it is ever painted,
     so there is no flash of the expanded list on mobile. */}
<script is:inline>document.documentElement.dataset.navReady = 'true';</script>

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="AMAVI Socials — home">
      <Logo variant="brand" />
    </a>

    {/*
      JS justification: a disclosure button with a real aria-expanded state is
      the accessible pattern for a mobile menu. ~20 lines, and every link is in
      the DOM regardless, so nothing is unreachable without it.
    */}
    <button class="nav-toggle" type="button" aria-expanded="false"
            aria-controls="primary-nav" data-nav-toggle>
      <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary" data-nav>
      <ul class="nav__list">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav__link"
              aria-current={!link.external && isCurrent(link.href) ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
        <li class="nav__cta">
          <a href={CONTACT_PATH} class="btn btn--primary"
             aria-current={isCurrent(CONTACT_PATH) ? 'page' : undefined}>Get in Touch</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  if (toggle && nav) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      nav.dataset.open = String(open);
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  /* One header everywhere: white, a black hairline beneath, the accent
     wordmark. */
  .site-header {
    background: var(--bg);
    color: var(--ink);
    border-bottom: var(--stroke-hair) solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
  }

  .brand { text-decoration: none; display: inline-flex; align-items: center; }

  .nav__list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2.2vw, 2.25rem);
  }

  /* Links are ink. The accent is only the mark: an underline on hover and on
     the current page. The reserved border is white on white until then. */
  .nav__link {
    font-size: 0.75rem;
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding-block: 0.35em;
    border-bottom: var(--stroke-mark) solid var(--bg);
    transition: border-color var(--dur) var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] { border-color: var(--accent); }

  .nav__cta .btn { padding: 0.9em 1.5em; }

  /* --- Toggle (mobile only) --- */
  .nav-toggle {
    display: none;
    position: relative;
    z-index: 60; /* above the open menu, so it doubles as the close button */
    cursor: pointer;
    padding: var(--space-2xs);
    margin-right: calc(var(--space-2xs) * -1);
    color: var(--ink);
  }
  .nav-toggle__bars { display: grid; gap: 6px; width: 26px; }
  .nav-toggle__bars span {
    height: var(--stroke-mark);
    background: currentColor;
    transition: transform var(--dur) var(--ease);
  }
  [aria-expanded='true'] .nav-toggle__bars span:first-child { transform: translateY(4px) rotate(45deg); }
  [aria-expanded='true'] .nav-toggle__bars span:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 63.99em) {
    .nav-toggle { display: block; }

    :global([data-nav-ready='true']) .nav {
      position: fixed;
      inset: 0;
      background: var(--bg);
      display: grid;
      place-items: center;
      z-index: 50;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur) var(--ease), visibility var(--dur);
    }
    :global([data-nav-ready='true']) .nav[data-open='true'] { opacity: 1; visibility: visible; }

    .nav__list { flex-direction: column; gap: var(--space-m); text-align: center; }
    .nav__link { font-size: 1.125rem; letter-spacing: 0.08em; }
    .nav__cta { margin-top: var(--space-s); }
  }
</style>
