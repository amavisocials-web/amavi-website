---
import { CONTACT_EMAIL } from '../consts';
import { SHEETS_ENDPOINT } from '../lib/sheets';

/**
 * The brand enquiry form on /contact.
 *
 * A real form first. The markup posts to Netlify Forms on its own — name,
 * method, action and the hidden form-name input are what Netlify's build-time
 * detection looks for — so with no JavaScript it still submits and the
 * enquiry is still captured. The script then takes it over to submit in
 * place, which is the only reason the four states exist.
 *
 * Two steps since 27 October 2026, in place: who you are (name, company,
 * email), then the brief (what you need, how many creators a month, timing,
 * and the brand). Step
 * 1 is required; since 28 October 2026 nothing on step 2 is, so it can be
 * sent exactly as it comes up. Both
 * are in the markup as one form, so a single submission at the end carries
 * every field, and without JavaScript the two simply show one after the
 * other. An inline script hides step 2 before first paint; if the step script
 * never arrives, its timer shows the long form again.
 *
 * **Success is only ever shown on an actual success.** The script treats a
 * non-2xx response, a network error and a timeout alike: the form comes back
 * with every field still filled in and the error line appears. Nothing
 * optimistic (src/scripts/brand-enquiry.ts).
 *
 * Each enquiry is emailed to partnerships@ by the same Apps Script that handles
 * creator applications (scripts/google-sheets-handler.gs, URL in
 * data-sheets-endpoint), with Reply-To set to the enquirer; Netlify Forms keeps
 * a copy. Netlify's own form notifications need a paid plan.
 *
 * TODO(client): **no automatic reply goes to the enquirer.** AMAVI is
 * emailed and that is all, so the two working days promised in the copy beside
 * this form are a person's job at the moment. The cheapest place for an
 * acknowledgement is now the script's enquiry_: a second MailApp.sendEmail to
 * the enquirer, from AMAVI's own Google account. It needs wording from AMAVI.
 */
const FORM_NAME = 'brand-enquiry';

/** Step 1. `error` is the message under a field left empty. */
const FIELDS = [
  { name: 'name', label: 'Name', type: 'text', placeholder: 'Your name', autocomplete: 'name', error: 'Please add your name.' },
  { name: 'company', label: 'Company', type: 'text', placeholder: 'Your company', autocomplete: 'organization', error: 'Please add your company.' },
  { name: 'email', label: 'Email', type: 'email', placeholder: 'Your email', autocomplete: 'email', error: 'Please add your email address.' },
] as const;

/** Step 2: what the brief is. All of it optional (28 October 2026). */
const NEEDS = [
  'Creator campaigns',
  'Always-on creator programme',
  'UGC content',
  'Founder and personal brand',
  'Live experiences',
  'Organic social content',
  'Not sure yet',
];
/* In place of the budget question since 29 October 2026: no fees or money
   anywhere on this form. Sent as `creators_per_month`. */
const CREATORS_PER_MONTH = ['1 to 5', '6 to 20', '21 to 50', '50+'];
const STARTS = ['As soon as possible', 'Within a month', 'Within three months', 'Just exploring'];
---

<div class="enquiry" data-enquiry data-state="idle">
  <form
    class="enquiry__form"
    name={FORM_NAME}
    method="POST"
    action="/contact/"
    data-netlify="true"
    netlify-honeypot="company_website"
    data-sheets-endpoint={SHEETS_ENDPOINT}
    data-enquiry-form
    novalidate
  >
    {/* Steps before first paint: step 2 hidden until the script takes over.
        If it never does, the long form comes back after four seconds. */}
    <script is:inline>
      (function (form) {
        form.dataset.steps = 'pending';
        setTimeout(function () { if (form.dataset.steps === 'pending') delete form.dataset.steps; }, 4000);
      })(document.currentScript.parentElement);
    </script>
    <input type="hidden" name="form-name" value={FORM_NAME} />
    <p class="honeypot" aria-hidden="true">
      <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
    </p>

    {/* Visual only: each step's legend says "Step n of 2" to screen readers. */}
    <div class="enquiry__progress" aria-hidden="true">
      <p class="enquiry__count" data-enquiry-count>Step 1 of 2</p>
      <ol class="enquiry__segments" role="list">
        <li class="enquiry__segment is-on" data-enquiry-segment></li>
        <li class="enquiry__segment" data-enquiry-segment></li>
      </ol>
    </div>

    <fieldset class="enquiry__step" data-enquiry-step="1">
      <legend class="visually-hidden">Step 1 of 2: about you</legend>
      {FIELDS.map((field) => (
        <div class="field">
          <label class="field__label" for={`enquiry-${field.name}`}>{field.label}</label>
          <input
            class="field__input"
            id={`enquiry-${field.name}`}
            name={field.name}
            type={field.type}
            placeholder={field.placeholder}
            autocomplete={field.autocomplete}
            required
            aria-describedby={`enquiry-${field.name}-error`}
            data-error={field.error}
          />
          <p class="field__error" id={`enquiry-${field.name}-error`} aria-live="polite"></p>
        </div>
      ))}
    </fieldset>

    <fieldset class="enquiry__step" data-enquiry-step="2">
      <legend class="visually-hidden">Step 2 of 2: about the brief</legend>

      <div class="field" role="group" aria-labelledby="enquiry-needs-label">
        <span class="field__label" id="enquiry-needs-label">
          What do you need help with <span class="field__optional">(choose any)</span>
        </span>
        <div class="chips">
          {NEEDS.map((need) => (
            <label class="chip">
              <input type="checkbox" name="needs[]" value={need} />
              <span class="chip__label">{need}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="field" role="radiogroup" aria-labelledby="enquiry-creators-label">
        <span class="field__label" id="enquiry-creators-label">How many creators are you looking to engage per month?</span>
        <div class="chips">
          {CREATORS_PER_MONTH.map((band) => (
            <label class="chip">
              <input type="radio" name="creators_per_month" value={band} />
              <span class="chip__label">{band}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="field" role="radiogroup" aria-labelledby="enquiry-start-label">
        <span class="field__label" id="enquiry-start-label">When do you want to start</span>
        <div class="chips">
          {STARTS.map((start) => (
            <label class="chip">
              <input type="radio" name="start" value={start} />
              <span class="chip__label">{start}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="enquiry-brand">Tell us about the brand</label>
        <textarea
          class="field__input field__input--area"
          id="enquiry-brand"
          name="brand"
          rows="4"
          placeholder="What you sell, who you are trying to reach, and what you have tried so far."
        ></textarea>
      </div>
    </fieldset>

    <div class="enquiry__actions">
      <button class="btn btn--primary enquiry__button" type="submit" data-enquiry-button>
        <span data-enquiry-label>Get started</span>
      </button>
      <button class="enquiry__back" type="button" data-enquiry-back hidden>
        <svg class="enquiry__back-arrow" viewBox="0 0 22 12" aria-hidden="true" focusable="false">
          <path d="M22 6H3M7.5 1L2 6l5.5 5" fill="none" stroke="currentColor"
                stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        Back
      </button>
    </div>
  </form>

  {/* The error and any validation message. Polite, so it is read without
      cutting across whatever the person is doing. */}
  <p class="enquiry__status" role="status" aria-live="polite" data-enquiry-status></p>

  {/* Replaces the form, and only ever after a real success. */}
  <div class="enquiry__done" data-enquiry-done hidden>
    <p class="enquiry__done-title">Thanks, we have got it.</p>
    <p class="enquiry__done-line">We will come back to you within two working days.</p>
  </div>

  <div class="enquiry__direct">
    <p class="enquiry__direct-label">Email us</p>
    <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    {/* TODO(client): phone number, if one should be listed. */}
  </div>
</div>

<script>
  import '../scripts/brand-enquiry';
</script>

<style>
  .enquiry { display: grid; gap: var(--space-m); }
  .enquiry__form { display: grid; gap: var(--space-m); }

  .field { display: grid; gap: var(--space-3xs, 0.25rem); }

  /* The site's label: small capitals, letter-spaced, above the field. */
  .field__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  /* A rule under the words, not a box around them: the site's field, with
     three of its four sides taken off. Matches Subscribe.astro. */
  .field__input {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 0;
    font: inherit;
    font-size: 1rem;              /* ≥16px, or iOS zooms on focus */
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    background: none;
    border: 0;
    border-bottom: var(--stroke) solid var(--line);
    border-radius: 0;
  }
  .field__input::placeholder { color: var(--ink); font-weight: var(--weight-secondary); opacity: 0.7; }
  .field__input:focus-visible { outline: var(--stroke-mark) solid var(--accent); outline-offset: 3px; }
  .field__input[aria-invalid='true'] { border-bottom-width: var(--stroke-mark); }

  .field__input--area { min-height: 7rem; resize: vertical; }

  /* --- Two steps ------------------------------------------------------------
     `data-steps` is set by the inline script before first paint ("pending")
     and by the step script once it runs ("ready"); `data-current` says which
     step is showing. Without either, both steps show as one long form. */
  .enquiry__step { display: grid; gap: var(--space-m); min-width: 0; margin: 0; padding: 0; border: 0; }
  .enquiry__form[data-steps='pending'] [data-enquiry-step='2'],
  .enquiry__form[data-steps='ready'][data-current='1'] [data-enquiry-step='2'],
  .enquiry__form[data-steps='ready'][data-current='2'] [data-enquiry-step='1'] { display: none; }

  /* Step 1 of 2, and two segments filled in the accent up to this step, as
     on the creator application. Only while it is in steps. */
  .enquiry__progress { display: grid; gap: var(--space-xs); }
  .enquiry__form:not([data-steps]) .enquiry__progress { display: none; }
  .enquiry__count {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .enquiry__segments { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.3rem; margin: 0; padding: 0; }
  .enquiry__segment {
    height: 0.4rem;
    border: var(--stroke) solid var(--line);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .enquiry__segment.is-on { background: var(--accent); border-color: var(--accent); }

  /* The button across the column, and on step 2 Back centred beneath it
     (28 October 2026: beside it, it pulled the row off balance). Back is a
     link in look, a button in kind: it changes the step, it does not go
     anywhere. The site's secondary-link type, small capitals in grey, with
     the arrow before it. Its box is 44px tall for a thumb, so the gap above
     it is 8px: about 24px from the button to the word. */
  .enquiry__actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
  }
  .enquiry__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 2.75rem;
    padding: 0 var(--space-s);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.7; /* 0.7 and not lower: 0.6 of #222021 misses AA. */
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 200ms ease-out, opacity 200ms ease-out;
  }
  .enquiry__back-arrow {
    flex: none;
    width: 1.1rem;
    height: 0.6rem;
    transition: transform 200ms ease-out;
  }
  .enquiry__back:hover,
  .enquiry__back:focus-visible { color: var(--accent); opacity: 1; }
  .enquiry__back:hover .enquiry__back-arrow,
  .enquiry__back:focus-visible .enquiry__back-arrow { transform: translateX(-0.25rem); }
  .enquiry__back:focus-visible { outline: var(--stroke-mark) solid var(--accent); outline-offset: 3px; }
  .enquiry__back[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .enquiry__back,
    .enquiry__back-arrow { transition: none; }
    .enquiry__back:hover .enquiry__back-arrow,
    .enquiry__back:focus-visible .enquiry__back-arrow { transform: none; }
  }

  /* Full width of the column, accent fill, white text. */
  .enquiry__button { width: 100%; justify-content: center; }
  .enquiry__button[disabled] { opacity: 0.55; cursor: default; }

  .enquiry__status {
    font-size: var(--text-form);
    font-weight: var(--weight-secondary);
    line-height: 1.5;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .enquiry__status:empty { display: none; }
  .enquiry__status a { color: var(--accent); text-decoration: underline; }

  /* `:not([hidden])`, so the author `display` cannot override the attribute.
     This rendered the confirmation on page load before 23 October 2026: it
     said `display: grid` outright, which beats the UA `display: none` that
     `hidden` relies on. There is a site-wide [hidden] guard in global.css as
     well; this keeps the component correct on its own. */
  .enquiry__done:not([hidden]) { display: grid; gap: var(--space-2xs); }
  .enquiry__done-title { font-size: var(--text-lead); font-weight: var(--weight-strong); }
  .enquiry__done-line { font-size: var(--text-lead); font-weight: var(--weight-secondary); opacity: 0.7; }

  /* Only one of the two is ever present. */
  .enquiry[data-state='done'] .enquiry__form,
  .enquiry[data-state='done'] .enquiry__status { display: none; }

  /* A labelled block, not a sentence: the site's small capitals over the
     address. */
  .enquiry__direct { display: grid; gap: var(--space-3xs, 0.25rem); }
  .enquiry__direct-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  /* 0.7 and not lower: 0.6 of #222021 misses AA at this size. */
  .enquiry__direct a {
    font-size: var(--text-sm);
    font-weight: var(--weight-secondary);
    color: var(--ink);
    opacity: 0.7;
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }
  .enquiry__direct a:hover { color: var(--accent); opacity: 1; }
</style>
