---
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { logoFor, opticalK } from '../logos';

/**
 * Case study: image on one side, meta on the other, with deliverables and
 * results as two small stacked columns.
 *
 * Case studies name the client brand and the outcome. They never name
 * creators, quote them, link their posts, or show insights screenshots —
 * that material belongs to the creators and the clients and needs separate
 * sign-off (brief §5).
 */
interface Props {
  client: string;
  sector: string;
  summary: string;
  challenge: string;
  approach: string[];
  results: { value: string; label: string }[];
  deliverables: string[];
  tone?: 'sage' | 'clay' | 'stone';
  /** Mirrors the layout, so a run of case studies alternates. */
  flipped?: boolean;
}
const {
  client, sector, summary, challenge, approach, results, deliverables,
  tone = 'sage', flipped = false,
} = Astro.props;

const logo = logoFor(client);
const logoK = logo ? opticalK(logo) : 1;
---

<article class:list={['case', flipped && 'case--flipped']}>
  <div class="case__media">
    <Placeholder ratio="4/5" tone={tone} caption={logo ? undefined : client}>
      {logo && (
        <div class="case__logo-panel">
          <Image
            src={logo.src}
            alt={`${client} logo`}
            height={140}
            loading="lazy"
            decoding="async"
            class="case__logo"
            style={`--k:${logoK.toFixed(3)}`}
          />
        </div>
      )}
    </Placeholder>
  </div>

  <div class="case__body">
    <p class="label case__sector">{sector}</p>
    <h3 class="display display--md case__client">{client}</h3>
    <p class="case__summary">{summary}</p>

    <div class="case__section">
      <h4 class="label">The brief</h4>
      <p class="case__text">{challenge}</p>
    </div>

    <div class="case__section">
      <h4 class="label">What we did</h4>
      <ul class="case__approach" role="list">
        {approach.map((step) => <li>{step}</li>)}
      </ul>
    </div>

    <div class="case__columns">
      <div class="case__col">
        <h4 class="label">Deliverables</h4>
        <ul class="case__list" role="list">
          {deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="case__col">
        <h4 class="label">Results</h4>
        <ul class="case__results" role="list">
          {results.map((result) => (
            <li class="case__result">
              <span class="case__result-value">{result.value}</span>
              <span class="case__result-label">{result.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="case__notes"><slot /></div>
  </div>
</article>

<style>
  .case { display: grid; gap: var(--space-l); }

  /* A paper panel keeps a white-background logo off the tinted field. */
  .case__logo-panel {
    /* Fixed proportions, so the lockup is the same shape on every case study
       rather than shrink-wrapping to each logo's own aspect ratio. */
    background: var(--paper);
    width: 72%;
    min-height: 9rem;
    padding: var(--space-m);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .case__logo {
    height: calc(var(--case-logo-base) * var(--k, 1));
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .case__media { --case-logo-base: clamp(3.25rem, 2.4rem + 2.4vw, 4.5rem); }
  .case__sector { display: block; margin-bottom: var(--space-xs); }
  .case__client { margin-bottom: var(--space-s); }

  .case__summary {
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--ink);
    max-width: 40ch;
    text-wrap: pretty;
  }

  .case__section { margin-top: var(--space-l); }
  .case__section .label { display: block; margin-bottom: var(--space-xs); }

  .case__text { color: var(--ink-muted); max-width: var(--measure); }

  .case__approach {
    list-style: none;
    display: grid;
    gap: var(--space-2xs);
    max-width: var(--measure);
  }
  .case__approach li {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
    padding-left: 1.1em;
    position: relative;
  }
  .case__approach li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.68em;
    width: 0.5em; height: 1px;
    background: var(--ink-muted);
  }

  /* --- The two small stacked columns --- */
  .case__columns {
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 30em) {
    .case__columns { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--space-m); }
  }

  .case__col .label { display: block; margin-bottom: var(--space-s); }

  .case__list { list-style: none; display: grid; gap: var(--space-3xs); }
  .case__list li { font-size: var(--text-sm); line-height: 1.5; color: var(--ink-muted); }

  .case__results { list-style: none; display: grid; gap: var(--space-s); }
  .case__result { display: grid; gap: 2px; }
  .case__result-value {
    font-family: var(--font-body);
    font-size: var(--figure-sm);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .case__result-label {
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--ink-muted);
    max-width: 30ch;
  }

  .case__notes { margin-top: var(--space-l); max-width: var(--measure); color: var(--ink-muted); }
  .case__notes :global(p + p) { margin-top: var(--space-s); }

  @media (min-width: 60em) {
    .case {
      grid-template-columns: minmax(0, 0.78fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: start;
    }
    .case--flipped .case__media { order: 2; }
  }
</style>
