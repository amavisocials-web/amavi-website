---
import type { Post } from '../lib/culture';
import { formatDate, isoDate, culturePath } from '../lib/culture';

/**
 * One post, as a row in an index. The listing is these, and so is the "next"
 * block at the foot of a post, so the two cannot drift apart.
 *
 * **A tight index, not a stack of blocks.** Rewritten on 23 October 2026: the
 * rows were 88px at their shortest and clamped up to 3rem of padding on top of
 * that, which held four in a viewport. One weekly post each Friday would have
 * made the page endless. Now each row is a single horizontal line on desktop
 * — date, title with its excerpt under it, reading time — and six to eight fit
 * at 1280.
 *
 * The excerpt is capped at **one line** and truncated, which is what keeps the
 * row height fixed no matter how long the copy is.
 *
 * The whole row is the link, not the title inside it: the anchor wraps the
 * three parts and the heading is a span within it rather than a nested link.
 * On hover the title steps right and the arrow takes the space it left, so
 * nothing reflows — the arrow sits in that gap rather than in the flow. The
 * cursor-follow preview came off with this rewrite, along with its script.
 */
interface Props {
  post: Post;
  /** Heading level, so the listing and the "next" block both keep a valid outline. */
  level?: 2 | 3;
}
const { post, level = 2 } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const { title, excerpt, date, readingTime } = post.data;
---

<a class="crow" href={culturePath(post.id)}>
  <time class="crow__date" datetime={isoDate(date)}>{formatDate(date)}</time>

  <div class="crow__body">
    <H class="crow__title">
      <span class="crow__arrow" aria-hidden="true">
        <svg viewBox="0 0 22 12" focusable="false">
          <path d="M0 6h19M14.5 1L20 6l-5.5 5" fill="none" stroke="currentColor"
                stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
      </span>
      <span class="crow__text">{title}</span>
    </H>
    <p class="crow__excerpt">{excerpt}</p>
  </div>

  <p class="crow__time">{readingTime ? `${readingTime} min` : ''}</p>
</a>

<style>
  /* Stacked on a phone, one line from 48em. The date and the reading time take
     fixed tracks so every row's title starts and ends on the same vertical,
     which is what makes a column of these read as an index. */
  .crow {
    display: grid;
    gap: 0.15rem var(--space-m);
    padding-block: var(--space-s);
    color: inherit;
    text-decoration: none;
    align-items: baseline;
  }
  @media (min-width: 48em) {
    .crow {
      grid-template-columns: 7.5rem minmax(0, 1fr) 4rem;
      padding-block: var(--space-s);
    }
  }

  /* Small, uppercase, letter-spaced, and held off full black. 0.7 and not
     lower: 0.6 of #222021 misses AA at this size. */
  .crow__date,
  .crow__time {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    opacity: 0.7;
    white-space: nowrap;
  }
  .crow__time { grid-column: 3; text-align: right; }
  @media (max-width: 47.99em) {
    /* No empty third column on a phone: the time joins the date on one line. */
    .crow__time { grid-column: 1; text-align: left; }
    .crow__time:empty { display: none; }
  }

  .crow__body { min-width: 0; }

  /* A modest heading, not a display size: this is a list of links. */
  .crow__title {
    position: relative;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-size: var(--display-sm);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  /* One line, cut with an ellipsis. This is what fixes the row height. */
  .crow__excerpt {
    font-size: var(--text-sm);
    font-weight: var(--weight-secondary);
    line-height: 1.4;
    opacity: 0.7;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Sitting in the space the title leaves when it steps right, so the row
     does not reflow on hover. */
  .crow__arrow {
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.1rem;
    height: 0.6rem;
    translate: -1.6rem -50%;
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .crow__arrow svg { width: 100%; height: 100%; display: block; }

  .crow:hover .crow__title,
  .crow:focus-visible .crow__title {
    transform: translateX(1.6rem);
    color: var(--accent);
  }
  .crow:hover .crow__arrow,
  .crow:focus-visible .crow__arrow { opacity: 1; }

  .crow:focus-visible { outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .crow__title,
    .crow__arrow { transition: none; }
    .crow:hover .crow__title,
    .crow:focus-visible .crow__title { transform: none; }
  }
</style>
