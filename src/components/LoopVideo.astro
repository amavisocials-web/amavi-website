---
import Placeholder from './Placeholder.astro';
import { videoFiles } from '../lib/media';

/**
 * A silent, looping video in a fixed frame — or, when the file isn't in
 * /public yet, an outlined "Add video" frame at the same ratio.
 *
 * Nothing is downloaded up front: no preload, and the poster and sources are
 * only attached as the video nears the screen. It plays only while visible
 * and pauses as it scrolls away. Under reduced motion it never plays — the
 * poster is all there is. All of that is src/scripts/loop-videos.ts.
 *
 * Decorative by default (aria-hidden): whatever it shows should be said by
 * the text around it.
 */
interface Props {
  /** Base path under /public, no extension: plays `<src>.webm` / `<src>.mp4`. */
  src: string;
  /** Still for before it plays; defaults to `<src>.jpg`. */
  poster?: string;
  /** CSS aspect ratio of the frame, e.g. '2/3'. */
  ratio?: string;
  /** Shown in the placeholder when the video is missing. */
  note?: string;
  /**
   * A media query the video waits for before it loads anything but its
   * poster, e.g. '(min-width: 64em)'. For a frame that is on the page at
   * every width but should only play at some of them — the collage's swipe
   * row on a phone shows stills alone. Without it, the video plays wherever
   * it is shown.
   */
  loopFrom?: string;
  /**
   * Playback is decided elsewhere, not by src/scripts/loop-videos.ts. That
   * script plays every visible video; a caller that needs to cap how many play
   * at once (the collage's phone row plays two) sets this and takes over.
   */
  managed?: boolean;
  /**
   * The HTML autoplay attribute, beside muted and playsinline: the set a phone
   * browser lets start without a tap. It cannot start a download on its own,
   * because the sources are only attached by the manager, whose play() call
   * is what actually starts the video.
   */
  autoplay?: boolean;
  /** 'none' by default. 'metadata' only where the brief asks for it. */
  preload?: 'none' | 'metadata';
  /**
   * The poster alone, as an image, in the same frame: for the copies a
   * marquee repeats so its loop has no seam (2 November 2026). A copy was a
   * video of its own, decoding beside the one it repeats; now only the
   * original is a video. The image's address is attached by the marquee's
   * script as the marquee nears the screen, as a poster is.
   */
  still?: boolean;
  /**
   * A video the page can do without: on a device too weak for it, it stays
   * on its poster (src/scripts/lib/playback.ts). The collage's tiles; never
   * the hero.
   */
  optional?: boolean;
  class?: string;
}
const {
  src, poster, ratio = '2/3', note, loopFrom, managed = false, autoplay = false, preload = 'none',
  still = false, optional = false, class: className,
} = Astro.props;
const files = videoFiles(src, poster);
if (!files.playable) {
  console.warn(`[LoopVideo] TODO(client): video needed — no ${src}.mp4 or ${src}.webm in public/; showing "Add video".`);
}
---

{files.playable ? (
  <div class:list={['loop-video', className]} style={`aspect-ratio:${ratio}`}>
    {still ? (
      files.poster && <img data-src={files.poster} alt="" draggable="false" />
    ) : (
      /* `muted` is in the markup and not only set from script: Safari will not
         autoplay a video that was muted after the fact. */
      <video muted loop playsinline preload={preload} autoplay={autoplay || undefined}
             disablepictureinpicture aria-hidden="true"
             data-loop data-loop-managed={managed ? 'true' : undefined}
             data-loop-optional={optional ? '' : undefined}
             data-poster={files.poster} data-loop-from={loopFrom}>
        {/* MP4 (H.264) first: every browser plays it. WebM, if one is ever
            added, only after it, as an optimisation. */}
        {files.mp4 && <source data-src={files.mp4} type="video/mp4" />}
        {files.webm && <source data-src={files.webm} type="video/webm" />}
      </video>
    )}
  </div>
) : (
  <Placeholder kind="video" ratio={ratio} note={note} class={className} />
)}

<script>
  import '../scripts/loop-videos';
</script>

<style>
  .loop-video {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-frame);
    background: var(--surface-dark);
  }
  /* The still copy sits exactly where the video would, cropped the same way,
     so the two cannot be told apart while the video is on its poster. */
  .loop-video video,
  .loop-video img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
