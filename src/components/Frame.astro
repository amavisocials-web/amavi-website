---
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import type { ImageSlot } from '../data/media';

/**
 * An image slot: the photograph, cropped to fill a fixed aspect ratio — or,
 * with no photograph, the outlined "Add image" frame at the same ratio. The
 * frame's size never depends on the file, so swapping one in moves nothing.
 */
interface Props {
  /** Not called `slot`: that name is Astro's own, for placing a child in a
      named slot, and the two would collide wherever a Frame fills one. */
  media?: ImageSlot;
  /** CSS aspect ratio, e.g. '2/3'. */
  ratio: string;
  /** For the browser's choice of file size; describe the rendered width. */
  sizes?: string;
  /** A media query under which the photograph is never shown, because the
      page hides it there with display: none. Where it matches, the browser is
      handed a blank instead of the file. Lazy loading already leaves a hidden
      image alone; this also covers JavaScript being off, when lazy loading
      is switched off and every image loads at once. */
  skipWhen?: string;
  class?: string;
}
const { media, ratio, sizes = '(min-width: 64em) 22rem, 60vw', skipWhen, class: className } = Astro.props;

/** A transparent 1x1 GIF, inline: choosing it costs no request. */
const BLANK = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
---

{media ? (
  <div class:list={['frame', className]} style={`aspect-ratio:${ratio}`}>
    {skipWhen ? (
      <picture>
        <source media={skipWhen} srcset={BLANK} />
        <Image src={media.image} alt={media.alt} widths={[360, 540, 720, 1000]} sizes={sizes}
               loading="lazy" decoding="async" class="frame__img" />
      </picture>
    ) : (
      <Image src={media.image} alt={media.alt} widths={[360, 540, 720, 1000]} sizes={sizes}
             loading="lazy" decoding="async" class="frame__img" />
    )}
  </div>
) : (
  <Placeholder kind="image" ratio={ratio} class={className} />
)}

<style>
  .frame {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-frame);
  }
  .frame__img { width: 100%; height: 100%; object-fit: cover; }
  /* No box of its own, so the image sits in the frame exactly as it does
     without one. */
  .frame picture { display: contents; }
</style>
