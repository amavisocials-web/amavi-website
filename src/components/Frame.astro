---
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import type { ImageSlot } from '../data/media';

/**
 * An image slot: the photograph, cropped to fill a fixed aspect ratio — or,
 * with no photograph, the outlined "Add image" frame at the same ratio. The
 * frame's size never depends on the file, so swapping one in moves nothing.
 */
interface Props {
  /** Not called `slot`: that name is Astro's own, for placing a child in a
      named slot, and the two would collide wherever a Frame fills one. */
  media?: ImageSlot;
  /** CSS aspect ratio, e.g. '2/3'. */
  ratio: string;
  /** For the browser's choice of file size; describe the rendered width. */
  sizes?: string;
  class?: string;
}
const { media, ratio, sizes = '(min-width: 64em) 22rem, 60vw', class: className } = Astro.props;
---

{media ? (
  <div class:list={['frame', className]} style={`aspect-ratio:${ratio}`}>
    <Image src={media.image} alt={media.alt} widths={[360, 540, 720, 1000]} sizes={sizes}
           loading="lazy" decoding="async" class="frame__img" />
  </div>
) : (
  <Placeholder kind="image" ratio={ratio} class={className} />
)}

<style>
  .frame {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-frame);
  }
  .frame__img { width: 100%; height: 100%; object-fit: cover; }
</style>
