---
interface Props {
  /** The post's own address, absolute. */
  url: string;
  title: string;
}
const { url, title } = Astro.props;

/**
 * Three ways to pass a post on: the link itself, LinkedIn, X.
 *
 * Text, not icon buttons. They are small, in a row, and read as the same
 * small capitals the rest of the site uses for labels.
 *
 * Copy is a real button because it does something on this page; the other two
 * are links, because they go somewhere. The confirmation is announced as well
 * as shown, and it reverts on its own, so the row returns to how it was.
 */
const share = {
  linkedin: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
  x: `https://x.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`,
};
---

<div class="share" data-share data-url={url}>
  <p class="share__label">Share</p>
  <ul class="share__list" role="list">
    <li>
      <button type="button" class="share__item" data-share-copy>
        <span data-share-copy-label>Copy link</span>
      </button>
    </li>
    <li><a class="share__item" href={share.linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
    </a></li>
    <li><a class="share__item" href={share.x} target="_blank" rel="noopener noreferrer">
      X<span class="visually-hidden"> (opens in a new tab)</span>
    </a></li>
  </ul>
  <p class="visually-hidden" role="status" aria-live="polite" data-share-status></p>
</div>

<script>
  import '../scripts/share-post';
</script>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
  }
  .share__label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    /* See the note on .jrow__date: 0.6 of #222021 misses AA at this size. */
    opacity: 0.7;
  }
  .share__list { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-m); }

  .share__item {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .share__item:hover { color: var(--accent); }
  .share__item:focus-visible { outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) { .share__item { transition: none; } }
</style>
