---
/**
 * The home page's full-screen opening: a headline and the two ways in,
 * centred on both axes over video.
 *
 * It is the headline and two words, nothing else: the line of positioning and
 * the pair of filled buttons came off on 6 October 2026, so the only thing to
 * click is the choice between the two audiences.
 *
 * The two words are set in white, not the accent. They were asked for in the
 * accent, and the accent has been measured against this footage each time it
 * changed, over the whole copy block, every 0.2s through the loop, with the
 * overlay composited in:
 *
 *   #341BCA   1.00:1   the blue meets the darkened plate at its own luminance
 *   #8B0000   1.00:1   the same, and a heavier overlay made it worse, because
 *                      darkening the backdrop moves it towards a dark accent
 *   #FFEE8C   1.18:1   a surface, not a text colour, and this one is black
 *   #FFFFFF   4.82:1   which is why the words are white
 *
 * Re-measure before putting the accent back, and only if the footage changes:
 * no overlay strength rescues a colour this close to the plate. A page can add a subline, a
 * short line of services under the buttons, and large entry points beneath;
 * the home page uses none of the three. The copy comes from the page
 * (src/pages/index.astro).
 *
 * Two separate cuts of footage, both from HERO_VIDEO in src/consts.ts: the
 * desktop cut (16:9) plays on landscape screens, the mobile cut (9:16) on
 * portrait ones. Each is looked for at build time. Where a cut is missing,
 * that orientation shows the hero as an outlined frame reading "Add video",
 * with black text on white; where it's present, the footage fills the screen
 * edge to edge under a flat black overlay, with white text, and the header
 * sits over it (see Nav.astro).
 *
 * The videos load and play only while on screen, never under reduced motion
 * (src/scripts/loop-videos.ts), and a cut that isn't displayed never loads.
 */
import Lines from './Lines.astro';
import { videoFiles } from '../lib/media';
import { HERO_VIDEO } from '../consts';

export interface Entry {
  who: string;
  /** One short line on what's there. */
  line: string;
  /** The link's call to action. */
  cta: string;
  href: string;
}

export interface Way {
  label: string;
  href: string;
}

interface Props {
  /** "\n" marks a line break. */
  title: string;
  /** The two ways in, as oversized word links under the headline. */
  ways?: Way[];
  /** One line under the headline. Unused on the home page since 6 Oct 2026. */
  intro?: string;
  /** A few words under the headline, divided by an accent rule. */
  subline?: string[];
  /** Short list of services, set in small capitals under the buttons. */
  services?: string[];
  /** Large entry points under the hero, one per audience. */
  entries?: Entry[];
}
const { title, ways = [], intro, subline = [], services = [], entries = [] } = Astro.props;

const desktop = videoFiles(HERO_VIDEO);
const mobile = videoFiles(`${HERO_VIDEO}-portrait`);
for (const [name, cut, size] of [['desktop', desktop, '1920×1080'], ['mobile', mobile, '1080×1920']] as const) {
  if (!cut.playable) console.warn(`[Hero] TODO(client): ${name} hero video needed (${size}) — showing "Add video".`);
}

---

<section
  class="hero"
  data-desktop={desktop.playable ? 'video' : 'frame'}
  data-mobile={mobile.playable ? 'video' : 'frame'}
>
  <div class="hero__inner">
    {/* Silent, captionless footage: decoration, hidden from assistive tech. */}
    {(desktop.playable || mobile.playable) && (
      <div class="hero__media" aria-hidden="true">
        {desktop.playable && (
          <video class="hero__video hero__video--desktop" muted loop playsinline preload="none"
                 disablepictureinpicture data-loop data-poster={desktop.poster}>
            {desktop.webm && <source data-src={desktop.webm} type="video/webm" />}
            {desktop.mp4 && <source data-src={desktop.mp4} type="video/mp4" />}
          </video>
        )}
        {mobile.playable && (
          <video class="hero__video hero__video--mobile" muted loop playsinline preload="none"
                 disablepictureinpicture data-loop data-poster={mobile.poster}>
            {mobile.webm && <source data-src={mobile.webm} type="video/webm" />}
            {mobile.mp4 && <source data-src={mobile.mp4} type="video/mp4" />}
          </video>
        )}
        <div class="hero__overlay"></div>
      </div>
    )}

    {/* Stands in for whichever cut is missing on this screen. */}
    <p class="hero__label" aria-hidden="true">
      <span class="hero__label-text">Add video</span>
      <span class="hero__label-note hero__label-note--desktop">Desktop cut · 16:9</span>
      <span class="hero__label-note hero__label-note--mobile">Mobile cut · 9:16</span>
    </p>

    <div class="hero__body">
      <h1 class="display display--xl hero__title enter enter--1"><Lines text={title} /></h1>
      {subline.length > 0 && (
        <p class="hero__subline enter enter--2">
          {subline.map((word, i) => (
            <>{i > 0 && <span class="hero__divider" aria-hidden="true">|</span>}<span class="hero__word">{word}</span></>
          ))}
        </p>
      )}
      {ways.length > 0 && (
        <nav class="hero__ways enter enter--2" aria-label="Choose your route">
          {ways.map((way, i) => (
            <>
              {i > 0 && <span class="hero__ways-rule" aria-hidden="true"></span>}
              <a class="hero__way" href={way.href}>{way.label}</a>
            </>
          ))}
        </nav>
      )}
      {intro && <p class="hero__intro enter enter--2">{intro}</p>}
      <div class="hero__actions enter enter--3"><slot name="actions" /></div>
      {services.length > 0 && <p class="label hero__services enter enter--3">{services.join(' · ')}</p>}
    </div>

    {entries.length > 0 && (
    <nav class="hero__entries enter enter--3" aria-label="Where to start">
      {entries.map((entry) => (
        <a class="entry" href={entry.href}>
          <span class="entry__who">{entry.who}</span>
          <span class="entry__line">{entry.line}</span>
          <span class="entry__what">{entry.cta}</span>
          <svg class="entry__arrow" viewBox="0 0 10 20" aria-hidden="true">
            <path d="M1 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="1.25"
                  vector-effect="non-scaling-stroke" />
          </svg>
        </a>
      ))}
    </nav>
    )}
  </div>
</section>

<script>
  import '../scripts/loop-videos';
</script>

<style>
  /* ---- Frame (default): no footage for this screen ----------------------- */
  .hero {
    --hero-fg: var(--ink);
    --hero-rule: var(--line);
    display: grid;
    min-height: calc(100svh - var(--header-h));
    padding: var(--space-s) var(--gutter) var(--gutter);
  }

  .hero__inner {
    position: relative;
    isolation: isolate;
    display: grid;
    /* An equal share of the height above and below the words, so the
       headline and the two ways sit in the middle of the frame rather
       than along its bottom edge. */
    grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
    overflow: hidden;
    color: var(--hero-fg);
    border: var(--stroke) solid var(--line);
    border-radius: var(--radius-frame);
  }

  .hero__media { position: absolute; inset: 0; z-index: -1; display: none; }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* The footage of 13 October 2026 is a wall of campaign work with someone
     pinning a sheet to it, and the person is right of centre: holding the
     frame to the right keeps them in shot on a window narrower than 16:9,
     and what gets cropped is wall. Tied to this footage. */
  .hero__video--desktop { object-position: right center; }
  /* Two layers of black, not one. The footage is a wall of printed sheets:
     bright, and busy in exactly the middle of the frame where the words sit,
     so a flat overlay strong enough to carry white text there would flatten
     the whole picture.

     The flat layer holds the corners at 0.66, where the footage still reads.
     Over it, a soft pool of extra darkness centred on the words brings the
     middle to about 0.80, and fades out before the edges.

     Measured on this footage, every 0.2s through the whole 7s loop, over the
     boxes the headline and the two labels actually occupy, with both layers
     composited: white holds at least 11.42:1 on the desktop cut at 1280 and
     9.20:1 on the portrait one at 375, against the 4.5:1 the labels need and
     the 3:1 the headline needs. The worst frame of both is around 5s, where
     the sheet being pinned catches the most light. It was 0.55 and 0.73 until
     16 October 2026, which measured 8.00:1 and 6.44:1 and read lighter than
     the client wanted. Re-measure if the footage changes.

     Translucent blacks written out, as --divider-line is: the token is the
     colour, and these are strengths of it. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(118% 82% at 50% 50%,
        rgb(0 0 0 / 0.40) 0%,
        rgb(0 0 0 / 0.30) 42%,
        rgb(0 0 0 / 0.12) 68%,
        rgb(0 0 0 / 0) 84%),
      rgb(0 0 0 / 0.66);
  }

  .hero__label {
    align-self: center;
    justify-self: center;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: var(--space-m);
    text-align: center;
  }
  .hero__label-text { font-size: var(--text-sm); font-weight: var(--weight-strong); }
  .hero__label-note { font-size: var(--text-xs); font-weight: var(--weight-secondary); }
  .hero__label-note--mobile { display: none; }

  /* ---- Footage for this screen: full bleed, under the header ------------- */
  @media (orientation: landscape) {
    .hero[data-desktop='video'] { --hero-fg: var(--on-dark); --hero-rule: var(--on-dark); }
    .hero[data-desktop='video'],
    .hero[data-desktop='video'] .hero__inner { padding: 0; border-style: none; border-radius: 0; }
    .hero[data-desktop='video'] { min-height: 100svh; margin-top: calc(var(--header-h) * -1); }
    .hero[data-desktop='video'] .hero__inner {
      /* Matched top and bottom: the top keeps the words clear of the
         header, and the bottom keeps the content box symmetric, so
         centring in it centres them on the frame. */
      padding-block: var(--header-h);
    }
    .hero[data-desktop='video'] .hero__media { display: block; }
    .hero[data-desktop='video'] .hero__label { visibility: hidden; }
    .hero[data-desktop='video'] .hero__divider { color: inherit; opacity: 0.6; }
    .hero__video--mobile { display: none; }
  }
  @media (orientation: portrait) {
    .hero[data-mobile='video'] { --hero-fg: var(--on-dark); --hero-rule: var(--on-dark); }
    .hero[data-mobile='video'],
    .hero[data-mobile='video'] .hero__inner { padding: 0; border-style: none; border-radius: 0; }
    .hero[data-mobile='video'] { min-height: 100svh; margin-top: calc(var(--header-h) * -1); }
    .hero[data-mobile='video'] .hero__inner {
      /* Matched top and bottom: the top keeps the words clear of the
         header, and the bottom keeps the content box symmetric, so
         centring in it centres them on the frame. */
      padding-block: var(--header-h);
    }
    .hero[data-mobile='video'] .hero__media { display: block; }
    .hero[data-mobile='video'] .hero__label { visibility: hidden; }
    .hero[data-mobile='video'] .hero__divider { color: inherit; opacity: 0.6; }
    .hero__video--desktop { display: none; }
    .hero__label-note--desktop { display: none; }
    .hero__label-note--mobile { display: inline; }
  }

  /* ---- Words -------------------------------------------------------------- */
  /* Centred on the frame, not ranged left: the headline, the line under it,
     the positioning and the buttons share one axis down the middle. */
  .hero__body {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-m);
    /* Even on all four sides: nothing is anchored to an edge now, and the
       side padding is what keeps the headline off the glass on a phone. */
    padding: var(--space-l);
    max-width: 72rem;
    margin-inline: auto;
    text-align: center;
  }
  .hero__title { max-width: 24ch; font-size: clamp(1.5625rem, 0.95rem + 2.37vw, 2.9375rem); }

  /* The two audiences, divided by an upright rule: the label for the two
     buttons under it. The rule is drawn in the accent, and inherits the text's
     own colour over footage, where the accent on black would all but
     disappear (see the overrides above). */
  .hero__subline {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(0.6875rem, 0.55rem + 0.71vw, 1.0625rem);
    line-height: 1.35;
    text-transform: uppercase;
  }
  .hero__word { white-space: nowrap; }
  .hero__divider { margin-inline: 0.75em; color: var(--accent); font-weight: 400; }

  .hero__intro {
    max-width: 46ch;
    margin-top: var(--space-2xs);
    font-size: var(--text-lead);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* ---- The two ways in: words, not buttons ------------------------------ */
  /* Side by side with a hairline between them, wrapping onto two lines only
     if a screen is too narrow to hold both. */
  .hero__ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 0.4rem + 1.1vw, 1.5rem);
    /* How far under the baseline the hover rule sits. 11px here measures as
       9.4px of clear air under the letters at 1280 and 9.0px at 375: the
       0.36em baseline estimate below runs about 1.6px shallow, and this takes
       that up rather than pretending the estimate is exact. */
    --way-underline-gap: 11px;
  }
  .hero__ways-rule {
    flex: none;
    width: var(--stroke);
    height: 1.4em;
    background: currentColor;
    opacity: 0.4;
  }

  .hero__way {
    position: relative;
    display: inline-flex;
    align-items: center;
    /* A target before it is a word: never under 44px. */
    min-height: 2.75rem;
    padding-inline: 0.2em;
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 0.75rem + 0.8vw, 1.375rem);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    /* A shade under full white at rest, so hover has somewhere to go. */
    opacity: 0.85;
    transition: opacity var(--dur) var(--ease);
  }

  /* The underline wipes in from the left rather than appearing whole.
     Positioned from the baseline, not from the bottom of the target. The word
     is centred in a 44px box while the type itself runs from 15px to 22px
     across the clamp, so a fixed offset off the bottom lands somewhere
     different at every width — `bottom: 0.7em` put it within a pixel of the
     baseline at 1280 and struck through the letters. `50% - 0.36em` is where
     the baseline falls in a centred line, so taking the gap off that holds
     the same clearance under the letters at every size. */
  .hero__way::after {
    content: '';
    position: absolute;
    left: 0.2em;
    right: 0.2em;
    bottom: calc(50% - 0.36em - var(--way-underline-gap));
    height: var(--stroke-mark, 2px);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms var(--ease);
  }
  .hero__way:hover,
  .hero__way:focus-visible { opacity: 1; }
  .hero__way:hover::after,
  .hero__way:focus-visible::after { transform: scaleX(1); }
  /* White, so the ring reads against the footage rather than against the
     page it is not on. */
  .hero__way:focus-visible { outline-color: currentColor; outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .hero__way,
    .hero__way::after { transition: none; }
  }

  .hero__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-s); margin-top: var(--space-2xs); }
  .hero__actions:empty { display: none; }
  .hero__services { margin-top: var(--space-2xs); line-height: 1.6; }

  /* ---- The two ways in: large, split, a hairline between ------------------ */
  .hero__entries {
    display: grid;
    border-top: var(--stroke) solid var(--hero-rule);
  }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'who arrow' 'line arrow' 'what arrow';
    align-items: center;
    column-gap: var(--space-m);
    padding: var(--space-s) var(--space-l);
    color: var(--hero-fg);
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .entry + .entry { border-top: var(--stroke) solid var(--hero-rule); }
  .entry__who {
    grid-area: who;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(1.1875rem, 0.79rem + 1.58vw, 1.9375rem);
    line-height: 1.05;
    text-transform: uppercase;
  }
  .entry__line {
    grid-area: line;
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    line-height: 1.45;
  }
  .entry__what {
    grid-area: what;
    margin-top: var(--space-2xs);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .entry__arrow { grid-area: arrow; width: 0.9rem; height: 1.8rem; transition: transform var(--dur) var(--ease); }

  /* Hover and press: the half fills with the accent, the words go white. */
  .entry:hover,
  .entry:active { background: var(--accent); color: var(--on-dark); }
  .entry:hover .entry__arrow { transform: translateX(0.35rem); }
  .entry:focus-visible { outline-offset: -6px; outline-color: currentColor; }

  @media (min-width: 48em) {
    .hero__entries { grid-template-columns: 1fr 1fr; }
    .entry + .entry { border-top: 0; border-left: var(--stroke) solid var(--hero-rule); }
  }

  @media (max-width: 47.99em) {
    .hero__body { padding: var(--space-m); }
    .hero__intro { font-size: var(--text-base); }
    .entry { padding: var(--space-s) var(--space-m); }
  }
</style>
