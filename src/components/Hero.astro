---
/**
 * The opening: a full-bleed background video with the headline, one line of
 * support and both calls to action over it.
 *
 * The footage is one constant, HERO_VIDEO in src/consts.ts — a base path the
 * hero turns into `.webm`, `.mp4` and `.jpg` (the poster). Each file is
 * checked for at build time and left out if it isn't in /public yet, so the
 * page never requests a file that doesn't exist: today only the placeholder
 * poster is there, and the hero shows that still.
 *
 * Motion is opt-in. Visitors who ask for reduced motion get the poster and
 * no video — the video is hidden, paused and never allowed to autoplay.
 */
import fs from 'node:fs';
import path from 'node:path';
import { HERO_VIDEO } from '../consts';

interface Props {
  title: string;
  subtitle?: string;
  /** Base path under /public, without an extension. */
  video?: string;
}
const { title, subtitle, video = HERO_VIDEO } = Astro.props;

const inPublic = (file: string) => fs.existsSync(path.join(process.cwd(), 'public', file));
const webm = inPublic(`${video}.webm`) ? `${video}.webm` : undefined;
const mp4 = inPublic(`${video}.mp4`) ? `${video}.mp4` : undefined;
const poster = inPublic(`${video}.jpg`) ? `${video}.jpg` : undefined;
---

<section class="hero surface-dark">
  {/* Silent, captionless footage: decoration, so hidden from assistive tech. */}
  <div class="hero__media" aria-hidden="true">
    {poster && <img class="hero__poster" src={poster} alt="" width="1920" height="1080" fetchpriority="high" />}
    {/* WebM first: smaller where it's supported; the MP4 (H.264) covers the rest. */}
    <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={poster} data-hero-video>
      {webm && <source src={webm} type="video/webm" />}
      {mp4 && <source src={mp4} type="video/mp4" />}
    </video>
    {/* Runs as soon as the video is parsed, before it can start: autoplay
        ignores prefers-reduced-motion on its own. Also follows the setting
        if it changes while the page is open. */}
    <script is:inline>
      (function () {
        var v = document.querySelector('[data-hero-video]');
        var still = window.matchMedia('(prefers-reduced-motion: reduce)');
        function apply() {
          if (still.matches) {
            v.removeAttribute('autoplay');
            v.pause();
          } else if (v.querySelector('source')) {
            v.play().catch(function () {});
          }
        }
        apply();
        if (still.addEventListener) still.addEventListener('change', apply);
      })();
    </script>
    <div class="hero__overlay"></div>
  </div>

  <div class="container hero__content">
    <h1 class="display display--xl hero__title enter enter--1">{title}</h1>
    {subtitle && <p class="lead hero__sub enter enter--2">{subtitle}</p>}
    <div class="hero__actions enter enter--3"><slot name="actions" /></div>
  </div>
</section>

<style>
  .hero {
    /* How much the overlay darkens the footage. Retune once the real footage
       is in: just enough that the white headline holds on its brightest
       frame. */
    --hero-overlay: 0.5;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(32rem, 86svh, 56rem);
  }

  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The overlay is the one tint on the site: black, part-transparent, flat. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--surface-dark);
    opacity: var(--hero-overlay);
  }

  /* Reduced motion: the poster, and no video at all. */
  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
  }

  .hero__content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-m);
    padding-block: var(--space-2xl);
  }

  .hero__title { max-width: 26ch; }
  /* Regular rather than light: thin strokes break up over moving footage. */
  .hero__sub { max-width: 44ch; font-weight: var(--weight-body); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }
</style>
