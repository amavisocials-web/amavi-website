---
import Logo from './Logo.astro';
import {
  NAV_LINKS, SOCIALS, SITE_NAME, REGION, CONTACT_PATH, CREATOR_PATH, CONTACT_EMAIL,
  BRAND_ENQUIRY_MAILTO, RESPONSE_TIME,
} from '../consts';

/**
 * The footer: a black card, inset from the page's edges, that opens on the
 * ways to get in touch — one route each for brands, creators and anything
 * else — then the site's pages, socials and the small print.
 *
 * The brands route uses BRAND_ENQUIRY_MAILTO, the same pre-filled email as
 * the "Email us" button on the contact page.
 */
const year = new Date().getFullYear();
const routes = [
  { who: 'Brands', line: 'Tell us who you want to reach.', link: 'Email us', href: BRAND_ENQUIRY_MAILTO },
  { who: 'Creators', line: 'Join the AMAVI creator network.', link: 'Apply to join', href: CREATOR_PATH },
  { who: 'General', line: 'Anything else.', link: CONTACT_EMAIL, href: `mailto:${CONTACT_EMAIL}` },
];
---

<footer class="site-footer" id="site-footer">
  <div class="footer-card surface-dark">
    <section class="footer-contact" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="display display--lg footer-title">Get in touch</h2>
      <ul class="routes" role="list">
        {routes.map((route) => (
          <li class="route">
            <h3 class="label route__who">{route.who}</h3>
            <p class="route__line">{route.line}</p>
            <a class="route__link" href={route.href}>{route.link}</a>
          </li>
        ))}
      </ul>
      <p class="meta footer-response">{RESPONSE_TIME}</p>
    </section>

    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="lg" variant="white" />
        <p class="meta footer-tag">
          A creator-led marketing and partnerships agency, working with brands across {REGION}.
        </p>
      </div>

      <nav class="footer-col" id="footer-nav" aria-label="Footer">
        <h2 class="label footer-heading">Site</h2>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          <li><a href={CONTACT_PATH}>Get in Touch</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="label footer-heading">Follow</h2>
        <ul role="list">
          {SOCIALS.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="rule" />
    <div class="footer-base">
      <p class="meta">&copy; {year} {SITE_NAME}. All rights reserved.</p>
      <p class="meta"><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  /* Inset from the page edges, so it reads as a card sitting on white. */
  .site-footer { padding: 0 var(--space-s) var(--space-s); }
  @media (min-width: 48em) { .site-footer { padding: 0 var(--space-m) var(--space-m); } }

  .footer-card {
    --card-pad: clamp(1.5rem, 0.8rem + 3.2vw, 4rem);
    padding: var(--card-pad);
    border-radius: var(--radius-frame);
  }

  /* ---- Get in touch: three routes ---------------------------------------- */
  .footer-contact { display: grid; gap: var(--space-l); padding-bottom: var(--space-xl); }
  .routes {
    list-style: none;
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 48em) {
    .routes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-l); }
  }
  .route {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding-top: var(--space-s);
    border-top: var(--stroke-hair) solid var(--on-dark);
  }
  .route__line { font-weight: var(--weight-secondary); }
  .route__link {
    justify-self: start;
    font-weight: var(--weight-strong);
    overflow-wrap: anywhere;
  }
  .footer-response { margin-top: calc(var(--space-s) * -1); }

  /* ---- Pages and socials ------------------------------------------------- */
  .footer-grid {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-l);
    border-top: var(--stroke-hair) solid var(--on-dark);
  }
  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }
  }

  .footer-tag { margin-top: var(--space-m); max-width: 32ch; }
  .footer-heading { display: block; margin-bottom: var(--space-s); }

  .footer-col ul { list-style: none; display: grid; gap: var(--space-2xs); }

  /* White links; the accent marks hover, with an underline so the state
     never rests on colour alone. */
  .footer-col a,
  .footer-base a {
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-col a { font-size: var(--text-sm); }
  .footer-col a:hover,
  .footer-base a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
  }
</style>
