---
import Logo from './Logo.astro';
import Lines from './Lines.astro';
import { SOCIALS, SITE_NAME, CONTACT_PATH, CREATOR_PATH, CONTACT_EMAIL, APPLICATIONS_EMAIL } from '../consts';

/**
 * The footer: black, full bleed — edge to edge and down to the bottom of the
 * page, with its padding holding the content off the edges.
 *
 * The same on every page, with no props and no per-page variants: the
 * wordmark, what AMAVI is, then the site's pages, how to reach us and where
 * to follow, and the small print. No dividing rules, and no closing call to
 * action — each page ends on its own last section.
 */
const year = new Date().getFullYear();

const pages = [
  { label: 'Home', href: '/' },
  // Services, temporarily off the site (5 October 2026): see src/pages/_services.astro.
  { label: 'About', href: '/about/' },
  { label: 'AMAVI Culture', href: '/culture/' },
  { label: 'Creator Network', href: CREATOR_PATH },
  { label: 'Contact', href: CONTACT_PATH },
];
---

<footer class="site-footer" id="site-footer">
  <div class="footer-card surface-dark">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="lg" variant="white" />
        <p class="meta footer-tag">Europe &amp; ROW</p>
      </div>

      <nav class="footer-col" id="footer-nav" aria-label="Footer">
        <h2 class="label footer-heading">Site</h2>
        <ul role="list">
          {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="label footer-heading">Contact</h2>
        <ul role="list">
          {/* Who each address is for, set like a column heading: two ways in,
              named, rather than one address and a region. */}
          <li><span class="label footer-who">Brands</span>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><span class="label footer-who">Talent</span>
            <a href={`mailto:${APPLICATIONS_EMAIL}`}>{APPLICATIONS_EMAIL}</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="label footer-heading">Follow</h2>
        <ul role="list">
          {SOCIALS.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p class="meta">&copy; {year} {SITE_NAME}. All rights reserved.</p>
      <p class="meta"><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  /* Full bleed: no gutter on any side, and black to the bottom of the page.
     The padding below is what keeps the content off the edges. */
  .footer-card {
    /* A third less than it was: the footer is the end of the page, not a
       section of it. */
    --card-pad: clamp(1rem, 0.55rem + 2.1vw, 2.65rem);
    padding: var(--card-pad);
  }

  /* ---- Brand, pages, contact and socials --------------------------------- */
  .footer-grid {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-m);
  }
  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-l);
      row-gap: var(--space-l);
      align-items: start;
    }
  }
  @media (min-width: 64em) {
    .footer-grid {
      /* Contact takes the widest of the three: it carries the longest line on
         the page, and an address that breaks mid-word reads as a typo. */
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 1.4fr) minmax(0, 0.8fr);
      row-gap: var(--space-m);
    }
  }

  .footer-tag { margin-top: var(--space-s); max-width: 32ch; }
  .footer-heading { display: block; margin-bottom: var(--space-2xs); }

  .footer-col ul { list-style: none; display: grid; gap: var(--space-2xs); }
  /* A little tighter where a pointer, not a thumb, does the choosing. */
  @media (min-width: 48em) { .footer-col ul { gap: var(--space-3xs); } }
  .footer-col li { font-size: var(--text-sm); overflow-wrap: break-word; }
  /* The addresses set a step down, so the longest of them holds one line
     in its column at every width. */
  /* With the other footer links, not a step under them: --text-xs stays
     with the labels and headings. */
  .footer-col a[href^='mailto:'] { font-size: var(--text-sm); }

  /* Who the address under it is for. Set like the column headings above,
     a shade quieter, so the two pairs read as pairs rather than four
     separate lines. */
  .footer-who { display: block; margin-bottom: var(--space-3xs); opacity: 0.6; }
  .footer-col li + li:has(.footer-who) { margin-top: var(--space-2xs); }

  /* White links; the accent marks hover, with an underline so the state
     never rests on colour alone. */
  .footer-col a,
  .footer-base a {
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-col a:hover,
  .footer-base a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-s);
  }
</style>
