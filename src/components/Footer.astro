---
import Logo from './Logo.astro';
import { CONTACT_EMAIL, SOCIALS, NAV_LINKS, SITE_NAME, LOCATION } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <hr class="rule" />
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="lg" />
        <p class="meta footer-tag">Influencer and creator partnerships. Based in {LOCATION}.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <h2 class="label footer-heading">Site</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          <li><a href="/contact/">Work with us</a></li>
        </ul>
      </nav>

      <div class="footer-contact">
        <h2 class="label footer-heading">Contact</h2>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          {SOCIALS.map((s) => (
            <li><a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <hr class="rule" />
    <div class="footer-base">
      <p class="meta">&copy; {year} {SITE_NAME}. All rights reserved.</p>
      <p class="meta"><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-top: var(--section-y); }

  .footer-grid {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl);
  }
  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }
  }

  .footer-tag { margin-top: var(--space-s); max-width: 28ch; }

  .footer-heading { margin-bottom: var(--space-s); display: block; }

  .footer-nav ul,
  .footer-contact ul {
    list-style: none;
    display: grid;
    gap: var(--space-2xs);
  }
  .footer-nav a,
  .footer-contact a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) var(--ease);
  }
  .footer-nav a:hover,
  .footer-contact a:hover { border-color: var(--ink); }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
  }
  .footer-base a { color: var(--ink-muted); }
</style>
