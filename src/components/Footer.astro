---
import Logo from './Logo.astro';
import ContactPaths from './ContactPaths.astro';
import {
  NAV_LINKS, SOCIALS, SITE_NAME, REGION, CONTACT_PATH, CREATOR_PATH, GET_IN_TOUCH_SURFACE,
} from '../consts';

interface Props {
  /** The Get in Touch band's background. Set site-wide in src/consts.ts. */
  touch?: 'dark' | 'soft';
}
const { touch = GET_IN_TOUCH_SURFACE } = Astro.props;

const year = new Date().getFullYear();

// Get in Touch already is the contact page, the application page is its
// creator half, and About ends on its own single call to action: none of
// them repeats the band beneath itself.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const showPanel = ![CONTACT_PATH, CREATOR_PATH, '/about/'].includes(path);
---

<footer class="site-footer">
  {showPanel && (
    <section
      class:list={['touch', touch === 'soft' ? 'surface-soft' : 'surface-dark']}
      aria-labelledby="touch-heading"
    >
      <div class="container touch__inner">
        <h2 id="touch-heading" class="display display--lg touch__heading">Get in touch</h2>
        <ContactPaths level={3} size="panel" />
      </div>
    </section>
  )}

  <div class:list={['footer-main', 'surface-dark', showPanel && touch === 'dark' && 'footer-main--joined']}>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <Logo size="lg" variant="white" />
          <p class="meta footer-tag">
            Influencer and creator partnerships, working with brands across {REGION}.
          </p>
        </div>

        <nav class="footer-col" aria-label="Footer">
          <h2 class="label footer-heading">Site</h2>
          <ul>
            <li><a href="/">Home</a></li>
            {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            <li><a href={CONTACT_PATH}>Get in Touch</a></li>
          </ul>
        </nav>

        <div class="footer-col">
          <h2 class="label footer-heading">Follow</h2>
          <ul>
            {SOCIALS.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" target="_blank">
                  {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <hr class="rule" />
      <div class="footer-base">
        <p class="meta">&copy; {year} {SITE_NAME}. All rights reserved.</p>
        <p class="meta"><a href="/privacy/">Privacy Policy</a></p>
      </div>
    </div>
  </div>
</footer>

<style>
  .touch__inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--section-y);
  }
  .touch__heading { max-width: 14ch; }

  .footer-grid {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-2xl) var(--space-xl);
  }
  /* Black band straight onto the black footer: a white hairline marks where
     one ends and the other begins. */
  .footer-main--joined .footer-grid { border-top: var(--stroke-hair) solid var(--on-dark); }

  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }
  }

  .footer-tag { margin-top: var(--space-m); max-width: 30ch; }
  .footer-heading { display: block; margin-bottom: var(--space-s); }

  .footer-col ul { list-style: none; display: grid; gap: var(--space-2xs); }

  /* White links; the accent marks hover, with an underline so the state
     never rests on colour alone. */
  .footer-col a,
  .footer-base a {
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-col a { font-size: var(--text-sm); }
  .footer-col a:hover,
  .footer-base a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-m) var(--space-l);
  }
</style>
