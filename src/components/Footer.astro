---
import Logo from './Logo.astro';
import Lines from './Lines.astro';
import { SOCIALS, SITE_NAME, CONTACT_PATH, CREATOR_PATH, CONTACT_EMAIL } from '../consts';

/**
 * The footer: black, full bleed — edge to edge and down to the bottom of the
 * page, with its padding holding the content off the edges.
 *
 * The same on every page, with no props and no per-page variants: the
 * wordmark, what AMAVI is, the sign-off, then the site's pages, how to reach
 * us and where to follow, and the small print. No dividing rules, and no
 * closing call to action — each page ends on its own last section.
 */
const year = new Date().getFullYear();

const pages = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'About', href: '/about/' },
  { label: 'Creator Network', href: CREATOR_PATH },
  { label: 'Contact', href: CONTACT_PATH },
];
---

<footer class="site-footer" id="site-footer">
  <div class="footer-card surface-dark">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo size="lg" variant="white" />
        <p class="meta footer-tag"><Lines text={'Creator-led marketing & partnerships.\nIreland & EU.'} /></p>
        <p class="display display--sm footer-signoff"><Lines text={'People.\nPartnerships.\nProgress.'} /></p>
      </div>

      <nav class="footer-col" id="footer-nav" aria-label="Footer">
        <h2 class="label footer-heading">Site</h2>
        <ul role="list">
          {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="label footer-heading">Contact</h2>
        <ul role="list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li>Ireland &amp; EU</li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="label footer-heading">Follow</h2>
        <ul role="list">
          {SOCIALS.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer" target="_blank">
                {s.name}<span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p class="meta">&copy; {year} {SITE_NAME}. All rights reserved.</p>
      <p class="meta"><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  /* Full bleed: no gutter on any side, and black to the bottom of the page.
     The padding below is what keeps the content off the edges. */
  .footer-card {
    --card-pad: clamp(1.5rem, 0.8rem + 3.2vw, 4rem);
    padding: var(--card-pad);
  }

  /* ---- Brand, pages, contact and socials --------------------------------- */
  .footer-grid {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-l);
  }
  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
      gap: var(--space-l);
      align-items: start;
    }
  }

  .footer-tag { margin-top: var(--space-m); max-width: 32ch; }
  .footer-signoff { margin-top: var(--space-l); }
  .footer-heading { display: block; margin-bottom: var(--space-s); }

  .footer-col ul { list-style: none; display: grid; gap: var(--space-2xs); }
  .footer-col li { font-size: var(--text-sm); overflow-wrap: anywhere; }

  /* White links; the accent marks hover, with an underline so the state
     never rests on colour alone. */
  .footer-col a,
  .footer-base a {
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-col a:hover,
  .footer-base a:hover {
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding-top: var(--space-m);
  }
</style>
