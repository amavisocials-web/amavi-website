---
/**
 * The creator application: six short steps in one card.
 *
 * Options mirror AMAVI's existing live form, so applications collected here
 * line up with the ones already in the database: its follower bands (named
 * Nano to Major, as specified), engagement bands, niches, content formats,
 * per-format rates and currencies. The consent text is the live form's,
 * adapted from "by submitting" to a checkbox — word for word; don't edit it.
 *
 * Every step is in the markup as one ordinary form, so without JavaScript it
 * is a single long page that posts natively to Netlify Forms.
 * src/scripts/creator-form.ts turns it into steps, validates each one, builds
 * the review, and sends the application to Google Sheets and Netlify Forms.
 */
import FormStep from './FormStep.astro';
import { CONTACT_EMAIL } from '../consts';

const FORM_NAME = 'creator-application';

/**
 * The Google Apps Script web app that appends each application to a Google
 * Sheet (scripts/google-sheets-handler.gs; setup in the README). Read at build
 * time. It is public by design: the visitor's browser calls it directly.
 */
const sheetsEndpoint = import.meta.env.PUBLIC_SHEETS_ENDPOINT?.trim() || undefined;
if (!sheetsEndpoint) {
  console.warn('[amavi] PUBLIC_SHEETS_ENDPOINT is not set, so creator applications go to Netlify Forms only. See README → "Creator applications → Google Sheets".');
} else if (!/^https:\/\/script\.google\.com\/.+\/exec$/.test(sheetsEndpoint)) {
  throw new Error(`PUBLIC_SHEETS_ENDPOINT should be the Apps Script web app URL, https://script.google.com/…/exec — got "${sheetsEndpoint}".`);
}

const followerBands = [
  'Nano — under 5K', 'Micro — 5K to 15K', 'Mid — 15K to 50K', 'Macro — 50K to 150K', 'Major — 150K+',
];
const engagementBands = ['Under 2%', '2% – 4%', '4% – 7%', '7%+', 'Not sure'];
const niches = [
  'Fashion', 'Beauty', 'Lifestyle', 'Food & Drink', 'Travel', 'Fitness & Wellness', 'Parenting',
  'Tech & Gaming', 'Home & Interiors', 'Business & Finance', 'Music & Entertainment', 'Education', 'Other',
];
const formats = [
  'Reels / Short-form video', 'Static feed posts', 'Stories', 'UGC / Product reviews',
  'Long-form (YouTube / Blog)', 'Live content',
];
const rates = [
  { name: 'rate_reels', label: 'Reel or short-form video' },
  { name: 'rate_static', label: 'Static feed post' },
  { name: 'rate_stories', label: 'Story' },
  { name: 'rate_ugc', label: 'UGC or product review' },
  { name: 'rate_longform', label: 'Long-form video or blog' },
  { name: 'rate_live', label: 'Live content' },
];
const currencies = ['EUR (€)', 'GBP (£)', 'USD ($)', 'Other'];

/** `base` turns a bare @handle into a link for that platform. */
const channels = [
  { name: 'instagram', label: 'Instagram', base: 'https://www.instagram.com/', ph: '@yourname or link' },
  { name: 'tiktok', label: 'TikTok', base: 'https://www.tiktok.com/@', ph: '@yourname or link' },
  { name: 'youtube', label: 'YouTube', base: 'https://www.youtube.com/@', ph: '@yourchannel or link' },
  { name: 'x', label: 'X', base: 'https://x.com/', ph: '@yourname or link' },
  { name: 'linkedin', label: 'LinkedIn', base: 'https://www.linkedin.com/in/', ph: 'Profile link' },
  { name: 'blog', label: 'Blog or website', base: '', ph: 'yourblog.com' },
  { name: 'other_link', label: 'Other', base: '', ph: 'Any other platform' },
];

const STEPS = [
  { title: 'About you', intro: 'The basics, so we know who we’re talking to.' },
  { title: 'Your channels', intro: 'Add at least one. An @handle or a link both work.' },
  { title: 'Your audience', intro: 'Who follows you. A rough idea is plenty.' },
  { title: 'Your content', intro: 'What you make, and what it’s about.' },
  { title: 'Rates', intro: 'How you like to work and what you charge. A starting point, not a commitment.' },
  { title: 'Review & submit', intro: 'Check your answers, then send. You can go back and change anything.' },
];
const total = STEPS.length;
---

<div class="apply">
  <form
    class="apply__card creator-form"
    name={FORM_NAME}
    method="POST"
    action="/become-a-creator/"
    data-netlify="true"
    netlify-honeypot="company_website"
    data-creator-form
    data-sheets-endpoint={sheetsEndpoint}
  >
    {/* Marks the form for the step layout before it's painted, so the long
        version never flashes. If the script hasn't taken over within a few
        seconds — it failed to load — the long form comes back, and still
        submits. */}
    <script is:inline>
      (function (form) {
        form.dataset.stepper = 'pending';
        setTimeout(function () {
          if (form.dataset.stepper === 'pending') form.dataset.stepper = 'off';
        }, 6000);
      })(document.currentScript.parentElement);
    </script>

    <input type="hidden" name="form-name" value={FORM_NAME} />
    <p class="honeypot" aria-hidden="true">
      <label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label>
    </p>

    {/* Visual only: each step's heading says "Step n of 6" to screen readers. */}
    <div class="apply__progress" aria-hidden="true">
      <p class="apply__count" data-progress-count>Step 1 of {total}</p>
      <ol class="apply__segments" role="list">
        {STEPS.map((_, i) => <li class:list={['apply__segment', { 'is-on': i === 0 }]} data-segment></li>)}
      </ol>
    </div>

    <div class="apply__viewport" data-viewport>
      <div class="apply__track" data-track>

        {/* ---------- 1 · About you ---------- */}
        <FormStep index={0} total={total} {...STEPS[0]}>
          <div class="field">
            <label class="field__label" for="cf-name">Full name</label>
            <input class="field__control" id="cf-name" name="name" type="text" required
                   autocomplete="name" aria-describedby="cf-name-error"
                   data-error="Please add your name." />
            <p class="field__error" id="cf-name-error" aria-live="polite"></p>
          </div>

          <div class="field">
            <label class="field__label" for="cf-email">Email</label>
            <input class="field__control" id="cf-email" name="email" type="email" required
                   autocomplete="email" inputmode="email" aria-describedby="cf-email-error"
                   data-error="Please add your email address." />
            <p class="field__error" id="cf-email-error" aria-live="polite"></p>
          </div>

          <div class="field-grid field-grid--2">
            <div class="field">
              <label class="field__label" for="cf-city">City</label>
              <input class="field__control" id="cf-city" name="city" type="text" required
                     autocomplete="address-level2" aria-describedby="cf-city-error"
                     data-error="Please add your city." />
              <p class="field__error" id="cf-city-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label class="field__label" for="cf-country">Country</label>
              <input class="field__control" id="cf-country" name="country" type="text" required
                     autocomplete="country-name" aria-describedby="cf-country-error"
                     data-error="Please add your country." />
              <p class="field__error" id="cf-country-error" aria-live="polite"></p>
            </div>
          </div>
        </FormStep>

        {/* ---------- 2 · Your channels ---------- */}
        <FormStep index={1} total={total} {...STEPS[1]}>
          <div class="channels" role="group" aria-labelledby="step-2-title"
               aria-describedby="cf-channels-error" data-channels>
            <p class="field__error" id="cf-channels-error" aria-live="polite"></p>
            <div class="field-grid field-grid--2">
              {channels.map((c) => (
                <div class="field">
                  <label class="field__label" for={`cf-${c.name}`}>{c.label}</label>
                  <input class="field__control" id={`cf-${c.name}`} name={c.name} type="text"
                         inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false"
                         placeholder={c.ph} data-link data-handle-base={c.base || undefined}
                         aria-describedby={`cf-${c.name}-error`} />
                  <p class="field__error" id={`cf-${c.name}-error`} aria-live="polite"></p>
                </div>
              ))}
            </div>
          </div>
        </FormStep>

        {/* ---------- 3 · Your audience ---------- */}
        <FormStep index={2} total={total} {...STEPS[2]}>
          <div class="field-grid field-grid--2">
            <div class="field">
              <label class="field__label" for="cf-followers">Follower range</label>
              <span class="select">
                <select class="field__control" id="cf-followers" name="follower_range" required
                        aria-describedby="cf-followers-hint cf-followers-error"
                        data-error="Please choose your follower range.">
                  <option value="">Choose a range</option>
                  {followerBands.map((b) => <option value={b}>{b}</option>)}
                </select>
              </span>
              <p class="field__hint" id="cf-followers-hint">On your largest channel.</p>
              <p class="field__error" id="cf-followers-error" aria-live="polite"></p>
            </div>
            <div class="field">
              <label class="field__label" for="cf-engagement">
                Engagement rate <span class="field__optional">(optional)</span>
              </label>
              <span class="select">
                <select class="field__control" id="cf-engagement" name="engagement_rate"
                        aria-describedby="cf-engagement-hint">
                  <option value="">Choose a range</option>
                  {engagementBands.map((b) => <option value={b}>{b}</option>)}
                </select>
              </span>
              <p class="field__hint" id="cf-engagement-hint">An estimate is fine.</p>
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="cf-insights">
              Audience insights <span class="field__optional">(optional)</span>
            </label>
            <textarea class="field__control" id="cf-insights" name="audience_insights" rows="4"
                      placeholder="E.g. 70% women, mostly 25–34, mainly Ireland and the UK"></textarea>
          </div>
        </FormStep>

        {/* ---------- 4 · Your content ---------- */}
        <FormStep index={3} total={total} {...STEPS[3]}>
          <div class="field" role="group" aria-labelledby="cf-niches-label">
            <span class="field__label" id="cf-niches-label">
              Niches <span class="field__optional">(choose any)</span>
            </span>
            <div class="chips">
              {niches.map((n) => (
                <label class="chip">
                  <input type="checkbox" name="niches[]" value={n} />
                  <span class="chip__label">{n}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="field" role="group" aria-labelledby="cf-formats-label">
            <span class="field__label" id="cf-formats-label">
              Content formats you create <span class="field__optional">(choose any)</span>
            </span>
            <div class="chips">
              {formats.map((f) => (
                <label class="chip">
                  <input type="checkbox" name="content_formats[]" value={f} />
                  <span class="chip__label">{f}</span>
                </label>
              ))}
            </div>
          </div>
        </FormStep>

        {/* ---------- 5 · Rates ---------- */}
        <FormStep index={4} total={total} {...STEPS[4]}>
          <div class="field" role="radiogroup" aria-labelledby="cf-pref-label"
               aria-describedby="cf-pref-error" data-radio-group="collaboration_preference">
            <span class="field__label" id="cf-pref-label">Collaboration preference</span>
            <div class="chips">
              {['Gifted', 'Paid', 'Both'].map((option) => (
                <label class="chip">
                  <input type="radio" name="collaboration_preference" value={option} required />
                  <span class="chip__label">{option}</span>
                </label>
              ))}
            </div>
            <p class="field__error" id="cf-pref-error" aria-live="polite"></p>
          </div>

          <div class="field" role="group" aria-labelledby="cf-rates-label" aria-describedby="cf-rates-hint">
            <span class="field__label" id="cf-rates-label">
              Rates per format <span class="field__optional">(optional)</span>
            </span>
            <p class="field__hint" id="cf-rates-hint">Only for the formats you charge for — leave the rest blank.</p>
            <div class="field-grid rate-grid">
              {rates.map((r) => (
                <div class="field">
                  <label class="field__label field__label--sub" for={`cf-${r.name}`}>{r.label}</label>
                  <input class="field__control" id={`cf-${r.name}`} name={r.name} type="text"
                         inputmode="decimal" placeholder="e.g. 250" data-rate />
                </div>
              ))}
            </div>
          </div>

          <div class="field cf-currency">
            <label class="field__label" for="cf-currency">Currency</label>
            <span class="select">
              <select class="field__control" id="cf-currency" name="rate_currency" data-review-if="[data-rate]">
                {currencies.map((c) => <option value={c}>{c}</option>)}
              </select>
            </span>
          </div>

          <div class="field">
            <label class="field__label" for="cf-rate-notes">
              Rate notes <span class="field__optional">(optional)</span>
            </label>
            <textarea class="field__control" id="cf-rate-notes" name="rate_notes" rows="3"
                      placeholder="Bundles, usage rights, exclusivity — anything we should know"></textarea>
          </div>

          <div class="field">
            <label class="field__label" for="cf-past">
              Past brand collaborations <span class="field__optional">(optional)</span>
            </label>
            <textarea class="field__control" id="cf-past" name="past_collaborations" rows="3"
                      placeholder="Brands you've worked with before"></textarea>
          </div>

          <div class="field">
            <label class="field__label" for="cf-mediakit">
              Media kit link <span class="field__optional">(optional)</span>
            </label>
            <input class="field__control" id="cf-mediakit" name="media_kit" type="text"
                   inputmode="url" autocapitalize="off" autocorrect="off" spellcheck="false"
                   placeholder="PDF, Google Drive or portfolio link" data-link
                   aria-describedby="cf-mediakit-error" />
            <p class="field__error" id="cf-mediakit-error" aria-live="polite"></p>
          </div>
        </FormStep>

        {/* ---------- 6 · Review & submit ---------- */}
        <FormStep index={5} total={total} {...STEPS[5]}>
          {/* Filled in by the script from the answers above. */}
          <div class="review" data-review hidden></div>

          <div class="field">
            <label class="field__label" for="cf-else">
              Anything else <span class="field__optional">(optional)</span>
            </label>
            <textarea class="field__control" id="cf-else" name="anything_else" rows="3"
                      placeholder="Availability, upcoming launches, brands you'd love to work with"></textarea>
          </div>

          <div class="field">
            <label class="consent">
              <input type="checkbox" name="consent" value="yes" required
                     aria-describedby="cf-consent-error"
                     data-error="Please tick this box to join the network." />
              <span class="consent__text">
                I agree to be added to the AMAVI Socials creator database and to be contacted about
                potential collaborations, campaigns and partnership opportunities. I understand my
                details may be shared with AMAVI’s clients for the purpose of evaluating and arranging
                collaborations. See our <a href="/privacy/">Privacy Policy</a>.
              </span>
            </label>
            <p class="field__error" id="cf-consent-error" aria-live="polite"></p>
          </div>
        </FormStep>
      </div>
    </div>

    <div class="apply__status">
      {/* Shown by the script: a validation nudge, or a failed send. Never both. */}
      <p class="field__error" data-form-hint aria-live="polite"></p>
      <div class="form-status" data-form-error tabindex="-1" hidden>
        <strong>Your application didn’t send.</strong>{' '}
        <span data-form-error-reason>Something went wrong on the way.</span>{' '}
        Nothing you’ve entered has been lost — please try again. If it keeps failing, email us at{' '}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </div>
    </div>

    <div class="apply__nav">
      <button type="button" class="btn btn--secondary" data-back hidden>Back</button>
      {/* Labelled by layout until the script takes over the label itself. */}
      <button type="submit" class="btn btn--primary" data-next>
        <span class="if-steps">Next</span><span class="if-long">Send application</span>
      </button>
    </div>
  </form>

  <div class="form-status apply__success" data-form-success tabindex="-1" hidden>
    <h2 class="display display--md">Application received.</h2>
    <p>Thanks for applying. You’re in the AMAVI network — we’ll come to you when a brief fits your audience.</p>
  </div>
</div>

<script>
  import '../scripts/creator-form';
</script>

<style>
  /* ==========================================================================
     The card. Two layouts from one markup:
       - steps  (data-stepper="pending" | "ready"): one step at a time, sliding
       - long   (no attribute, or "off"): every step stacked, as a plain form
     ========================================================================== */
  .apply__card {
    --card-pad: clamp(1.25rem, 0.5rem + 3.4vw, 3rem);
    display: grid;
    /* One column, never wider than the card: the track holds all six steps
       side by side, and a clipped (not scrolling) box would otherwise size
       the column to fit them. */
    grid-template-columns: minmax(0, 1fr);
    border: var(--stroke) solid var(--line);
    background: var(--bg);
  }
  /* On a phone the card runs edge to edge, so the fields get the width the
     page gutter would otherwise take twice over. */
  @media (max-width: 39.99em) {
    .apply__card { margin-inline: calc(var(--gutter) * -1); border-inline: 0; }
    .apply__success { margin-inline: calc(var(--gutter) * -1); border-inline: 0; }
  }

  /* --- Progress: six segments, filled in the accent up to this step -------- */
  .apply__progress {
    display: grid;
    gap: var(--space-xs);
    padding: var(--card-pad) var(--card-pad) 0;
  }
  .apply__count {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .apply__segments {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.3rem;
  }
  .apply__segment {
    height: 0.4rem;
    border: var(--stroke) solid var(--line);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .apply__segment.is-on { background: var(--accent); border-color: var(--accent); }

  /* --- Steps ---------------------------------------------------------------- */
  .apply__track { display: grid; }
  .creator-form:not([data-stepper='pending']):not([data-stepper='ready']) .apply__progress,
  .creator-form:not([data-stepper='pending']):not([data-stepper='ready']) [data-review] { display: none; }
  .creator-form:not([data-stepper='pending']):not([data-stepper='ready']) :global(.step + .step) {
    border-top: var(--stroke) solid var(--line);
  }

  /* Step layout: the steps sit side by side and the track slides; the
     viewport clips to the current step and eases to its height. Focus rings
     stay inside, because each step carries the card's padding itself. */
  [data-stepper='pending'] .apply__viewport,
  [data-stepper='ready'] .apply__viewport {
    min-width: 0;
    overflow: hidden;
    overflow: clip;
    transition: height 480ms var(--ease);
  }
  [data-stepper='pending'] .apply__track,
  [data-stepper='ready'] .apply__track {
    display: flex;
    align-items: flex-start;
    transition: transform 480ms var(--ease);
  }
  [data-stepper='pending'] :global(.step),
  [data-stepper='ready'] :global(.step) { flex: 0 0 100%; min-width: 0; }
  /* Before the script has measured anything, only the first step has height. */
  [data-stepper='pending'] :global(.step + .step) { height: 0; visibility: hidden; }
  /* First layout and resize corrections happen without a slide. */
  .apply__card.is-instant .apply__viewport,
  .apply__card.is-instant .apply__track { transition: none; }

  /* --- Status and navigation ------------------------------------------------ */
  .apply__status { display: grid; gap: var(--space-m); padding-inline: var(--card-pad); }

  .apply__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    padding: var(--space-m) var(--card-pad) var(--card-pad);
  }
  .apply__nav [data-next] { margin-left: auto; min-width: 9rem; }
  .apply__nav [data-back][hidden] { display: none; }
  [data-stepper='pending'] .if-long,
  [data-stepper='ready'] .if-long,
  .creator-form:not([data-stepper='pending']):not([data-stepper='ready']) .if-steps { display: none; }

  /* On a phone, Back and Next stay within reach at the foot of the screen
     while a long step scrolls. */
  @media (max-width: 47.99em) {
    [data-stepper='ready'] .apply__nav {
      position: sticky;
      bottom: 0;
      z-index: 2;
      padding-block: var(--space-s);
      background: var(--bg);
      border-top: var(--stroke) solid var(--line);
    }
    .apply__nav .btn { flex: 1 1 0; min-width: 0; }
    .apply__nav [data-next] { min-width: 0; }
  }

  /* --- Fields specific to this form ----------------------------------------- */
  .field__label--sub { font-weight: var(--weight-body); }
  .cf-currency { max-width: 16rem; }
  /* Rates are short numbers: two per row even on a phone, three from tablet. */
  .rate-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m) var(--space-s);
    margin-top: var(--space-2xs);
    /* Labels wrap to different lengths ("Reel or short-form video" vs
       "Story"); bottom-aligning each row keeps the inputs level. */
    align-items: end;
  }
  @media (min-width: 40em) { .rate-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* --- Review ----------------------------------------------------------------- */
  .review { display: grid; gap: var(--space-l); margin-bottom: var(--space-s); }
  .review :global(.review__group) { display: grid; gap: var(--space-xs); padding-top: var(--space-s); border-top: var(--stroke) solid var(--line); }
  .review :global(.review__head) { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-s); }
  .review :global(.review__title) {
    font-size: var(--text-xs);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }
  .review :global(.review__edit) {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: var(--stroke);
    text-underline-offset: 0.2em;
    cursor: pointer;
    padding: 0.25rem 0;
  }
  .review :global(.review__edit:hover) { text-decoration-thickness: var(--stroke-mark); }
  .review :global(.review__list) { display: grid; gap: var(--space-2xs); }
  .review :global(.review__row) { display: grid; gap: 0.1rem; }
  @media (min-width: 40em) {
    .review :global(.review__row) { grid-template-columns: minmax(0, 13rem) minmax(0, 1fr); gap: var(--space-s); }
  }
  .review :global(.review__row dt) { font-size: var(--text-sm); font-weight: var(--weight-secondary); }
  .review :global(.review__row dd) { font-size: var(--text-sm); font-weight: var(--weight-strong); overflow-wrap: anywhere; white-space: pre-line; }
  .review :global(.review__empty) { font-size: var(--text-sm); font-weight: var(--weight-secondary); }

  /* --- Success ---------------------------------------------------------------- */
  .apply__success { display: grid; gap: var(--space-s); padding: clamp(1.75rem, 1rem + 4vw, 3.5rem); font-size: var(--text-lead); }
  .apply__success[hidden] { display: none; }
</style>
