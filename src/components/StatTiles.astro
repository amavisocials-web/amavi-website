---
import LoopVideo from './LoopVideo.astro';
import { videoFiles } from '../lib/media';
import type { ContentTile } from '../data/tiles';

/**
 * Headline figures, each set over a looping creator video: a row of four
 * portrait tiles on a wide screen, two by two on a phone.
 *
 * The number is the point, so it is the largest thing on the tile; the video
 * behind it is decoration (aria-hidden), under a flat black shade so white
 * type holds on any frame. A tile whose video is missing shows the outlined
 * "Add video" frame instead, with the figure in black.
 */
export interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  /** One per stat, in the same order. */
  tiles: ContentTile[];
}
const { stats, tiles } = Astro.props;
const items = stats.map((stat, i) => ({
  ...stat,
  tile: tiles[i],
  playable: tiles[i] ? videoFiles(tiles[i].src, tiles[i].poster).playable : false,
}));
---

<ul class="stat-tiles" role="list">
  {items.map((item) => (
    <li class:list={['stat-tile', { 'stat-tile--video': item.playable }]}>
      {item.tile ? (
        <LoopVideo src={item.tile.src} poster={item.tile.poster} ratio="2/3" class="stat-tile__media" />
      ) : null}
      {item.playable && <div class="stat-tile__shade" aria-hidden="true"></div>}
      <p class="stat-tile__text">
        <span class="stat-tile__value">{item.value}</span>{' '}
        <span class="stat-tile__label">{item.label}</span>
      </p>
    </li>
  ))}
</ul>

<style>
  .stat-tiles {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }
  @media (min-width: 64em) {
    .stat-tiles { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-m); }
  }

  .stat-tile { position: relative; color: var(--ink); }
  .stat-tile--video { color: var(--on-dark); }

  .stat-tile__shade {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-frame);
    background: var(--surface-dark);
    /* Measured on each tile's first frame, over the area the text covers: at
       0.5 the white label holds at least 5.0:1 on 95% of pixels in every
       tile (4.5:1 needed); at 0.35 three of the four fell to 3.2–3.7:1.
       Re-measure if a tile's video changes. */
    opacity: 0.5;
    pointer-events: none;
  }

  .stat-tile__text {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m);
  }
  .stat-tile__value {
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    font-weight: 600;
    font-size: clamp(1.75rem, 1.1rem + 2.53vw, 3.1875rem);
    line-height: 0.95;
  }
  .stat-tile__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-strong);
    line-height: 1.35;
    max-width: 18ch;
    text-wrap: balance;
  }

  @media (max-width: 29.99em) {
    .stat-tile__text { padding: var(--space-s); }
    .stat-tile__label { font-size: var(--text-xs); }
  }
</style>
