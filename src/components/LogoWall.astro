---
import { Image } from 'astro:assets';
import { clearedLogos, opticalK, type ClientLogo } from '../logos';

/**
 * Client wall.
 *
 * Real supplied logos, sized so a 6:1 wordmark and a 1:1 roundel carry
 * comparable optical weight. The assets already have their backgrounds cut
 * (see src/logos.ts), so they need no blend mode and sit correctly on both
 * the paper and paper-alt bands.
 *
 * Only clients cleared for publication appear — see src/logos.ts.
 */
interface Props {
  heading?: string;
  /** Defaults to every cleared logo. */
  logos?: ClientLogo[];
}
const { heading, logos = clearedLogos() } = Astro.props;

const sized = logos.map((logo) => ({ ...logo, k: opticalK(logo) }));
---

<div class="logo-wall">
  {heading && <h2 class="label logo-wall__heading">{heading}</h2>}
  <hr class="rule" />
  <ul class="logo-wall__list" role="list">
    {sized.map((logo) => (
      <li class="logo-wall__item">
        <Image
          src={logo.src}
          alt={`${logo.name} logo`}
          height={140}
          loading="lazy"
          decoding="async"
          class="logo-wall__img"
          style={`--k:${logo.k.toFixed(3)}`}
        />
      </li>
    ))}
  </ul>
  <hr class="rule" />
</div>

<style>
  .logo-wall__heading { display: block; margin-bottom: var(--space-m); }

  .logo-wall__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-l) clamp(1.5rem, 3vw, 3rem);
    padding-block: var(--space-l);
  }

  .logo-wall__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 1 auto;
  }

  .logo-wall__img {
    /* --k is the per-logo equal-area factor computed above. */
    height: calc(var(--logo-base) * var(--k, 1));
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .logo-wall__list { --logo-base: clamp(2.5rem, 1.9rem + 1.6vw, 3.4rem); }

  @media (max-width: 47.99em) {
    .logo-wall__list {
      justify-content: flex-start;
      gap: var(--space-m) var(--space-l);
    }
  }
</style>
