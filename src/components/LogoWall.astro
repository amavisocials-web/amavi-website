---
import { Image } from 'astro:assets';
import Lines from './Lines.astro';
import { clearedClients, opticalK, type Client } from '../data/clients';

/**
 * Client logos: a static, wrapped row, or — with `marquee` — a continuous
 * horizontal scroll.
 *
 * Every logo is solid black on transparent — converted at the asset level by
 * `npm run logos:mono` — and sized so a 6:1 wordmark and a 1:1 roundel carry
 * comparable optical weight (see opticalK in src/data/clients.ts). A client
 * without a logo file yet has its name set in type at the same weight, and
 * `boost` scales a whole row where it should read larger than the default.
 *
 * A client with a url becomes a link, opening in a new tab; one with an empty
 * url is a plain image, with no cursor and no hover. Filling in the url in
 * src/data/clients.ts is the only change either needs.
 *
 * The marquee repeats the row three times and moves each copy left by its own
 * width, so the loop has no seam at any screen width up to twice the row's
 * length. Only the first copy is exposed to assistive tech and to the tab
 * order; the repeats are aria-hidden and their links carry tabindex="-1", so
 * no logo is read or tabbed to twice. It pauses on hover and while it has
 * keyboard focus, and under prefers-reduced-motion it does not move at all:
 * it becomes the static, wrapped row.
 *
 * Only clients cleared for publication appear.
 */
interface Props {
  /** A small line of capitals above the heading. */
  eyebrow?: string;
  /** "\n" marks a line break. */
  heading?: string;
  /** One line beneath the heading. */
  intro?: string;
  /** Heading level, to keep each page's outline valid. */
  level?: 2 | 3;
  clients?: Client[];
  marquee?: boolean;
  /** Multiplies the row's logo height, e.g. 1.15 for a row that leads a page. */
  boost?: number;
}
const {
  eyebrow, heading, intro, level = 2, clients = clearedClients(), marquee = false, boost,
} = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const sized = clients.map((client) => ({ ...client, k: opticalK(client).toFixed(3) }));
const COPIES = 3;
---

<div class:list={['logo-wall', { 'logo-wall--marquee': marquee }]}
     style={boost ? `--logo-boost:${boost}` : undefined}>
  {(eyebrow || heading || intro) && (
    <div class:list={['logo-wall__head', { container: marquee }]}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {heading && <H class="display display--md logo-wall__heading"><Lines text={heading} /></H>}
      {intro && <p class="logo-wall__intro">{intro}</p>}
    </div>
  )}

  {marquee ? (
    <div class="marquee" tabindex="0" role="region" aria-label={heading ? `${heading.replace(/\n/g, ' ')}: logos` : 'Client logos'}>
      <div class="marquee__track">
        {Array.from({ length: COPIES }, (_, copy) => (
          <ul class="marquee__set logo-wall__list" role="list" aria-hidden={copy > 0 ? 'true' : undefined}>
            {sized.map((client) => (
              <li class="logo-wall__item">
                {client.url ? (
                  <a class="logo-wall__link" href={client.url} target="_blank" rel="noopener noreferrer"
                     aria-label={`${client.name}, opens in a new tab`}
                     tabindex={copy > 0 ? -1 : undefined}>
                    {client.logo ? (
                      <Image src={client.logo} alt={copy > 0 ? '' : `${client.name} logo`} height={140}
                             loading="eager" decoding="async" class="logo-wall__img" style={`--k:${client.k}`} />
                    ) : (
                      <span class="logo-wall__type" style={`--k:${client.k}`}>{client.name}</span>
                    )}
                  </a>
                ) : client.logo ? (
                  <Image src={client.logo} alt={copy > 0 ? '' : `${client.name} logo`} height={140}
                         loading="eager" decoding="async" class="logo-wall__img" style={`--k:${client.k}`} />
                ) : (
                  <span class="logo-wall__type" style={`--k:${client.k}`}>{client.name}</span>
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ) : (
    <ul class="logo-wall__list logo-wall__list--static" role="list">
      {sized.map((client) => (
        <li class="logo-wall__item">
          {client.url ? (
            <a class="logo-wall__link" href={client.url} target="_blank" rel="noopener noreferrer"
               aria-label={`${client.name}, opens in a new tab`}>
              {client.logo ? (
                <Image src={client.logo} alt={`${client.name} logo`} height={140}
                       loading="lazy" decoding="async" class="logo-wall__img" style={`--k:${client.k}`} />
              ) : (
                <span class="logo-wall__type" style={`--k:${client.k}`}>{client.name}</span>
              )}
            </a>
          ) : client.logo ? (
            <Image src={client.logo} alt={`${client.name} logo`} height={140}
                   loading="lazy" decoding="async" class="logo-wall__img" style={`--k:${client.k}`} />
          ) : (
            <span class="logo-wall__type" style={`--k:${client.k}`}>{client.name}</span>
          )}
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .logo-wall {
    /* The row's display height, raised 20% on 17 October 2026: every stop of
       the clamp and the width cap multiplied by 1.2. It no longer holds the
       marks under the header wordmark, which is what the old numbers were set
       against; the row is meant to carry now.

       `--logo-boost` scales a whole row from here; the default row is 1. Each
       mark's own optical factor is in src/data/clients.ts, and a change here
       does not disturb them: they are multipliers of this. */
    --logo-boost: 1;
    --logo-base: calc(clamp(2.28rem, 1.74rem + 1.44vw, 3.06rem) * var(--logo-boost));
    --logo-cap: calc(5.7rem * var(--logo-boost));
    --logo-gap: clamp(2.5rem, 5vw, 4.5rem);
    text-align: center;
  }

  .logo-wall__head {
    display: grid;
    gap: var(--space-s);
    justify-items: center;
    /* Close to the logos: the label names the row, it doesn't head a
       section of its own. */
    padding-bottom: var(--space-s);
  }
  /* The label reads at the size of the hero's line, not as small print. */
  .logo-wall__head .eyebrow { font-size: var(--text-lead); }
  /* The heading is display type; the line under it is small body text, so the
     two are never close in size. */
  .logo-wall__intro { font-size: var(--text-sm); font-weight: var(--weight-secondary); max-width: 46ch; }

  .logo-wall__list {
    list-style: none;
    display: flex;
    align-items: center;
  }
  .logo-wall__item { flex: none; display: flex; align-items: center; justify-content: center; }

  /* A linked logo lightens on hover and on focus; an unlinked one has no
     cursor and no state, because there is nothing to press. */
  .logo-wall__link {
    display: inline-flex;
    transition: opacity var(--dur) var(--ease);
  }
  .logo-wall__link:hover,
  .logo-wall__link:focus-visible { opacity: 0.6; }
  .logo-wall__link:focus-visible { outline-offset: 4px; }

  .logo-wall__img {
    height: calc(var(--logo-base) * var(--k, 1));
    width: auto;
    /* Nothing wider than the AMAVI wordmark in the header (79px there): a
       long client wordmark scales down to fit rather than outrunning it. */
    max-width: var(--logo-cap);
    object-fit: contain;
  }

  /* A client's name standing in for its logo: heavy, tight type, at the
     optical weight of the marks around it. */
  .logo-wall__type {
    font-family: var(--font-body);
    font-size: calc(var(--logo-base) * 0.4 * var(--k, 1));
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    white-space: nowrap;
  }

  /* --- Static row ---------------------------------------------------------- */
  .logo-wall__list--static {
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-l) var(--logo-gap);
    padding-block: var(--space-xl) var(--space-s);
  }
  .logo-wall__list--static .logo-wall__img { max-width: 100%; }

  /* --- Marquee ------------------------------------------------------------- */
  .marquee {
    --marquee-duration: 48s;
    overflow: hidden;
    padding-block: var(--space-l);
  }
  .marquee:focus-visible { outline-offset: -2px; }

  .marquee__track { display: flex; width: max-content; }

  /* Each copy carries its own trailing gap, so a copy is exactly one step of
     the loop and the join is invisible. */
  .marquee__set {
    gap: var(--logo-gap);
    padding-right: var(--logo-gap);
    animation: marquee var(--marquee-duration) linear infinite;
  }
  @keyframes marquee {
    to { transform: translateX(-100%); }
  }

  .marquee:hover .marquee__set,
  .marquee:focus-within .marquee__set { animation-play-state: paused; }

  /* Reduced motion: no animation, one copy, wrapped and centred, and the
     logos hold still on hover too. */
  @media (prefers-reduced-motion: reduce) {
    .marquee__track { width: auto; justify-content: center; padding-inline: var(--gutter); }
    .marquee__set {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-l);
      padding-right: 0;
    }
    .marquee__set[aria-hidden='true'] { display: none; }
    .logo-wall__link { transition: none; }
  }

  /* No height step-down on smaller screens. It was tried and taken out: the
     space between marks is a fixed flex gap, and the marquee scrolls rather
     than fitting, so a taller mark never closes the gap on its neighbour. The
     narrowest measured gap is 40px at 375, the same as at 768. Only the gap
     itself tightens, which is what the clamp above already does. */
  @media (max-width: 47.99em) {
    .logo-wall { --logo-gap: var(--space-l); }
    .logo-wall__list--static { gap: var(--space-m) var(--space-l); }
  }
</style>
