---
interface Props {
  heading: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading,
  body,
  primaryLabel = 'Work with us',
  primaryHref = '/contact',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="section cta">
  <div class="container">
    <div class="cta__inner">
      <h2 class="display display--md cta__heading">{heading}</h2>
      {body && <p class="lead cta__body">{body}</p>}
      <div class="cta__actions">
        <a href={primaryHref} class="btn btn--primary">{primaryLabel}</a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="btn btn--secondary">{secondaryLabel}</a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .cta { background: var(--accent); color: var(--paper); }
  .cta__inner { display: grid; gap: var(--space-m); max-width: 52rem; }
  .cta__heading { color: var(--paper); }
  .cta__body { color: color-mix(in srgb, var(--paper) 82%, var(--accent)); max-width: 46ch; }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }
  .cta .btn--primary {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .cta .btn--primary:hover { background: transparent; color: var(--paper); }
  .cta .btn--secondary { color: var(--paper); border-color: color-mix(in srgb, var(--paper) 55%, transparent); }
  .cta .btn--secondary:hover { background: var(--paper); color: var(--accent); border-color: var(--paper); }
  .cta :global(:focus-visible) { outline-color: var(--paper); }
</style>
