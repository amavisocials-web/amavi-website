---
/**
 * The AMAVI Socials wordmark, set as live text.
 *
 * Built to match the supplied file (src/assets/amavi-socials-logo.png) rather
 * than to use it: that PNG is a social avatar with its background baked in,
 * and would render soft at header sizes. Every value below was measured from
 * it, not eyeballed:
 *
 *   face      Poppins Light (300). Total ink per word sits within 5% of Light
 *             and 14% under Regular; both words agree, so the gap is
 *             anti-aliasing, not weight.
 *   tracking  −0.068em. At Poppins' natural spacing both words run ~10% wide;
 *             this closes "amavi" to 162px and "socials" to 170px at the PNG's
 *             scale — both exact.
 *   align     Right. Predicts the PNG's left and right ink edges within 1.7px;
 *             centred is off by 4.7px, left by 10.9px.
 *   leading   1.02 — the PNG's baselines sit 60px apart at a 58.6px size.
 *
 * The PNG itself is used only for the favicon and the share image
 * (npm run brand:assets).
 */
interface Props {
  /**
   * `brand` (the accent's ink role: black on white, the yellow on a dark
   * surface); `white` on the black footer; `current` takes
   * its colour from its surroundings — the header, whose colour changes when
   * it sits over hero footage. `black` is kept for anything made off-site.
   */
  variant?: 'black' | 'white' | 'brand' | 'current';
  /** `sm` for the header lockup, `lg` for the footer. */
  size?: 'sm' | 'lg';
}
const { variant = 'brand', size = 'sm' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${variant}`, `wordmark--${size}`]} translate="no">
  <span class="wordmark__line">amavi</span>{' '}<span class="wordmark__line">socials</span>
</span>

<style>
  .wordmark {
    display: inline-block;
    font-family: var(--font-wordmark);
    font-weight: 300;
    font-stretch: normal;
    letter-spacing: -0.068em;
    line-height: 1.02;
    text-align: right;
    text-transform: lowercase;
    white-space: nowrap;
    /* The body's "antialiased" smoothing thins text on macOS, which made the
       Light cut read lighter than the supplied file. Default smoothing
       restores its weight — checked side by side at the PNG's scale. */
    -webkit-font-smoothing: auto;
    -moz-osx-font-smoothing: auto;
  }
  .wordmark__line { display: block; }

  .wordmark--black { color: var(--ink); }
  .wordmark--white { color: var(--bg); }
  .wordmark--brand { color: var(--accent); }
  .wordmark--current { color: inherit; }

  /* Two steps up the scale from where it started, at the client's direction. */
  .wordmark--sm { font-size: 1.6875rem; }
  /* Two steps down the scale (5 October 2026): the footer wordmark closes
     the page, it does not announce it. 1.25^2 = 1.5625, so every stop of
     the clamp is divided by that. */
  .wordmark--lg { font-size: clamp(1.6rem, 1.024rem + 2.3vw, 2.88rem); }
</style>
