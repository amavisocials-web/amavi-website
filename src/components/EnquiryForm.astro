---
import { CONTACT_EMAIL } from '../consts';

/**
 * Brand enquiry form. Posts to Netlify Forms.
 *
 * TODO(client): confirm the budget bands below reflect how AMAVI actually
 * scopes work — they are a reasonable default, not a supplied figure.
 */

const budgets = [
  'Not sure yet',
  'Under €2,000',
  '€2,000 – €5,000',
  '€5,000 – €10,000',
  '€10,000 – €25,000',
  'Over €25,000',
];

const interests = [
  'Influencer and creator partnerships',
  'Campaign management',
  'Gifted and value-exchange collaborations',
  'Paid creator campaigns',
  'Social media management',
  'Reporting and campaign analysis',
  'Not sure — I want to talk it through',
];
---

<form
  class="form"
  name="brand-enquiry"
  method="POST"
  action="/contact/"
  data-netlify="true"
  netlify-honeypot="company-website"
  data-netlify-form
>
  <input type="hidden" name="form-name" value="brand-enquiry" />
  <p class="honeypot" aria-hidden="true">
    <label>Do not fill this in<input name="company-website" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="field-grid field-grid--2">
    <div class="field">
      <label class="field__label" for="enq-name">Your name</label>
      <input class="field__control" id="enq-name" name="name" type="text"
             autocomplete="name" required aria-describedby="enq-name-error" />
      <p class="field__error" id="enq-name-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for="enq-company">Company</label>
      <input class="field__control" id="enq-company" name="company" type="text"
             autocomplete="organization" required aria-describedby="enq-company-error" />
      <p class="field__error" id="enq-company-error" aria-live="polite"></p>
    </div>
  </div>

  <div class="field-grid field-grid--2">
    <div class="field">
      <label class="field__label" for="enq-email">Email</label>
      <input class="field__control" id="enq-email" name="email" type="email"
             autocomplete="email" required aria-describedby="enq-email-error" />
      <p class="field__error" id="enq-email-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label class="field__label" for="enq-budget">Budget range</label>
      <select class="field__control" id="enq-budget" name="budget" aria-describedby="enq-budget-hint">
        {budgets.map((b) => <option value={b}>{b}</option>)}
      </select>
      <p class="field__hint" id="enq-budget-hint">A rough band is enough to start.</p>
    </div>
  </div>

  <div class="field">
    <label class="field__label" for="enq-interest">What are you looking for?</label>
    <select class="field__control" id="enq-interest" name="interest" required
            aria-describedby="enq-interest-error">
      <option value="">Choose one</option>
      {interests.map((i) => <option value={i}>{i}</option>)}
    </select>
    <p class="field__error" id="enq-interest-error" aria-live="polite"></p>
  </div>

  <div class="field">
    <label class="field__label" for="enq-message">Tell us about it</label>
    <textarea class="field__control" id="enq-message" name="message" rows="6" required
              minlength="20" aria-describedby="enq-message-hint enq-message-error"
              data-error="Please tell us a little about the project — a couple of sentences is plenty."
    ></textarea>
    <p class="field__hint" id="enq-message-hint">
      What you sell, who you want to reach, and anything you have tried already.
    </p>
    <p class="field__error" id="enq-message-error" aria-live="polite"></p>
  </div>

  <label class="check check--consent">
    <input type="checkbox" name="consent" value="yes" required
           aria-describedby="enq-consent-error"
           data-error="Please confirm you are happy for us to hold your details so we can reply." />
    <span>
      I’m happy for AMAVI Socials to store the details in this form in order to
      respond to my enquiry. We will not add you to a mailing list, and you can ask us
      to delete your details at any time by emailing <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      See our <a href="/privacy/">Privacy Policy</a>.
    </span>
  </label>
  <p class="field__error" id="enq-consent-error" aria-live="polite"></p>

  <div class="form__footer">
    <div class="form__status" data-form-status role="status" aria-live="polite" hidden></div>
    <div>
      <button type="submit" class="btn btn--primary" data-submit>Send enquiry</button>
    </div>
  </div>
</form>

<script>
  import '../scripts/netlify-form';
</script>
